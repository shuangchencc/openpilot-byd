@@ -187,10 +209,11 @@ def main() -> int:
   else:
     assert cookies["enter_bootloader_mode"]["start"] == 0x38001FFC
     assert cookies["fault_cookie"]["start"] == 0x38003FFC
-    assert cookies["fault_cookie"]["overlapping_objects"] == []
-    assert cookies["enter_bootloader_mode"]["overlapping_objects"] == [
-      {"symbol": "mic_tx_buf", "start": 0x38001770, "end_exclusive": 0x38002770, "size": 4096, "overlap_bytes": 4}
