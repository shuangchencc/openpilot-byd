+    ('h7', 'flash', '.text', 1024 * 1024 - 128 * 1024 - 136 - 8, 4, 'application overlaps signature tail'),
+    ('h7', 'static-heap', '.bss', 128 * 1024 - 1024 - 512, 8, 'static RAM/heap overlaps reserved stack'),
+    ('h7', 'sram4-rx', '.sram4', 8192 - 4, 4, 'SRAM4 RX overlaps boot cookie'),
+    ('h7', 'sram4-tx', '.sram4.audio_tx', 8192 - 4, 4, 'SRAM4 TX overlaps fault cookie'),
+  ):
+    fixture(target, name + '-exact', section, budget, True, diagnostic)
+    fixture(target, name + '-overflow', section, budget + step, False, diagnostic)
+
+  def audit_command(target, build, stack, elf, report):
+    return [sys.executable, audit, '--target', target, '--elf', elf, '--map', build / 'main.map',
+            '--raw', build / 'main.bin', '--signed', build / 'main.bin.signed',
+            '--public-key', src / 'board/crypto/certs/debug.pub', '--stack-dir', stack, '--output', report]
+
+  for target in ('f4', 'h7'):
+    build = getattr(args, target + '_build').resolve()
