diff --git a/board/stm32h7/stm32h7_app.ld b/board/stm32h7/stm32h7_app.ld
new file mode 100644
index 0000000..7375416
--- /dev/null
+++ b/board/stm32h7/stm32h7_app.ld
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Song PLUS independent port contributors.
+ * Application-only H725/H735 reference layout; NOT an installed-board or
+ * bootstub compatibility claim. Keep both inherited cookie ABI addresses.
+ * SRAM4 is split around the cookies, not allocated as one continuous bank.
+ * The original shared bootstub linker is deliberately left unchanged.
+ */
+ENTRY(Reset_Handler)
+_app_start = 0x08020000;
+_image_limit = 0x08100000 - 136;
+enter_bootloader_mode = 0x38001ffc;
+fault_cookie = 0x38003ffc;
+_estack = 0x20020000;
+_Min_Heap_Size = 512;
+_Min_Stack_Size = 1024;
+_stack_bottom = _estack - _Min_Stack_Size;
+MEMORY {
+  APP (rx) : ORIGIN = 0x08020000, LENGTH = 1024K - 128K - 136
+  DTCMRAM (rw) : ORIGIN = 0x20000000, LENGTH = 128K - 1024
+  STACK (rw) : ORIGIN = 0x2001fc00, LENGTH = 1024
+  ITCMRAM (rw) : ORIGIN = 0x00000000, LENGTH = 64K
+  AXISRAM (rw) : ORIGIN = 0x24000000, LENGTH = 320K
+  SRAM12 (rw) : ORIGIN = 0x30000000, LENGTH = 32K
+  SRAM4_RX (rw) : ORIGIN = 0x38000000, LENGTH = 8192 - 4
+  BOOT_COOKIE (rw) : ORIGIN = 0x38001ffc, LENGTH = 4
+  SRAM4_TX (rw) : ORIGIN = 0x38002000, LENGTH = 8192 - 4
+  FAULT_COOKIE (rw) : ORIGIN = 0x38003ffc, LENGTH = 4
+  BACKUP_SRAM (rw) : ORIGIN = 0x38800000, LENGTH = 4K
+}
+SECTIONS {
+  .isr_vector : { KEEP(*(.isr_vector)) } > APP
+  .text : {
+    *(.text .text.*) *(.rodata .rodata.*)
+    *(.glue_7 .glue_7t) KEEP(*(.init)) KEEP(*(.fini))
+    . = ALIGN(4); _etext = .;
+  } > APP
+  .ARM.extab : { *(.ARM.extab* .gnu.linkonce.armextab.*) } > APP
+  .ARM.exidx : { __exidx_start = .; *(.ARM.exidx*) __exidx_end = .; } > APP
+  .data : {
+    . = ALIGN(4); _sdata = .; *(.data .data.*) . = ALIGN(4); _edata = .;
+  } > DTCMRAM AT > APP
+  _sidata = LOADADDR(.data);
+  _image_end = LOADADDR(.data) + SIZEOF(.data);
+  .bss (NOLOAD) : {
+    . = ALIGN(4); _sbss = .; *(.bss .bss.*) *(COMMON) . = ALIGN(4); _ebss = .;
+  } > DTCMRAM
+  .heap (NOLOAD) : {
+    . = ALIGN(8); PROVIDE(end = .); PROVIDE(_end = .);
+    . += _Min_Heap_Size; _heap_end = .;
+  } > DTCMRAM
+  .stack (NOLOAD) : {
+    _stack_reserved_start = .; . += _Min_Stack_Size; _stack_reserved_end = .;
+  } > STACK
+  .itcmram (NOLOAD) : { . = ALIGN(4); *(.itcmram*) } > ITCMRAM
+  .axisram (NOLOAD) : { . = ALIGN(4); *(.axisram*) } > AXISRAM
+  .sram12 (NOLOAD) : { . = ALIGN(4); *(.sram12*) } > SRAM12
+  /* Consume the explicit TX inputs before the remaining .sram4 wildcard. */
+  .sram4_tx (NOLOAD) : { . = ALIGN(4); *(.sram4.audio_tx) } > SRAM4_TX
+  .sram4 (NOLOAD) : { . = ALIGN(4); *(.sram4*) } > SRAM4_RX
+  .boot_cookie (NOLOAD) : { . += 4; } > BOOT_COOKIE
+  .fault_cookie (NOLOAD) : { . += 4; } > FAULT_COOKIE
+  .backup_sram (NOLOAD) : { . = ALIGN(4); *(.backup_sram*) } > BACKUP_SRAM
+  .ARM.attributes 0 : { *(.ARM.attributes) }
+  /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
+}
+ASSERT(ADDR(.isr_vector) == _app_start, "application vector placement changed")
+ASSERT((_estack & 7) == 0, "stack must be 8-byte aligned")
+ASSERT(_heap_end <= _stack_bottom, "static RAM/heap overlaps reserved stack")
+ASSERT(_stack_reserved_start == _stack_bottom && _stack_reserved_end == _estack, "stack reservation mismatch")
+ASSERT(_image_end <= _image_limit, "application overlaps signature tail")
+ASSERT(ADDR(.sram4) + SIZEOF(.sram4) <= enter_bootloader_mode, "SRAM4 RX overlaps boot cookie")
+ASSERT(ADDR(.sram4_tx) + SIZEOF(.sram4_tx) <= fault_cookie, "SRAM4 TX overlaps fault cookie")
+ASSERT(ADDR(.boot_cookie) == enter_bootloader_mode && SIZEOF(.boot_cookie) == 4, "boot cookie reservation mismatch")
+ASSERT(ADDR(.fault_cookie) == fault_cookie && SIZEOF(.fault_cookie) == 4, "fault cookie reservation mismatch")
