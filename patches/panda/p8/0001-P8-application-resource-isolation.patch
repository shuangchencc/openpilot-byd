+  elf = out / 'inherited-overlap.elf'
+  elf.write_bytes(raw)
+  run('inherited-overlap-rejected', audit_command('h7', build, build, elf, out / 'bad-overlap.json'),
+      'nonzero', 'H7 cookie overlaps live data storage')
+  checks.append({'name': 'inherited-overlap-rejected', 'passed': True, 'kind': 'audit-rejection'})
+
+  result = {'schema': 'songplus-p8-resource-checks/v1', 'status': 'PASS', 'checks': checks,
+            'passed': len(checks), 'failed': 0, 'skipped': 0, 'commands': commands,
+            'runtime_resource_gate': 'BLOCKED', 'runtime_proof_completed': False,
+            'device_access': False, 'mcu_executed': False, 'deployable': False,
+            'source_inputs': {str(p.relative_to(src)): sha(p) for p in
+                              (Path(__file__).resolve(), audit, src / 'board/stm32f4/stm32f4_flash.ld',
+                               src / 'board/stm32h7/stm32h7_app.ld')}}
+  (out / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
+  print(json.dumps({'status': 'PASS', 'passed': len(checks), 'runtime_resource_gate': 'BLOCKED'}))
+
+
+if __name__ == '__main__':
+  main()
