+      ('frame-overflow', 'single function exceeds reserved stack'),
+      ('unbounded-frame', 'unbounded stack allocation'),
+      ('direct-chain-overflow', 'known direct call chain exceeds reserved stack'),
+      ('recursive-chain', 'direct recursive call chain requires an explicit bound'),
+    ):
+      folder = out / (target + '-' + case)
+      folder.mkdir()
+      for path in [*build.glob('*.su'), *build.glob('*.ci')]:
+        shutil.copy2(path, folder / path.name)
+      if case == 'frame-overflow':
+        (folder / 'negative.su').write_text('fixture.c:1:1:overflow\t16384\tstatic\n')
+      elif case == 'unbounded-frame':
+        (folder / 'negative.su').write_text('fixture.c:1:1:unbounded\t16\tdynamic\n')
+      else:
+        frame = 5000 if target == 'f4' else 600
+        graph = ('graph: {\nnode: { title: "negative_a" label: "negative_a\\nfixture.c:1:1\\n' +
+                 str(frame) + ' bytes (static)" }\nnode: { title: "negative_b" label: "negative_b\\nfixture.c:2:1\\n' +
+                 str(frame) + ' bytes (static)" }\nedge: { sourcename: "negative_a" targetname: "negative_b" }\n')
+        if case == 'recursive-chain':
