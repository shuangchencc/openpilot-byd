diff --git a/tests/p8/README.md b/tests/p8/README.md
new file mode 100644
index 0000000..a71e55f
--- /dev/null
+++ b/tests/p8/README.md
@@ -0,0 +1,44 @@
+# P8 application resource isolation
+
+The locked H7 application had `enter_bootloader_mode=0x38001ffc` inside
+`mic_tx_buf=[0x38001770,0x38002770)`. An absolute linker symbol does not reserve
+storage. Normal microphone initialization, processing or BDMA reads could
+therefore alias the boot cookie. P8 fixes the candidate allocation, not the
+unknown installed device or its bootstub.
+
+`board/stm32h7/stm32h7_app.ld` is a new application-only linker. The original
+shared bootstub linker is unchanged. Both inherited cookie addresses are
+preserved as four-byte NOLOAD regions. The lower SRAM4 partition holds the two
+RX buffers (8096 bytes); the upper holds the two TX buffers (6096 bytes). All
+buffers remain in the same DMA-accessed bank and retain their dimensions,
+transfer widths, ping-pong half alignment and processing code. No ADC/audio
+behavior is inferred from compilation.
+
+The candidate builder explicitly selects this linker. Calling upstream generic
+SCons is **not** a supported P8 candidate build entry. There is no installer,
+bootstub output, flash/reset operation, or hardware constructor here.
+
+Both F4 and H7 now have explicit stack reservation endpoint assertions. H7's
+existing 1024-byte stack budget is placed in a dedicated top-of-DTCM NOLOAD
+region and its 512-byte heap reservation cannot cross it. This does not assert
+that 1024 bytes are enough. Flash excludes the same 136-byte signature/version
+tail in the linker rather than only in a later file audit. F4 still intentionally
+uses only its existing reference lower 128 KiB of RAM; no capacity is attributed
+to the user's unconfirmed MCU.
+
+`tests/p5/audit_resources.py` checks all allocated sections, real object/cookie
+overlap, stack boundaries, DMA ranges/alignment, signature and fresh `.su`/`.ci`
+data. It reports each known entry chain and each unresolved call site. The
+known-direct chain is only a partial requirement, **not a whole-program upper
+bound**: indirect targets, assembly frames, exception/FPU context, priority and
+preemption nesting, and measured target watermarks remain unproved. With
+`--require-runtime-proof`, a structurally passing candidate returns exit 3 and
+`BLOCKED_RUNTIME_PROOF`. This expected refusal tests a gate; it is not successful
+runtime validation. There is no override to claim completion.
+
+`tests/p8/run_resources.py` runs 23 checks: 12 actual linker boundary cases,
+8 malformed stack-evidence rejections, two explicit runtime-proof refusals,
+and rejection of the old H7 object/cookie overlap injected into an ELF symbol.
+All target capacities are reference build budgets pending physical identity.
+Keep target execution, audible alert behavior and complete worst-case stack
+proof as release blockers even when these offline checks pass.
diff --git a/tests/p8/run_resources.py b/tests/p8/run_resources.py
new file mode 100644
index 0000000..d305ff8
--- /dev/null
+++ b/tests/p8/run_resources.py
@@ -0,0 +1,167 @@
+#!/usr/bin/env python3
+"""Exercise actual application linker boundaries and resource audit failures.
+
+All ARM outputs are data only. No MCU execution, hardware access or bootstub.
+The caller must sandbox this process and its compiler children.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+
+
+def sha(path):
+  return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  for name in ('source', 'arm-prefix', 'f4-build', 'h7-build', 'output'):
+    parser.add_argument('--' + name, type=Path, required=True)
+  args = parser.parse_args()
+  src, prefix, out = args.source.resolve(), args.arm_prefix.resolve(), args.output.resolve()
+  if out.exists() and any(out.iterdir()):
+    raise ValueError('fresh output required')
+  out.mkdir(parents=True, exist_ok=True)
+  commands, checks = [], []
+  gcc = str(prefix / 'arm-none-eabi-gcc')
+  audit = src / 'tests/p5/audit_resources.py'
+  spec = importlib.util.spec_from_file_location('resource_audit', audit)
+  module = importlib.util.module_from_spec(spec)
+  spec.loader.exec_module(module)
+
+  def run(name, argv, expected=0, diagnostic=None):
+    proc = subprocess.run(list(map(str, argv)), cwd=out, capture_output=True, text=True, timeout=180)
+    log = out / (name + '.log')
+    log.write_text(proc.stdout + proc.stderr)
+    commands.append({'name': name, 'argv': list(map(str, argv)), 'exit_code': proc.returncode,
+                     'expected_exit_code': expected, 'log': log.name, 'log_sha256': sha(log)})
+    if expected == 'nonzero':
+      valid = proc.returncode != 0
+    else:
+      valid = proc.returncode == expected
+    if not valid or diagnostic is not None and diagnostic not in proc.stdout + proc.stderr:
+      raise RuntimeError(f'{name}: unexpected result; see {log}')
+    return proc
+
+  def fixture(target, name, section, count, success, diagnostic):
+    cpu = 'cortex-m4' if target == 'f4' else 'cortex-m7'
+    fpu = 'fpv4-sp-d16' if target == 'f4' else 'fpv5-d16'
+    family, script = ('stm32f4', 'stm32f4_flash.ld') if target == 'f4' else ('stm32h7', 'stm32h7_app.ld')
+    stem = target + '-' + name
+    asm = out / (stem + '.s')
+    text_count = count if section == '.text' else 4
+    body = ('.syntax unified\n.thumb\n.section .isr_vector,"a",%progbits\n'
+            '.word _estack\n.word Reset_Handler\n.section .text,"ax",%progbits\n'
+            '.global Reset_Handler\n.thumb_func\nReset_Handler:\nbx lr\n' + f'.space {text_count - 2}\n')
+    if section != '.text':
+      body += f'.section {section},"aw",%nobits\n.space {count}\n'
+    asm.write_text(body)
+    flags = ['-mcpu=' + cpu, '-mthumb', '-mfloat-abi=hard', '-mfpu=' + fpu, '-nostdlib']
+    obj = out / (stem + '.o')
+    run(stem + '-assemble', [gcc, *flags, '-c', asm, '-o', obj])
+    run(stem + '-link', [gcc, *flags, '-T' + str(src / 'board' / family / script), obj,
+                        '-Wl,-Map,' + str(out / (stem + '.map')), '-o', out / (stem + '.elf')],
+        0 if success else 'nonzero', None if success else diagnostic)
+    checks.append({'name': stem, 'passed': True, 'kind': 'exact-boundary-accepted' if success else 'overflow-rejected'})
+
+  for target, name, section, budget, step, diagnostic in (
