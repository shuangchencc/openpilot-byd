+  image = module.elf32(build / 'main.elf')
+  table = image['sections']['.symtab']
+  strings = next(s for s in image['sections'].values() if s['index'] == table['link'])
+  names = raw[strings['offset']:strings['offset'] + strings['size']]
+  changed = False
+  for pos in range(table['offset'], table['offset'] + table['size'], 16):
+    offset = struct.unpack_from('<I', raw, pos)[0]
+    if names[offset:].split(b'\0', 1)[0] == b'mic_tx_buf':
