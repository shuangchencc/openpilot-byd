+    run(target + '-runtime-proof', [*audit_command(target, build, build, build / 'main.elf', proof),
+                                  '--require-runtime-proof'], 3)
+    data = json.loads(proof.read_text())
+    assert data['status'] == 'BLOCKED_RUNTIME_PROOF' and data['static_allocation_passed']
+    assert not data['stack']['worst_case_call_and_interrupt_depth_proven']
+    assert data['stack']['direct_callgraph']['unresolved_call_sites']
+    # Vector wrappers use IRQHandler, while their registered C callbacks use
+    # _IRQ_Handler. Neither spelling may silently vanish from entry reporting.
+    entries = {row['entry'] for row in data['stack']['direct_callgraph']['entry_known_direct_chains']}
+    vectors = {name for name in module.elf32(build / 'main.elf')['symbols'] if name.endswith('IRQHandler')}
+    unresolved = {row['entry'] for row in data['stack']['direct_callgraph']['vector_entries_without_compiler_frame']}
+    assert vectors and vectors <= entries | unresolved and not entries & unresolved and 'main' in entries
+    checks.append({'name': target + '-runtime-proof', 'passed': True, 'kind': 'unresolved-runtime-gate-rejected',
+                   'runtime_proof_completed': False})
+
+  # Deliberately alter only an ELF symbol value, keeping code/signature intact.
+  # The old mic-cookie overlap must be rejected rather than grandfathered in.
+  build = args.h7_build.resolve()
