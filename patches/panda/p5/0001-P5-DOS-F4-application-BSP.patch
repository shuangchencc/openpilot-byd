+++ b/tests/p5/run_validation.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""Compile ARM ABI oracles and execute the real protocol with explicit HAL stubs.
+
+No download, Panda Python import, flashing or MCU execution. Call inside the
+outer offline sandbox. --arm-prefix is a bin directory containing the pinned
+arm-none-eabi-gcc and arm-none-eabi-objcopy wrappers.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import struct
+import subprocess
+
+
+def sha(path: Path) -> str:
+  return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def function(source: str, name: str) -> str:
+  match = re.search(r"^static int " + name + r"\([^\n]+\) \{", source, re.M)
+  if match is None:
+    raise ValueError(f"missing actual function {name}")
+  depth, end = 1, match.end()
+  while depth:
+    depth += (source[end] == "{") - (source[end] == "}")
+    end += 1
+  return source[match.start():end]
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument("--panda", type=Path, required=True)
+  parser.add_argument("--opendbc", type=Path, required=True)
+  parser.add_argument("--output", type=Path, required=True)
+  parser.add_argument("--arm-prefix", type=Path, required=True)
+  parser.add_argument("--cc", default="clang")
+  args = parser.parse_args()
+  panda, opendbc, output = args.panda.resolve(), args.opendbc.resolve(), args.output.resolve()
+  output.mkdir(parents=True, exist_ok=True)
+  here = Path(__file__).resolve().parent
+  commands = []
+
+  def run(command: list[str], name: str, *, failure: bool = False) -> str:
+    proc = subprocess.run(list(map(str, command)), capture_output=True, text=True, timeout=120,
+                          env={**os.environ, "ASAN_OPTIONS": "detect_leaks=0", "UBSAN_OPTIONS": "halt_on_error=1"})
+    log = output / f"{name}.log"
+    log.write_text(proc.stdout + proc.stderr)
+    commands.append({"name": name, "command": list(map(str, command)), "exit_code": proc.returncode,
+                     "expected_compile_failure": failure, "log_sha256": sha(log)})
+    if (proc.returncode == 0) == failure:
+      raise RuntimeError(f"Unexpected exit for {name}: {proc.returncode}\n{proc.stdout}{proc.stderr}")
+    if failure and "static assertion failed" not in proc.stderr:
+      raise RuntimeError(f"Negative ABI compile failed for an unrelated reason: {name}")
+    return proc.stdout
+
+  health = panda / "board/health.h"
+  can = opendbc / "opendbc/safety/can.h"
+  assert sha(health) == "f512bcff6925e233a35c00e2d921fe01933fd77c0705c573a233b170d73ce20d", "pinned health ABI changed"
+  assert sha(can) == "76f2ab751f89797c0a2254ab9a010a261678fe30f869d4e777cb7f2048802743", "pinned CAN ABI changed"
+  hh = int.from_bytes(hashlib.sha256(health.read_bytes().replace(b"\r", b"")).digest()[:4], "little")
+  ch = int.from_bytes(hashlib.sha256(can.read_bytes().replace(b"\r", b"")).digest()[:4], "little")
+  hash_flags = [f"-DHEALTH_PACKET_VERSION={hh}U", f"-DCAN_PACKET_VERSION_HASH={ch}U"]
+  gcc = args.arm_prefix / "arm-none-eabi-gcc"
+  objcopy = args.arm_prefix / "arm-none-eabi-objcopy"
+  version = run([gcc, "--version"], "arm-version").splitlines()[0]
+  abis = []
+  for target, cpu, fpu in (("f4", "cortex-m4", "fpv4-sp-d16"), ("h7", "cortex-m7", "fpv5-d16")):
+    obj = output / f"abi-{target}.o"
+    flags = [gcc, "-std=gnu11", "-Wall", "-Wextra", "-Werror", "-mthumb", "-mlittle-endian", f"-mcpu={cpu}",
+             f"-mfpu={fpu}", "-mfloat-abi=hard", "-I", panda, "-I", opendbc, *hash_flags, "-c", here / "abi_probe.c"]
+    run([*flags, "-o", obj], f"abi-{target}")
+    blob = output / f"abi-{target}.bin"
+    run([objcopy, "-O", "binary", "--only-section=.p5abi", obj, blob], f"abi-extract-{target}")
+    values = list(struct.unpack("<12I", blob.read_bytes()))
+    assert values == [0x50354142, 4, 48, 64, 72, 4, 6, 6, 64, hh, ch, 7], values
+    wire = output / f"abi-{target}-can.bin"
+    run([objcopy, "-O", "binary", "--only-section=.p5can", obj, wire], f"abi-wire-{target}")
+    assert wire.read_bytes() == bytes([0x84, 0x18, 9, 0, 0, 0x95, 0, 1, 2, 3, 4, 5, 6, 7]) + bytes(58)
+    negatives = {"old_health_58": "EXPECT_HEALTH=58U", "shrunk_can_16": "EXPECT_CAN=16U", "old_payload_offset_5": "EXPECT_DATA_OFFSET=5U"}
+    for label, define in negatives.items():
+      run([*flags, "-D" + define, "-o", output / f"negative-{target}.o"], f"negative-{target}-{label}", failure=True)
+    abis.append({"target": target, "cpu": cpu, "values": values, "object_sha256": sha(obj),
+                 "section_sha256": sha(blob), "arm_wire_bitfields_sha256": sha(wire), "negative_compile_cases": list(negatives)})
+
+  main_path = panda / "board/main_comms.h"
+  source = main_path.read_text()
+  selected = []
+  # Extract complete source branches including their preprocessor guards; no
+  # replacement protocol or packet layout implementation is generated here.
+  for opcode in ("c0", "c1", "c2", "d2", "dc", "dd", "df", "e8", "f3", "f9", "fc"):
+    match = re.search(r"^    // \*\*\*\* 0x" + opcode + r":.*?(?=^    // \*\*\*\* 0x|^    default:)", source, re.M | re.S)
+    if match is None:
+      raise ValueError(f"missing complete current control branch {opcode}")
+    selected.append(match.group())
+  include = output / "selected_main_comms.inc"
+  capability = re.search(r"^    #ifdef STM32F4\n    // F4 candidate capability extension,.*?^    #endif", source, re.M | re.S)
+  if capability is None:
+    raise ValueError("missing complete F4 capability extension")
+  selected.append(capability.group() + "\n")
+  include.write_text(function(source, "get_health_pkt") + "\nint p5_control_handler(ControlPacket_t *req, uint8_t *resp) {\n" +
+                     "  unsigned int resp_len = 0U;\n  switch (req->request) {\n" + "".join(selected) +
+                     "    default: break;\n  }\n  return (int)resp_len;\n}\n")
+  suites = []
+  for target, is_f4 in (("f4", 1), ("h7_policy", 0)):
+    exe = output / f"protocol-{target}"
+    run([args.cc, "-std=gnu11", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function", "-Wno-unused-variable",
+         "-g", "-O1", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-fno-omit-frame-pointer",
+         "-DALLOW_DEBUG", f"-DP5_TARGET_F4={is_f4}", *hash_flags, "-I", panda, "-I", opendbc, "-I", output,
+         here / "test_protocol.c", "-o", exe], f"protocol-compile-{target}")
+    stdout = run([exe], f"protocol-run-{target}")
+    summary = re.search(r"SUMMARY groups=(\d+) assertions=(\d+) failures=0 skipped=0", stdout)
+    assert summary, stdout
+    suites.append({"target": target, "groups": int(summary[1]), "assertions": int(summary[2]), "failed": 0, "skipped": 0,
+                   "group_names": re.findall(r"^PASS (.+)$", stdout, re.M), "binary_sha256": sha(exe)})
+  report = {"status": "PASS", "arm_compiler": version, "abi": abis, "protocol": suites, "commands": commands,
+            "sources": [{"path": str(path), "sha256": sha(path)} for path in
+                        [health, can, main_path, panda / "board/can_comms.h", panda / "board/drivers/can_common.h",
+                         panda / "board/drivers/drivers.h", here / "abi_probe.c", here / "test_protocol.c"]],
+            "selected_main_comms_sha256": sha(include),
+            "hal_stubs": "board voltage/current/temperature, GPIO/ignition, CAN process callback, interrupt locking; no real MCU IO",
+            "scope": "ARM F4/H7 compile-time ABI; host ASan/UBSan execution of actual protocol and safety hooks with HAL stubs",
+            "device_access": False, "mcu_execution": False}
+  (output / "validation.json").write_text(json.dumps(report, indent=2) + "\n")
+  print(f"PASS ARM ABI: 2 targets, 6 negative compiles; protocol: {sum(s['groups'] for s in suites)} groups")
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
