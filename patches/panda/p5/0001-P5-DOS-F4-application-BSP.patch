diff --git a/tests/f4_bsp/run_bsp.py b/tests/f4_bsp/run_bsp.py
new file mode 100644
index 0000000..1ec9aea
--- /dev/null
+++ b/tests/f4_bsp/run_bsp.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Offline native BSP checks and ARM link/compile rejection fixtures.
+
+Outputs are confined to --output. No device access, flashing, network access,
+bootstub image, or execution of ARM binaries is performed.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import sys
+
+
+def sha(path: Path) -> str:
+  return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--source', type=Path, required=True)
+  parser.add_argument('--opendbc', type=Path, required=True)
+  parser.add_argument('--arm-prefix', type=Path, required=True)
+  parser.add_argument('--output', type=Path, required=True)
+  parser.add_argument('--cc', default='clang')
+  args = parser.parse_args()
+  src, dbc, prefix, out = (p.resolve() for p in (args.source, args.opendbc, args.arm_prefix, args.output))
+  if out == src or out == dbc or src.is_relative_to(out) or dbc.is_relative_to(out):
+    raise ValueError('output must be a dedicated build directory')
+  out.mkdir(parents=True, exist_ok=True)
+  if any(out.iterdir()):
+    raise ValueError('output directory must be empty')
+  env = dict(os.environ, TMPDIR=str(out), PYTHONDONTWRITEBYTECODE='1')
+  report = {'schema': 'songplus-p5-bsp-checks/v1', 'deployable': False, 'device_access': False,
+            'arm_code_executed': False, 'bootstub_built': False, 'commands': [], 'suites': {},
+            'checks': [], 'source_inputs': {}, 'scope': 'host register models and ARM compile/link only'}
+  gcc = str(prefix / 'arm-none-eabi-gcc')
+
+  def record_source(path: Path) -> None:
+    path = path.resolve()
+    if path.is_relative_to(src):
+      name = 'panda/' + str(path.relative_to(src))
+    elif path.is_relative_to(dbc):
+      name = 'opendbc/' + str(path.relative_to(dbc))
+    elif path.is_relative_to(out):
+      name = 'generated/' + str(path.relative_to(out))
+    else:
+      raise RuntimeError(f'unexpected compiler source input: {path}')
+    report['source_inputs'][name] = sha(path)
+
+  def run(name: str, cmd: list[str], expect_success: bool = True) -> str:
+    completed = subprocess.run(cmd, cwd=out, env=env, text=True, stdout=subprocess.PIPE,
+                               stderr=subprocess.STDOUT, timeout=90, check=False)
+    log = out / (name + '.log')
+    log.write_text(shlex.join(cmd) + '\n' + completed.stdout)
+    report['commands'].append({'name': name, 'argv': cmd, 'returncode': completed.returncode,
+                               'log': log.name, 'expected_success': expect_success})
+    if expect_success != (completed.returncode == 0):
+      raise RuntimeError(f'{name}: unexpected exit {completed.returncode}; see {log.name}')
+    return completed.stdout
+
+  def check(name: str, condition: bool, detail: str) -> None:
+    report['checks'].append({'name': name, 'passed': bool(condition), 'detail': detail})
+    if not condition:
+      raise RuntimeError(f'{name}: {detail}')
+
+  error = None
+  try:
+    record_source(Path(__file__))
+    report['native_compiler'] = run('native-compiler', [args.cc, '--version']).splitlines()[0]
+    report['arm_compiler'] = run('arm-compiler', [gcc, '--version']).splitlines()[0]
+    tests = [('temperature', 'test_temperature.c', 7, 39), ('gpio', 'test_bsp_gpio.c', 10, 51)]
+    for name, filename, expected_groups, expected_assertions in tests:
+      binary, depfile = out / name, out / (name + '.d')
+      cmd = [args.cc, '-std=c11', '-Wall', '-Wextra', '-Werror', '-fsanitize=address,undefined',
+             '-fno-omit-frame-pointer', '-I' + str(src / 'tests/f4_bsp/mock'), '-I' + str(src),
+             '-MMD', '-MF', str(depfile), str(src / 'tests/f4_bsp' / filename), '-o', str(binary)]
+      run(name + '-compile', cmd)
+      for dependency in shlex.split(depfile.read_text().replace('\\\n', '').split(':', 1)[1]):
+        record_source(Path(dependency))
+      output = run(name + '-run', [str(binary)])
+      matches = re.findall(r'^SUMMARY groups=(\d+) assertions=(\d+) failed=(\d+) skipped=(\d+)$', output, re.M)
+      groups = re.findall(r'^PASS (\S+)$', output, re.M)
+      if matches != [(str(expected_groups), str(expected_assertions), '0', '0')] or len(set(groups)) != expected_groups:
+        raise RuntimeError(f'{name}: missing, duplicate, failed or skipped native assertions')
+      report['suites'][name] = {'groups': groups, 'assertions': expected_assertions,
+                                'failed': 0, 'skipped': 0, 'binary_sha256': sha(binary)}
+
+    linker = src / 'board/stm32f4/stm32f4_flash.ld'
+    record_source(linker)
+    arm_flags = ['-mcpu=cortex-m4', '-mthumb', '-mfloat-abi=hard', '-mfpu=fpv4-sp-d16', '-nostdlib']
+    app_bytes, static_bytes = 1024 * 1024 - 16 * 1024 - 136, 128 * 1024 - 8 - 8192
+    report['fixture_budget'] = {'app_bytes': app_bytes, 'static_ram_bytes': static_bytes,
+                                'stack_bytes': 8192, 'cookie_bytes': 8, 'reserved_signature_tail_bytes': 136}
+
+    def fixture(name: str, bss_bytes: int, text_bytes: int, should_link: bool) -> str:
+      # Vector is 8 bytes. Reset_Handler is never executed; .text byte count is
+      # deliberately exact so the positive boundary and +4 negative differ only
+      # in resource use, not unresolved symbols or malformed assembly.
+      source = out / (name + '.s')
+      source.write_text('.syntax unified\n.cpu cortex-m4\n.thumb\n' +
+                        '.section .isr_vector,"a",%progbits\n.word _estack\n.word Reset_Handler\n' +
+                        '.section .text,"ax",%progbits\n.global Reset_Handler\n.thumb_func\nReset_Handler:\n' +
+                        'bx lr\n' + f'.space {text_bytes - 2}\n' +
+                        '.section .bss,"aw",%nobits\n' + f'.space {bss_bytes}\n')
+      record_source(source)
+      obj, elf = out / (name + '.o'), out / (name + '.elf')
+      run(name + '-assemble', [gcc, *arm_flags, '-c', str(source), '-o', str(obj)])
+      return run(name + '-link', [gcc, *arm_flags, '-T' + str(linker),
+                                 '-Wl,-Map,' + str(out / (name + '.map')), str(obj), '-o', str(elf)], should_link)
+
+    fixture('exact-static-budget', static_bytes, 4, True)
+    check('f4_linker_accepts_exact_static_budget', True, 'static data exactly ends at dedicated stack boundary')
+    fixture('exact-app-budget', 4, app_bytes - 8, True)
+    check('f4_linker_accepts_exact_app_budget', True, 'application load image exactly ends before reserved 136-byte tail')
+    output = fixture('oversized-static', static_bytes + 4, 4, False)
+    check('f4_linker_rejects_static_stack_overlap', 'static RAM overlaps reserved stack' in output and
+          re.search(r"region [`']RAM['`].*overflowed", output) is not None,
+          'production linker RAM-region overflow and explicit stack assertion must both reject +4 bytes')
+    output = fixture('oversized-app', 4, app_bytes - 8 + 4, False)
+    check('f4_linker_rejects_signature_tail_overlap', 'application overlaps signature tail' in output and
+          re.search(r"region [`']APP['`].*overflowed", output) is not None,
+          'production linker APP-region overflow and signature-tail assertion must both reject +4 bytes')
+
+    config = src / 'board/stm32f4/stm32f4_config.h'
+    record_source(config)
+    guard_source = out / 'config-guard.c'
+    guard_source.write_text('#include "board/stm32f4/stm32f4_config.h"\n')
+    record_source(guard_source)
+    flags = [*arm_flags, '-fsyntax-only', '-fmax-errors=1', '-DSTM32F4', '-DSTM32F413xx',
+             '-I' + str(src), '-I' + str(src / 'board/stm32f4/inc'), '-I' + str(dbc)]
+    for name, extra, diagnostic in [
+      ('f4_compile_requires_explicit_candidate', [], 'F4 is an unverified DOS reference candidate, not a deployable board target'),
+      ('f4_compile_rejects_bootstub', ['-DSONGPLUS_DOS_REFERENCE_CANDIDATE', '-DBOOTSTUB'],
+       'P5 intentionally builds app candidates only; bootstub/recovery remain unverified')]:
+      output = run(name, [gcc, *flags, *extra, str(guard_source)], False)
+      check(name, '#error' in output and diagnostic in output and 'fatal error:' not in output,
+            'failure must originate in the intended candidate/bootstub guard, not a missing include or unrelated error')
+  except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as exc:
+    error = str(exc)
+
+  report['summary'] = {'groups': sum(len(s['groups']) for s in report['suites'].values()) + len(report['checks']),
+                       'native_assertions': sum(s['assertions'] for s in report['suites'].values()),
+                       'compile_link_checks': len(report['checks']), 'failed': int(error is not None), 'skipped': 0}
+  report['status'] = 'PASS' if error is None else 'FAIL'
+  if error:
+    report['error'] = error
+  report['artifacts'] = {str(p.relative_to(out)): sha(p) for p in sorted(out.rglob('*')) if p.is_file()}
+  (out / 'result.json').write_text(json.dumps(report, indent=2) + '\n')
+  print(json.dumps({'status': report['status'], **report['summary'], 'result': str(out / 'result.json')}))
+  return 1 if error else 0
+
+
+if __name__ == '__main__':
+  sys.exit(main())
diff --git a/tests/f4_bsp/test_bsp_gpio.c b/tests/f4_bsp/test_bsp_gpio.c
new file mode 100644
index 0000000..26ccda0
--- /dev/null
+++ b/tests/f4_bsp/test_bsp_gpio.c
@@ -0,0 +1,189 @@
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct { uint32_t MODER, ODR, PUPDR, AFR[2], OTYPER, IDR; } GPIO_TypeDef;
+typedef struct { uint32_t CR1, CCMR1, CCMR2, CCER, ARR, EGR, CCR1, CCR2, CCR3, CCR4, PSC, DIER, BDTR, SR, CNT; } TIM_TypeDef;
+static GPIO_TypeDef ga,gb,gc;
+static TIM_TypeDef timer1,timer3,timer2,timer6,timer9;
+#define GPIOA (&ga)
+#define GPIOB (&gb)
+#define GPIOC (&gc)
+#define TIM1 (&timer1)
+#define TIM3 (&timer3)
+#define MICROSECOND_TIMER (&timer2)
+#define INTERRUPT_TIMER (&timer6)
