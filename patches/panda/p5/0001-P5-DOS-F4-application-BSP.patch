@@ -0,0 +1,245 @@
+// Execute the production bxCAN driver, queues and current opendbc safety hooks.
+// Only STM32 registers, low-level W1C effects, IRQ registration and LEDs are HAL mocks.
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define ALLOW_DEBUG
+#define ENTER_CRITICAL() do { } while (0)
+#define EXIT_CRITICAL() do { } while (0)
+#include "board/utils.h"
+#include "board/config.h"
+#include "board/drivers/drivers.h"
+#include "board/sys/faults.h"
+uint32_t microsecond_timer_get(void);
+#include "opendbc/safety/safety.h"
+
+void print(const char *text) { (void)text; }
+void puth(unsigned int value) { (void)value; }
+uint32_t microsecond_timer_get(void) { return 0U; }
+static uint32_t refreshed;
+void refresh_can_tx_slots_available(void) { refreshed++; }
+#define STM32F4
+#include "board/drivers/can_common.h"
+
+typedef struct { uint32_t TIR, TDTR, TDLR, TDHR; } TxMailbox;
+typedef struct { uint32_t RIR, RDTR, RDLR, RDHR; } RxMailbox;
+typedef struct {
+  uint32_t ESR, TSR, RF0R;
+  TxMailbox sTxMailBox[3];
+  RxMailbox sFIFOMailBox[2];
+} CAN_TypeDef;
+static CAN_TypeDef mock_can[3];
+#define CAN1 (&mock_can[0])
+#define CAN2 (&mock_can[1])
+#define CAN3 (&mock_can[2])
+enum { CAN1_TX_IRQn, CAN1_RX0_IRQn, CAN1_SCE_IRQn, CAN2_TX_IRQn,
+       CAN2_RX0_IRQn, CAN2_SCE_IRQn, CAN3_TX_IRQn, CAN3_RX0_IRQn, CAN3_SCE_IRQn };
+#define CAN_ESR_EWGF_Pos 0U
+#define CAN_ESR_EPVF_Pos 1U
+#define CAN_ESR_BOFF_Pos 2U
+#define CAN_ESR_LEC_Pos 4U
+#define CAN_ESR_TEC_Pos 16U
+#define CAN_ESR_REC_Pos 24U
+#define CAN_ESR_EWGF (1U << CAN_ESR_EWGF_Pos)
+#define CAN_ESR_EPVF (1U << CAN_ESR_EPVF_Pos)
+#define CAN_ESR_BOFF (1U << CAN_ESR_BOFF_Pos)
+#define CAN_ESR_LEC (7U << CAN_ESR_LEC_Pos)
+#define CAN_ESR_TEC (255U << CAN_ESR_TEC_Pos)
+#define CAN_ESR_REC (255U << CAN_ESR_REC_Pos)
+#define CAN_TSR_RQCP0 1U
+#define CAN_TSR_TXOK0 2U
+#define CAN_TSR_ALST0 4U
+#define CAN_TSR_TERR0 8U
+#define CAN_TSR_TME0 (1U << 26)
+#define CAN_RF0R_FMP0 3U
+#define CAN_RF0R_FOVR0 (1U << 4)
+#define CAN_INTERRUPT_RATE 12000U
+#define LED_BLUE 2U
+static uint32_t blue_events, released[3], cleared[3], aborts[3], disabled[3], init_calls[3];
+static bool mock_speed_ok = true, mock_init_ok = true;
+static bool observed_silent[3], observed_loopback[3];
+static uint32_t observed_speed[3];
+static unsigned int index_of(const CAN_TypeDef *can) { return (unsigned int)(can - mock_can); }
+static void led_set(uint8_t led, bool on) { if ((led == LED_BLUE) && on) blue_events++; }
+static bool llcan_set_speed(CAN_TypeDef *can, uint32_t speed, bool loopback, bool silent) {
+  unsigned int i = index_of(can); observed_speed[i] = speed; observed_loopback[i] = loopback; observed_silent[i] = silent;
+  return mock_speed_ok;
+}
+static bool llcan_init(CAN_TypeDef *can) { init_calls[index_of(can)]++; return mock_init_ok; }
+static void llcan_irq_disable(const CAN_TypeDef *can) { disabled[index_of(can)]++; }
+static void llcan_clear_send(CAN_TypeDef *can) { aborts[index_of(can)]++; }
+static void llcan_clear_tx_status(CAN_TypeDef *can) {
+  cleared[index_of(can)]++; can->TSR &= ~(CAN_TSR_RQCP0 | CAN_TSR_TXOK0 | CAN_TSR_ALST0 | CAN_TSR_TERR0);
+}
+static void llcan_clear_rx_overrun(CAN_TypeDef *can) { can->RF0R &= ~CAN_RF0R_FOVR0; }
+static void llcan_release_rx(CAN_TypeDef *can) { released[index_of(can)]++; can->RF0R &= ~CAN_RF0R_FMP0; }
+typedef struct { void (*handler)(void); uint32_t call_rate; } mock_interrupt;
+static mock_interrupt interrupts[9];
+#define REGISTER_INTERRUPT(irq, fn, maxrate, fault) interrupts[irq].handler = fn;
+#include "board/drivers/bxcan.h"
+
+static unsigned int assertions, groups;
+#define CHECK(condition) do { assertions++; if (!(condition)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #condition); exit(1); } } while (0)
+static void group(const char *name) { groups++; printf("PASS %s\n", name); }
+static void reset(void) {
+  memset(mock_can, 0, sizeof(mock_can)); memset(can_health, 0, sizeof(can_health));
+  memset(released, 0, sizeof(released)); memset(cleared, 0, sizeof(cleared)); memset(aborts, 0, sizeof(aborts));
+  memset(disabled, 0, sizeof(disabled)); memset(init_calls, 0, sizeof(init_calls));
+  memset(interrupts, 0, sizeof(interrupts));
+  rx_buffer_overflow = 0U; tx_buffer_overflow = 0U; safety_tx_blocked = 0U; safety_rx_invalid = 0U;
+  blue_events = 0U; refreshed = 0U; mock_speed_ok = true; mock_init_ok = true;
+  can_silent = true; can_loopback = false; can_set_orientation(false);
+  can_clear(&can_rx_q);
+  for (uint8_t i = 0U; i < 3U; i++) { can_clear(can_queues[i]); mock_can[i].TSR = CAN_TSR_TME0; }
+  CHECK(set_safety_hooks(SAFETY_NOOUTPUT, 0U) == 0);
+}
+static CANPacket_t packet(uint8_t bus, uint32_t addr, uint8_t dlc, bool extended) {
+  CANPacket_t p = {0}; p.bus = bus; p.addr = addr; p.extended = extended; p.data_len_code = dlc;
+  for (unsigned int i = 0U; i < 64U; i++) p.data[i] = (uint8_t)(0x80U + i);
+  can_set_checksum(&p); return p;
+}
+static void receive(uint8_t controller, uint32_t addr, uint8_t dlc, bool extended, bool remote) {
+  CAN_TypeDef *can = &mock_can[controller];
+  can->sFIFOMailBox[0].RIR = (extended ? addr << 3 : addr << 21) | (extended ? 4U : 0U) | (remote ? 2U : 0U);
+  can->sFIFOMailBox[0].RDTR = dlc;
+  can->sFIFOMailBox[0].RDLR = 0x83828180U; can->sFIFOMailBox[0].RDHR = 0x87868584U;
+  can->RF0R = (can->RF0R & ~CAN_RF0R_FMP0) | 1U;
+  can_rx(controller);
+}
+int main(void) {
+  reset();
+  CHECK(sizeof(CANPacket_t) == 72U); CHECK(sizeof(can_health_t) == 64U);
+  CHECK(CAN_RX_BUFFER_SIZE == 256U); CHECK(CAN_TX_BUFFER_SIZE == 64U);
+  CHECK(can_rx_q.fifo_size == 256U); CHECK(can_slots_empty(&can_tx1_q) == 63U);
+  group("bxcan_current_abi_and_f4_queue_budget");
+
+  reset(); CHECK(set_safety_hooks(SAFETY_ALLOUTPUT, 0U) == 0);
+  for (uint8_t bus = 0U; bus < 3U; bus++) {
+    CANPacket_t p = packet(bus, 0x700U + bus, 8U, false); can_send(&p, bus, false);
+    CHECK(mock_can[bus].sTxMailBox[0].TIR == ((0x700U + bus) << 21 | 1U));
+    CHECK(mock_can[bus].sTxMailBox[0].TDTR == 8U); CHECK(mock_can[bus].sTxMailBox[0].TDLR == 0x83828180U);
+    CHECK(mock_can[bus].sTxMailBox[0].TDHR == 0x87868584U); CHECK(can_health[bus].total_tx_cnt == 1U);
+    mock_can[bus].TSR = CAN_TSR_TME0 | CAN_TSR_RQCP0 | CAN_TSR_TXOK0; process_can(bus);
+    CANPacket_t receipt; CHECK(can_pop(&can_rx_q, &receipt)); CHECK(receipt.returned && !receipt.rejected && !receipt.fd);
+    CHECK(receipt.bus == bus && receipt.addr == p.addr && receipt.data_len_code == 8U); CHECK(can_check_checksum(&receipt)); CHECK(cleared[bus] == 1U);
+    process_can(bus); CHECK(!can_pop(&can_rx_q, &receipt));
+  }
+  group("bxcan_three_mailboxes_success_receipt_once");
+
+  reset(); CHECK(set_safety_hooks(SAFETY_ALLOUTPUT, 0U) == 0);
+  for (uint8_t dlc = 0U; dlc <= 8U; dlc++) {
+    CANPacket_t p = packet(0U, 0x1fffffffU, dlc, true); can_send(&p, 0U, false);
+    CHECK(mock_can[0].sTxMailBox[0].TIR == 0xfffffffdU); CHECK(mock_can[0].sTxMailBox[0].TDTR == dlc);
+    mock_can[0].TSR = CAN_TSR_TME0 | CAN_TSR_RQCP0 | CAN_TSR_TXOK0; process_can(0U);
+    CANPacket_t receipt; CHECK(can_pop(&can_rx_q, &receipt)); CHECK(receipt.addr == p.addr && receipt.extended && receipt.data_len_code == dlc);
+  }
+  group("bxcan_classic_dlc0_to8_and_extended_id");
+
+  reset(); CANPacket_t blocked = packet(1U, 0x123U, 8U, false); can_send(&blocked, 1U, false);
+  CHECK(!controls_allowed); CHECK(mock_can[1].sTxMailBox[0].TIR == 0U); CHECK(safety_tx_blocked == 1U);
+  CANPacket_t receipt; CHECK(can_pop(&can_rx_q, &receipt)); CHECK(receipt.rejected && !receipt.returned && can_check_checksum(&receipt));
+  receive(0U, 0x123U, 8U, false, false); CHECK(can_health[0].total_fwd_cnt == 0U); CHECK(mock_can[2].sTxMailBox[0].TIR == 0U);
+  group("bxcan_real_nooutput_blocks_tx_and_forwarding");
+
+  reset(); CHECK(set_safety_hooks(SAFETY_ALLOUTPUT, 1U) == 0);
+  receive(0U, 0x123U, 8U, false, false);
+  CHECK(can_health[0].total_fwd_cnt == 1U); CHECK(can_health[2].total_tx_cnt == 1U); CHECK(mock_can[2].sTxMailBox[0].TIR == (0x123U << 21 | 1U));
+  CHECK(can_pop(&can_rx_q, &receipt)); CHECK(receipt.bus == 0U && !receipt.returned && !receipt.rejected);
+  receive(2U, 0x321U, 8U, false, false); CHECK(can_health[2].total_fwd_cnt == 1U); CHECK(can_health[0].total_tx_cnt == 1U);
+  receive(1U, 0x321U, 8U, false, false); CHECK(can_health[1].total_fwd_cnt == 0U);
+  group("bxcan_real_safety_forwarding_both_directions");
+
+  reset();
+  for (uint8_t bus = 0U; bus < 3U; bus++) {
+    for (uint8_t dlc = 0U; dlc <= 8U; dlc++) {
+      receive(bus, 0x1abcdefU, dlc, true, false); CHECK(released[bus] == (uint32_t)dlc + 1U);
+      CHECK(can_pop(&can_rx_q, &receipt)); CHECK(receipt.bus == bus && receipt.addr == 0x1abcdefU && receipt.extended);
+      CHECK(receipt.data_len_code == dlc && !receipt.fd && !receipt.returned && !receipt.rejected); CHECK(can_check_checksum(&receipt));
+    }
+    CHECK(can_health[bus].total_rx_cnt == 9U);
+  }
+  CHECK(blue_events == 27U); group("bxcan_rx_three_buses_dlc_and_current_checksum");
+
+  reset(); CHECK(set_safety_hooks(SAFETY_ALLOUTPUT, 1U) == 0);
+  for (uint8_t dlc = 9U; dlc < 16U; dlc++) receive(0U, 0x123U, dlc, false, false);
+  receive(0U, 0x123U, 8U, false, true);
+  CHECK(can_health[0].total_rx_lost_cnt == 8U); CHECK(can_health[0].total_fwd_cnt == 0U);
+  CHECK(can_health[2].total_tx_cnt == 0U); CHECK(blue_events == 0U); CHECK(released[0] == 8U);
+  CHECK(!can_pop(&can_rx_q, &receipt)); group("bxcan_invalid_rx_dlc_and_rtr_never_forwarded");
+
+  reset();
+  for (unsigned int invalid = 0U; invalid < 12U; invalid++) {
+    CANPacket_t p = packet(0U, 0x123U, 8U, false);
+    if (invalid == 0U) p.fd = 1U;
+    else if (invalid <= 7U) p.data_len_code = (uint8_t)(invalid + 8U);
+    else if (invalid == 8U) p.returned = 1U;
+    else if (invalid == 9U) p.rejected = 1U;
+    else if (invalid == 10U) p.bus = 3U;
+    else p.addr = 0x800U;
+    can_set_checksum(&p); CHECK(can_push(&can_tx1_q, &p)); process_can(0U);
+    CHECK(mock_can[0].sTxMailBox[0].TIR == 0U); CHECK(can_health[0].total_tx_lost_cnt == invalid + 1U);
+  }
+  CANPacket_t badsum = packet(0U, 0x123U, 8U, false); badsum.data[0] ^= 1U;
+  CHECK(can_push(&can_tx1_q, &badsum)); process_can(0U); CHECK(can_health[0].total_tx_checksum_error_cnt == 1U);
+  CHECK(can_health[0].total_tx_cnt == 0U); group("bxcan_mailbox_defense_fd_dlc_flags_bus_addr_checksum");
+
+  reset(); CHECK(set_safety_hooks(SAFETY_ALLOUTPUT, 0U) == 0); mock_can[0].TSR = 0U;
+  CANPacket_t queued = packet(0U, 0x123U, 8U, false);
+  for (unsigned int i = 0U; i < 64U; i++) can_send(&queued, 0U, false);
+  CHECK(can_slots_empty(&can_tx1_q) == 0U); CHECK(tx_buffer_overflow == 1U); CHECK(can_health[0].total_tx_cnt == 0U);
+  mock_can[0].TSR = CAN_TSR_TME0; process_can(0U); CHECK(can_slots_empty(&can_tx1_q) == 1U); CHECK(can_health[0].total_tx_cnt == 1U);
+  CHECK(can_slots_empty(&can_tx2_q) == 63U && can_slots_empty(&can_tx3_q) == 63U);
+  group("bxcan_busy_mailbox_queue_overflow_and_bus_isolation");
+
+  reset(); queued = packet(0U, 0x123U, 8U, false);
+  for (unsigned int i = 0U; i < 255U; i++) CHECK(can_push(&can_rx_q, &queued));
+  receive(1U, 0x321U, 8U, false, false); CHECK(rx_buffer_overflow == 1U); CHECK(released[1] == 1U);
+  group("bxcan_rx_host_queue_overflow_still_releases_fifo");
+
+  reset();
+  mock_can[0].TSR = CAN_TSR_TME0 | CAN_TSR_RQCP0 | CAN_TSR_TERR0; process_can(0U);
