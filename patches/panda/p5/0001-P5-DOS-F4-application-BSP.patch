+/* Compiled by arm-none-eabi-gcc for both Cortex-M4 and Cortex-M7; never host ABI. */
+#include <stdint.h>
+#include <stddef.h>
+#include "board/health.h"
+#include "opendbc/safety/can.h"
+#ifndef EXPECT_HEALTH
+#define EXPECT_HEALTH 48U
+#endif
+#ifndef EXPECT_CAN
+#define EXPECT_CAN 72U
+#endif
+#ifndef EXPECT_DATA_OFFSET
+#define EXPECT_DATA_OFFSET 6U
+#endif
+_Static_assert(sizeof(void *) == 4, "ARM32 target required");
+_Static_assert(__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__, "little-endian wire ABI");
+_Static_assert(sizeof(struct health_t) == EXPECT_HEALTH, "health ABI mismatch");
+_Static_assert(sizeof(can_health_t) == 64U, "CAN health ABI mismatch");
+_Static_assert(sizeof(CANPacket_t) == EXPECT_CAN, "CAN packet ABI mismatch");
+_Static_assert(_Alignof(CANPacket_t) == 4U, "CAN packet alignment mismatch");
+_Static_assert(offsetof(CANPacket_t, data) == EXPECT_DATA_OFFSET, "CAN payload offset mismatch");
+_Static_assert(CANPACKET_HEAD_SIZE == 6U, "CAN header mismatch");
+_Static_assert(CANPACKET_DATA_SIZE_MAX == 64U, "CAN storage must not shrink on F4");
+__attribute__((section(".p5abi"), used)) const uint32_t p5_abi[] = {
+  0x50354142U, sizeof(void *), sizeof(struct health_t), sizeof(can_health_t),
+  sizeof(CANPacket_t), _Alignof(CANPacket_t), offsetof(CANPacket_t, data),
+  CANPACKET_HEAD_SIZE, CANPACKET_DATA_SIZE_MAX, HEALTH_PACKET_VERSION,
+  CAN_PACKET_VERSION_HASH, __ARM_ARCH,
+};
+__attribute__((section(".p5can"), used)) const CANPacket_t p5_can = {
+  .fd = 0, .bus = 2, .data_len_code = 8, .addr = 0x123, .checksum = 0x95,
+  .data = {0, 1, 2, 3, 4, 5, 6, 7},
+};
diff --git a/tests/p5/audit_resources.py b/tests/p5/audit_resources.py
new file mode 100644
index 0000000..7a61e48
--- /dev/null
+++ b/tests/p5/audit_resources.py
@@ -0,0 +1,237 @@
+#!/usr/bin/env python3
+"""Audit an offline ARM candidate ELF/map/bin/signature and compiler stack data.
+
+This is a static allocation check, not a proof of maximum nested interrupt stack
+use or a claim that the unknown installed bootstub accepts this image.
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import json
+from pathlib import Path
+import re
+import struct
+
+
+def sha(path: Path) -> str:
+  return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def elf32(path: Path) -> dict:
+  data = path.read_bytes()
+  assert data[:7] == b"\x7fELF\x01\x01\x01", "ELF32 little endian required"
+  h = struct.unpack_from("<HHIIIIIHHHHHH", data, 16)
+  kind, machine, version, entry, phoff, shoff, flags, ehsize, phsize, phnum, shsize, shnum, shstr = h
+  assert kind == 2 and machine == 40 and version == 1 and ehsize == 52 and shsize == 40
+  assert phsize == 32 and phnum > 0 and shnum > 0
+  raw = [struct.unpack_from("<10I", data, shoff + i * shsize) for i in range(shnum)]
+  names = data[raw[shstr][4]:raw[shstr][4] + raw[shstr][5]]
+  sections = {}
+  for i, row in enumerate(raw):
+    name = names[row[0]:].split(b"\0", 1)[0].decode()
+    sections[name] = dict(zip(("name_offset", "type", "flags", "address", "offset", "size", "link", "info", "alignment", "entry_size"), row))
+    sections[name]["index"] = i
+  symbols = {}
+  for section in sections.values():
+    if section["type"] != 2:
+      continue
+    strings = raw[section["link"]]
+    string_data = data[strings[4]:strings[4] + strings[5]]
+    assert section["entry_size"] == 16
+    for offset in range(section["offset"], section["offset"] + section["size"], 16):
+      name, value, size, info, other, index = struct.unpack_from("<IIIBBH", data, offset)
+      label = string_data[name:].split(b"\0", 1)[0].decode()
+      if label:
+        symbols[label] = {"value": value, "size": size, "info": info, "section_index": index}
+  programs = [dict(zip(("type", "offset", "vaddr", "paddr", "filesz", "memsz", "flags", "align"),
+                      struct.unpack_from("<8I", data, phoff + i * phsize))) for i in range(phnum)]
+  return {"entry": entry, "flags": flags, "sections": sections, "symbols": symbols, "programs": programs}
+
+
+def signature(raw: bytes, signed: bytes, pubkey: Path) -> dict:
+  key = base64.b64decode(pubkey.read_text().split()[1])
+  values = []
+  while key:
+    count = struct.unpack_from(">I", key)[0]
+    values.append(key[4:4 + count])
+    key = key[4 + count:]
+  assert len(values) == 3 and values[0] == b"ssh-rsa"
+  exponent, modulus = [int.from_bytes(x, "big") for x in values[1:]]
+  assert modulus.bit_length() == 1024
+  assert len(signed) == len(raw) + 136
+  length = struct.unpack_from("<I", signed)[0]
+  assert length == len(raw) + 8
+  assert signed[4:len(raw)] == raw[4:]
+  assert signed[len(raw):length] == b"VERS\x02\0\0\0"
+  digest = hashlib.sha1(signed[4:length]).digest()
+  padding = b"\x00\x01" + b"\xff" * 0x69 + b"\x00" + digest
+  actual = pow(int.from_bytes(signed[length:], "big"), exponent, modulus).to_bytes(128, "big")
+  assert actual == padding, "debug signature mismatch"
+  return {"scheme": "official panda development RSA1024/SHA1", "version": 2,
+          "app_length_with_version": length, "signature_bytes": 128, "verified_with_public_key_sha256": sha(pubkey)}
+
+
+def callgraph(directory: Path) -> dict:
+  nodes, edges = {}, {}
+  files = sorted(directory.rglob("*.ci"))
+  assert files, "fresh compiler -fcallgraph-info=su required"
+  for path in files:
+    source = path.read_text()
+    for name, label in re.findall(r'node: \{ title: "([^"]+)" label: "([^"]+)"', source):
+      frame = re.search(r'\\n(\d+) bytes \(([^)]+)\)', label)
+      if frame:
+        assert frame[2] in ("static", "dynamic,bounded")
+        nodes[name] = int(frame[1])
+    for caller, callee in re.findall(r'edge: \{ sourcename: "([^"]+)" targetname: "([^"]+)"', source):
+      edges.setdefault(caller, set()).add(callee)
+  assert nodes
+  cache, cycles = {}, set()
+
+  def longest(name: str, active: frozenset[str]) -> tuple[int, list[str]]:
+    if name in active:
+      cycles.add(name)
+      return 0, []
+    if name in cache:
+      return cache[name]
+    candidates = [longest(n, active | {name}) for n in edges.get(name, ()) if n in nodes]
+    size, chain = max(candidates, key=lambda pair: pair[0], default=(0, []))
+    cache[name] = size + nodes[name], [name, *chain]
+    return cache[name]
+
+  size, chain = max((longest(n, frozenset()) for n in nodes), key=lambda pair: pair[0])
+  return {"maximum_known_direct_chain_bytes": size, "chain": chain, "cycles": sorted(cycles),
+          "unknown_or_indirect_calls": sorted({callee for callees in edges.values() for callee in callees if callee not in nodes}),
+          "compiler_nodes": len(nodes), "complete_worst_case_bound": False,
+          "files": [{"path": str(path), "sha256": sha(path)} for path in files]}
+
+
+def main() -> int:
+  p = argparse.ArgumentParser(description=__doc__)
+  p.add_argument("--target", choices=("f4", "h7"), required=True)
+  p.add_argument("--elf", type=Path, required=True)
+  p.add_argument("--map", type=Path, required=True)
+  p.add_argument("--raw", type=Path, required=True)
+  p.add_argument("--signed", type=Path, required=True)
+  p.add_argument("--public-key", type=Path, required=True)
+  p.add_argument("--stack-dir", type=Path, required=True)
+  p.add_argument("--output", type=Path, required=True)
+  args = p.parse_args()
+  image = elf32(args.elf)
+  sections, symbols = image["sections"], image["symbols"]
+  start = 0x08004000 if args.target == "f4" else 0x08020000
+  flash_end = 0x08100000
+  raw, signed = args.raw.read_bytes(), args.signed.read_bytes()
+  assert sections[".isr_vector"]["address"] == start
+  assert symbols["_app_start"]["value"] == start
+  assert start <= (image["entry"] & ~1) < start + len(raw) and image["entry"] & 1
+  assert len(signed) <= flash_end - start
+  assert len(raw) <= flash_end - start - 136
+  load = [x for x in image["programs"] if x["type"] == 1 and x["filesz"] > 0]
+  assert load and all(start <= x["paddr"] < x["paddr"] + x["filesz"] <= flash_end - 136 for x in load)
+  assert min(x["paddr"] for x in load) == start
+  assert max(x["paddr"] + x["filesz"] for x in load) == start + len(raw)
+  elf_bytes = args.elf.read_bytes()
+  for segment in load:
+    pos = segment["paddr"] - start
+    assert raw[pos:pos + segment["filesz"]] == elf_bytes[segment["offset"]:segment["offset"] + segment["filesz"]]
+  raw_sp, reset = struct.unpack_from("<II", raw)
+  assert raw_sp == symbols["_estack"]["value"] and raw_sp % 8 == 0
+  assert reset == symbols["Reset_Handler"]["value"] and reset & 1
+  signing = signature(raw, signed, args.public_key)
+  # Every allocated non-flash section must fit exactly one declared silicon
+  # region. The F4 candidate intentionally uses only its lower 128 KiB SRAM.
+  regions = ({"SRAM_lower128": (0x20000000, 128 * 1024)} if args.target == "f4" else {
+    "DTCM": (0x20000000, 128 * 1024), "ITCM": (0, 64 * 1024), "AXISRAM": (0x24000000, 320 * 1024),
+    "SRAM12": (0x30000000, 32 * 1024), "SRAM4": (0x38000000, 16 * 1024), "BACKUP": (0x38800000, 4 * 1024)})
+  ram = {name: {"origin": origin, "capacity": capacity, "allocated_bytes": 0, "sections": []}
+         for name, (origin, capacity) in regions.items()}
+  intervals = []
+  for name, section in sections.items():
+    address, size = section["address"], section["size"]
+    if not (section["flags"] & 2) or size == 0 or start <= address < flash_end:
+      continue
+    matched = [n for n, (o, c) in regions.items() if o <= address and address + size <= o + c]
+    assert len(matched) == 1, (name, hex(address), size)
+    for a, b, other in intervals:
+      assert address + size <= a or b <= address, (name, other, "RAM overlap")
+    intervals.append((address, address + size, name))
+    record = ram[matched[0]]
+    record["allocated_bytes"] += size
+    record["sections"].append({"name": name, "address": address, "size": size})
+  stack_reserved = symbols["_Min_Stack_Size"]["value"]
+  cookies = {}
+  for cookie_name in ("enter_bootloader_mode", "fault_cookie"):
+    address = symbols[cookie_name]["value"]
+    overlaps = []
+    for symbol_name, symbol in symbols.items():
+      if (symbol["info"] & 15) != 1 or symbol["size"] == 0:
+        continue  # Only real allocated STT_OBJECT storage, not absolute labels.
+      begin, end = symbol["value"], symbol["value"] + symbol["size"]
+      if begin < address + 4 and address < end:
+        overlaps.append({"symbol": symbol_name, "start": begin, "end_exclusive": end,
+                         "size": symbol["size"], "overlap_bytes": min(end, address + 4) - max(begin, address)})
+    cookies[cookie_name] = {"start": address, "end_exclusive": address + 4, "bytes": 4,
+                            "overlapping_objects": sorted(overlaps, key=lambda item: item["symbol"])}
+  if args.target == "f4":
+    assert stack_reserved == 8192 and sections[".stack"]["size"] == 8192
+    assert symbols["_ebss"]["value"] <= symbols["_stack_bottom"]["value"]
+    assert symbols["fault_cookie"]["value"] == 0x2001FFF8 and symbols["enter_bootloader_mode"]["value"] == 0x2001FFFC
+    assert all(not value["overlapping_objects"] for value in cookies.values()), "F4 cookie overlaps live data storage"
+    assert symbols["_stack_bottom"]["value"] + 8192 == raw_sp
+    assert symbols["elems_rx_q"]["size"] == 256 * 72
+    assert all(symbols[f"elems_tx{i}_q"]["size"] == 64 * 72 for i in (1, 2, 3))
+    assert not any(name in symbols for name in ("spi_buf_rx", "spi_buf_tx")), "F4 unsupported SPI DMA buffers linked"
+    dma = {"spi_dma": "absent", "usb": "CPU FIFO; no configured DMA stream", "storage": "all allocated buffers in lower SRAM; no CCM section"}
+  else:
+    assert cookies["enter_bootloader_mode"]["start"] == 0x38001FFC
+    assert cookies["fault_cookie"]["start"] == 0x38003FFC
+    assert cookies["fault_cookie"]["overlapping_objects"] == []
+    assert cookies["enter_bootloader_mode"]["overlapping_objects"] == [
+      {"symbol": "mic_tx_buf", "start": 0x38001770, "end_exclusive": 0x38002770, "size": 4096, "overlap_bytes": 4}
+    ], "H7 inherited boot-cookie overlay changed; explicit review required"
+    dma = {}
+    for name in ("spi_buf_rx", "spi_buf_tx"):
+      symbol = symbols[name]
+      assert symbol["size"] == 4096 and 0x30000000 <= symbol["value"] < symbol["value"] + symbol["size"] <= 0x30008000
+      # The preserved H7 llspi config uses byte-wide MSIZE/PSIZE. Its buffers
+      # follow the one-byte readiness flag, so word alignment is not required.
+      dma[name] = {**symbol, "configured_transfer_width_bits": 8, "required_alignment_bytes": 1}
+  frames = []
+  for path in sorted(args.stack_dir.rglob("*.su")):
+    for line in path.read_text().splitlines():
+      location, size, qualifier = line.rsplit("\t", 2)
+      assert qualifier in ("static", "dynamic,bounded"), (path, line, "unbounded stack allocation")
+      frames.append({"location": location, "bytes": int(size), "qualifier": qualifier, "source": str(path)})
+  assert frames, "fresh compiler -fstack-usage files required"
+  frames.sort(key=lambda item: item["bytes"], reverse=True)
+  assert frames[0]["bytes"] <= stack_reserved, "single function exceeds reserved stack"
+  graph = callgraph(args.stack_dir)
+  assert not graph["cycles"], "direct recursive call chain requires an explicit bound"
+  assert graph["maximum_known_direct_chain_bytes"] <= stack_reserved, "known direct call chain exceeds reserved stack"
+  map_data = args.map.read_text()
+  assert all(token in map_data for token in (".isr_vector", "Reset_Handler", "_app_start", "_estack", ".bss"))
+  report = {"status": "PASS", "target": args.target, "flash": {"start": start, "limit": flash_end,
+            "boot_region_preserved_bytes": start - 0x08000000, "raw_bytes": len(raw), "signed_bytes": len(signed),
+            "remaining_bytes_after_signature": flash_end - start - len(signed)},
+            "signature": signing, "ram": ram, "dma": dma,
+            "boot_cookies": {"symbols": cookies, "isolated_from_live_objects": args.target == "f4",
+                             "inherited_h7_overlap_matches_locked_baseline": args.target == "h7",
+                             "runtime_impact_validated": False,
+                             "scope": "F4 isolation enforced; H7 exact inherited mic_tx_buf overlay disclosed and preserved, not approved as runtime-safe."},
+            "stack": {"reserved_bytes": stack_reserved, "maximum_single_frame": frames[0], "frames": frames, "direct_callgraph": graph,
+                      "worst_case_call_and_interrupt_depth_proven": False,
+                      "limitation": "Static allocation and single-frame budget only; no runtime watermark or complete call/interrupt nesting proof."},
+            "inputs": [{"path": str(path), "sha256": sha(path)} for path in
+                       [args.elf, args.map, args.raw, args.signed, args.public_key,
+                        *sorted(args.stack_dir.rglob("*.su")), *sorted(args.stack_dir.rglob("*.ci"))]],
+            "scope": "App-only development candidate; no installed-board memory/bootstub/signature compatibility claim", "device_access": False}
+  args.output.parent.mkdir(parents=True, exist_ok=True)
+  args.output.write_text(json.dumps(report, indent=2) + "\n")
+  print(f"PASS {args.target} resources: flash {len(signed)} bytes, stack reserve {stack_reserved}, max frame {frames[0]['bytes']}")
+  return 0
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
