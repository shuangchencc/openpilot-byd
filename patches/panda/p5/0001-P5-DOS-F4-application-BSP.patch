@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""Actual H7 CAN backend regression with documented FIFO ACK/address HAL substitutions."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+def sha(path):
+  return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--source", type=Path, required=True)
+  parser.add_argument("--opendbc", type=Path, required=True)
+  parser.add_argument("--output", type=Path, required=True)
+  parser.add_argument("--compiler", default="clang")
+  args = parser.parse_args()
+  root, opendbc, out = args.source.resolve(), args.opendbc.resolve(), args.output.resolve()
+  out.mkdir(parents=True, exist_ok=True)
+  source = root / "board/drivers/fdcan.h"
+  original = source.read_text()
+  substitutions = [
+    {"before": "FDCANx->RXF0A = rx_fifo_idx;", "after": "mock_rx_ack(FDCANx, rx_fifo_idx);"},
+    {"before": "uint32_t TxFIFOSA =", "after": "uintptr_t TxFIFOSA ="},
+    {"before": "uint32_t RxFIFO0SA =", "after": "uintptr_t RxFIFO0SA ="},
+  ]
+  adapted = original
+  for replacement in substitutions:
+    assert original.count(replacement["before"]) == 1
+    adapted = adapted.replace(replacement["before"], replacement["after"])
+  instrumented = out / "instrumented_fdcan.inc"
+  instrumented.write_text(adapted)
+  cmsis = root / "board/stm32h7/inc/stm32h725xx.h"
+  constants = [line for line in cmsis.read_text().splitlines()
+               if re.match(r"#define FDCAN_(PSR|ECR|IR|TXFQS|RXF0S)_", line)]
+  assert len(constants) > 80
+  (out / "fdcan_register_constants.inc").write_text("\n".join(constants) + "\n")
+  binary = out / "fdcan"
+  command = [args.compiler, "-std=gnu11", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function", "-Wno-unused-parameter",
+             "-Wno-int-to-pointer-cast", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-g",
+             "-I", str(root), "-I", str(root / "board"), "-I", str(opendbc), "-I", str(out),
+             "-MMD", "-MF", str(out / "fdcan.d"), str(root / "tests/p5/test_fdcan.c"), "-o", str(binary)]
+  subprocess.run(command, check=True, timeout=180)
+  run = subprocess.run([str(binary)], capture_output=True, text=True, timeout=60)
+  (out / "fdcan.log").write_text(run.stdout + run.stderr)
+  if run.returncode:
+    raise RuntimeError(run.stdout + run.stderr)
+  names = re.findall(r"^PASS (\S+)$", run.stdout, re.M)
+  summary = re.search(r"SUMMARY groups=(\d+) assertions=(\d+) failed=0 skipped=0", run.stdout)
+  assert summary and int(summary[1]) == len(names) == len(set(names))
+  dependencies = (out / "fdcan.d").read_text().replace("\\\n", " ").split(":", 1)[1].split()
+  report = {"status": "PASS", "groups": len(names), "assertions": int(summary[2]), "failed": 0, "skipped": 0,
+            "group_names": names, "command": command, "binary_sha256": sha(binary), "device_access": False,
+            "hal_substitutions": substitutions, "original_sha256": sha(source), "instrumented_sha256": sha(instrumented),
+            "sources": [{"path": str(path), "sha256": sha(Path(path))} for path in sorted(set(dependencies + [str(source), str(cmsis)]))],
+            "scope": "Actual H7 fdcan policy, real safety/queues; static fake message RAM and HAL register/ACK mocks; no MCU execution",
+            "queue_bank_layout": "Host queue storage only; target bank placement is checked by separate ARM ELF audit"}
+  (out / "result.json").write_text(json.dumps(report, indent=2) + "\n")
+  print(json.dumps({key: report[key] for key in ("status", "groups", "assertions", "failed", "skipped")}, sort_keys=True))
+
+
+if __name__ == "__main__":
+  main()
