@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Run offline candidate capability/health view tests; no hardware APIs or imports."""
+import argparse
+from dataclasses import asdict
+import hashlib
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import sys
+import unittest
+
+
+def main():
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--panda", type=Path, required=True)
+  parser.add_argument("--output", type=Path, required=True)
+  args = parser.parse_args()
+  panda, output = args.panda.resolve(), args.output.resolve()
+  output.mkdir(parents=True, exist_ok=True)
+  sys.path.insert(0, str(panda))
+  os.environ["P5_PANDA_SOURCE"] = str(panda)
+  spec = importlib.util.spec_from_file_location("p5_test_capabilities", panda / "tests/p5/test_capabilities.py")
+  module = importlib.util.module_from_spec(spec)
+  sys.modules[spec.name] = module
+  spec.loader.exec_module(module)
+  from tools.p5 import capabilities
+  if Path(capabilities.__file__).resolve() != panda / "tools/p5/capabilities.py":
+    raise RuntimeError("candidate decoder resolved outside the explicit panda source")
+  suite = unittest.defaultTestLoader.loadTestsFromModule(module)
+  selectors = [test.id() for group in suite for test in group]
+  stream = io.StringIO()
+  result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)
+  log = stream.getvalue()
+  (output / "capabilities.log").write_text(log)
+  passed = result.wasSuccessful() and not result.skipped and result.testsRun == len(selectors)
+  reply = module.firmware_capability_bytes()
+  view = capabilities.decode_health(module.health_payload(), capabilities.parse_capabilities(reply))
+  paths = [panda / path for path in ("board/main_comms.h", "board/health.h", "tools/p5/capabilities.py",
+                                    "tests/p5/test_capabilities.py", "tests/p5/run_capabilities.py")]
+  report = {"status": "PASS" if passed else "FAIL", "tests_run": result.testsRun, "failures": len(result.failures),
+            "errors": len(result.errors), "skipped": len(result.skipped), "selectors": selectors,
+            "actual_firmware_0xd5_hex": reply.hex(), "health_view_example": asdict(view),
+            "sources": [{"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()} for path in paths],
+            "device_access": False, "runtime_binding": "unbound", "deployable": False,
+            "scope": "Pure offline capability-aware health view; P4 host live handshake and binding remain pending"}
+  (output / "result.json").write_text(json.dumps(report, indent=2) + "\n")
+  print(json.dumps({key: report[key] for key in ("status", "tests_run", "failures", "errors", "skipped")}, sort_keys=True))
+  if not passed:
+    print(log)
+    raise SystemExit(1)
+
+
+if __name__ == "__main__":
+  main()
