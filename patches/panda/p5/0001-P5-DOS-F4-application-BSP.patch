+"""Pure offline view of the DOS/F4 candidate extension and canonical health.
+
+No discovery, Panda object or transport is imported. This does not bind a P4
+runtime profile or authorize a candidate to run on a physical board.
+"""
+from dataclasses import dataclass
+import struct
+
+CAPABILITY_LAYOUT = struct.Struct("<4sHHII")
+HEALTH_LAYOUT = struct.Struct("<IHHIIIIIHBBHBHBBHHHHB")
+HEALTH_HEADER_SHA256 = "f512bcff6925e233a35c00e2d921fe01933fd77c0705c573a233b170d73ce20d"
+CLASSIC_CAN = 1 << 0
+ADC_TEMPERATURE = 1 << 1
+FAN = 1 << 2
+VOLTAGE = 1 << 3
+HARNESS = 1 << 4
+KNOWN_FEATURES = CLASSIC_CAN | ADC_TEMPERATURE | FAN | VOLTAGE | HARNESS
+# F4C1/version1 describes this exact reference candidate; features cannot be
+# guessed from its board type or silently downgraded to another profile.
+REQUIRED_FEATURES = KNOWN_FEATURES
+SOUND_UNAVAILABLE = 1 << 0
+SPI_ERRORS_UNAVAILABLE = 1 << 1
+CURRENT_UNAVAILABLE = 1 << 2
+KNOWN_UNAVAILABLE = SOUND_UNAVAILABLE | SPI_ERRORS_UNAVAILABLE | CURRENT_UNAVAILABLE
+
+
+class CapabilityError(ValueError):
+  """The input does not satisfy the explicit candidate observation contract."""
+
+
+@dataclass(frozen=True)
+class CandidateCapabilities:
+  feature_bits: int
+  unavailable_bits: int
+
+
+@dataclass(frozen=True)
+class CandidateHealthView:
+  uptime_seconds: int
+  voltage_millivolts: int
+  temperature_celsius: int
+  current_milliamps: None
+  sound_output_level: None
+  spi_error_count: None
+  fan_power_percent: int
+  harness_status: int
+  flags: int
+  unavailable_fields: tuple[str, ...] = ("current_milliamps", "sound_output_level", "spi_error_count")
+  runtime_binding: str = "unbound"
+  deployable: bool = False
+
+
+def _bytes_exact(data: bytes, length: int, name: str) -> None:
+  if not isinstance(data, bytes) or len(data) != length:
+    raise CapabilityError(f"{name} must be exactly {length} bytes")
+
+
+def _validate_capabilities(capabilities: CandidateCapabilities) -> None:
+  if not isinstance(capabilities, CandidateCapabilities):
+    raise CapabilityError("an explicit parsed F4 candidate capability observation is required")
+  features, unavailable = capabilities.feature_bits, capabilities.unavailable_bits
+  if type(features) is not int or features < 0 or features & ~KNOWN_FEATURES:
+    raise CapabilityError("unknown or reserved candidate features")
+  if features & REQUIRED_FEATURES != REQUIRED_FEATURES:
+    raise CapabilityError("missing required candidate capability")
+  if type(unavailable) is not int or unavailable < 0 or unavailable & ~KNOWN_UNAVAILABLE:
+    raise CapabilityError("unknown or reserved unavailable-field bits")
+  if unavailable != KNOWN_UNAVAILABLE:
+    raise CapabilityError("version1 cannot present absent current, sound or SPI observations as available")
+
+
+def parse_capabilities(reply: bytes) -> CandidateCapabilities:
+  """Decode the exact firmware 0xd5 extension; no old-version fallback."""
+  _bytes_exact(reply, CAPABILITY_LAYOUT.size, "capability reply")
+  magic, version, length, features, unavailable = CAPABILITY_LAYOUT.unpack(reply)
+  if magic != b"F4C1" or version != 1 or length != CAPABILITY_LAYOUT.size:
+    raise CapabilityError("unknown capability magic, version or declared length")
+  capabilities = CandidateCapabilities(features, unavailable)
+  _validate_capabilities(capabilities)
+  return capabilities
+
+
+def decode_health(reply: bytes, capabilities: CandidateCapabilities) -> CandidateHealthView:
+  """Decode a display-only observation, masking unsupported fields as None.
+
+  A returned view is not safety approval or evidence of freshness, MCU identity,
+  firmware trust or physical calibration. These require separate session checks.
+  """
+  _validate_capabilities(capabilities)
+  _bytes_exact(reply, HEALTH_LAYOUT.size, "health reply")
+  values = HEALTH_LAYOUT.unpack(reply)
+  # The canonical ABI has no temperature unavailable sentinel. This candidate
+  # must advertise its implemented ADC provider, and firmware rejects complete
+  # health observations when calibration/conversion fails.
+  return CandidateHealthView(
+    uptime_seconds=values[0], voltage_millivolts=values[1], temperature_celsius=values[20] - 40,
+    current_milliamps=None, sound_output_level=None, spi_error_count=None,
+    fan_power_percent=values[15], harness_status=values[9], flags=values[8],
+  )
