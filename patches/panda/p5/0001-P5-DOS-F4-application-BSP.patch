diff --git a/board/drivers/bxcan.h b/board/drivers/bxcan.h
new file mode 100644
index 0000000..1cdbe7a
--- /dev/null
+++ b/board/drivers/bxcan.h
@@ -0,0 +1,184 @@
+#pragma once
+
+// Current packet/safety ABI on the last official STM32F413 bxCAN backend.
+// Mailbox 0 only preserves queue order. CAN FD is rejected, never truncated.
+#include "board/drivers/drivers.h"
+
+CAN_TypeDef *cans[PANDA_CAN_CNT] = {CAN1, CAN2, CAN3};
+static const uint8_t can_irq_number[PANDA_CAN_CNT][3] = {
+  {CAN1_TX_IRQn, CAN1_RX0_IRQn, CAN1_SCE_IRQn},
+  {CAN2_TX_IRQn, CAN2_RX0_IRQn, CAN2_SCE_IRQn},
+  {CAN3_TX_IRQn, CAN3_RX0_IRQn, CAN3_SCE_IRQn},
+};
+
+static bool can_set_speed(uint8_t can_number) {
+  uint8_t bus_number = BUS_NUM_FROM_CAN_NUM(can_number);
+  return llcan_set_speed(CANIF_FROM_CAN_NUM(can_number), bus_config[bus_number].can_speed, can_loopback, can_silent);
+}
+
+void can_clear_send(CAN_TypeDef *CANx, uint8_t can_number) {
+  // Abort only an outstanding mailbox, without counting an empty mailbox lost.
+  if ((CANx->TSR & CAN_TSR_TME0) == 0U) {
+    can_health[can_number].total_tx_lost_cnt += 1U;
+  }
+  can_health[can_number].can_core_reset_cnt += 1U;
+  llcan_clear_send(CANx);
+}
+
+void update_can_health_pkt(uint8_t can_number, uint32_t ir_reg) {
+  if (can_number < PANDA_CAN_CNT) {
+    CAN_TypeDef *CANx = CANIF_FROM_CAN_NUM(can_number);
+    uint32_t esr_reg = CANx->ESR;
+    can_health[can_number].bus_off = (esr_reg & CAN_ESR_BOFF) >> CAN_ESR_BOFF_Pos;
+    can_health[can_number].bus_off_cnt += can_health[can_number].bus_off;
+    can_health[can_number].error_warning = (esr_reg & CAN_ESR_EWGF) >> CAN_ESR_EWGF_Pos;
+    can_health[can_number].error_passive = (esr_reg & CAN_ESR_EPVF) >> CAN_ESR_EPVF_Pos;
+    can_health[can_number].last_error = (esr_reg & CAN_ESR_LEC) >> CAN_ESR_LEC_Pos;
+    if ((can_health[can_number].last_error != 0U) && (can_health[can_number].last_error != 7U)) {
+      can_health[can_number].last_stored_error = can_health[can_number].last_error;
+    }
+    can_health[can_number].receive_error_cnt = (esr_reg & CAN_ESR_REC) >> CAN_ESR_REC_Pos;
+    can_health[can_number].transmit_error_cnt = (esr_reg & CAN_ESR_TEC) >> CAN_ESR_TEC_Pos;
+    // No CAN-FD data phase exists on bxCAN; keep those current ABI fields zero.
+    can_health[can_number].last_data_error = 0U;
+    can_health[can_number].last_data_stored_error = 0U;
+    can_health[can_number].irq0_call_rate = interrupts[can_irq_number[can_number][0]].call_rate;
+    can_health[can_number].irq1_call_rate = interrupts[can_irq_number[can_number][1]].call_rate;
+    can_health[can_number].irq2_call_rate = interrupts[can_irq_number[can_number][2]].call_rate;
+    if (ir_reg != 0U) {
+      can_health[can_number].total_error_cnt += 1U;
+      if ((CANx->RF0R & CAN_RF0R_FOVR0) != 0U) {
+        can_health[can_number].total_rx_lost_cnt += 1U;
+        llcan_clear_rx_overrun(CANx);
+      }
+      can_clear_send(CANx, can_number);
+    }
+  }
+}
+
+static void can_sce(uint8_t can_number) {
+  update_can_health_pkt(can_number, 1U);
+}
+
+void process_can(uint8_t can_number) {
+  if (can_number < PANDA_CAN_CNT) {
+    ENTER_CRITICAL();
+    CAN_TypeDef *CANx = CANIF_FROM_CAN_NUM(can_number);
+    uint8_t bus_number = BUS_NUM_FROM_CAN_NUM(can_number);
+    if ((CANx->TSR & CAN_TSR_TME0) != 0U) {
+      if ((CANx->TSR & CAN_TSR_RQCP0) != 0U) {
+        if ((CANx->TSR & (CAN_TSR_TERR0 | CAN_TSR_ALST0)) != 0U) {
+          can_health[can_number].total_tx_lost_cnt += 1U;
+        } else if ((CANx->TSR & CAN_TSR_TXOK0) != 0U) {
+          CANPacket_t receipt = {0};
+          receipt.returned = 1U;
+          receipt.extended = (CANx->sTxMailBox[0].TIR >> 2) & 1U;
+          receipt.addr = (receipt.extended != 0U) ? (CANx->sTxMailBox[0].TIR >> 3) : (CANx->sTxMailBox[0].TIR >> 21);
+          receipt.data_len_code = CANx->sTxMailBox[0].TDTR & 0xFU;
+          receipt.bus = bus_number;
+          if (receipt.data_len_code <= 8U) {
+            WORD_TO_BYTE_ARRAY(&receipt.data[0], CANx->sTxMailBox[0].TDLR);
+            WORD_TO_BYTE_ARRAY(&receipt.data[4], CANx->sTxMailBox[0].TDHR);
+            can_set_checksum(&receipt);
+            rx_buffer_overflow += can_push(&can_rx_q, &receipt) ? 0U : 1U;
+          } else {
+            can_health[can_number].total_tx_lost_cnt += 1U;
+          }
+        } else {
+          // An aborted transmission is complete but was never put on the bus.
+        }
+        llcan_clear_tx_status(CANx);
+      }
+      CANPacket_t packet;
+      if (can_pop(can_queues[bus_number], &packet)) {
+        if (!can_check_checksum(&packet)) {
+          can_health[can_number].total_tx_checksum_error_cnt += 1U;
+        } else if (!can_packet_valid_for_tx(&packet, bus_number)) {
+          can_health[can_number].total_tx_lost_cnt += 1U;
+        } else {
+          can_health[can_number].total_tx_cnt += 1U;
+          CANx->sTxMailBox[0].TIR = ((packet.extended != 0U) ? ((uint32_t)packet.addr << 3) : ((uint32_t)packet.addr << 21)) | ((uint32_t)packet.extended << 2);
+          CANx->sTxMailBox[0].TDTR = packet.data_len_code;
+          BYTE_ARRAY_TO_WORD(CANx->sTxMailBox[0].TDLR, &packet.data[0]);
+          BYTE_ARRAY_TO_WORD(CANx->sTxMailBox[0].TDHR, &packet.data[4]);
+          CANx->sTxMailBox[0].TIR |= 1U;
+        }
+        refresh_can_tx_slots_available();
+      }
+    }
+    EXIT_CRITICAL();
+  }
+}
+
+static void can_rx(uint8_t can_number) {
+  CAN_TypeDef *CANx = CANIF_FROM_CAN_NUM(can_number);
+  uint8_t bus_number = BUS_NUM_FROM_CAN_NUM(can_number);
+  // Observe overrun even when there is no separate error IRQ delivery.
+  if ((CANx->RF0R & CAN_RF0R_FOVR0) != 0U) {
+    can_health[can_number].total_rx_lost_cnt += 1U;
+    llcan_clear_rx_overrun(CANx);
+  }
+  while ((CANx->RF0R & CAN_RF0R_FMP0) != 0U) {
+    can_health[can_number].total_rx_cnt += 1U;
+    CANPacket_t packet = {0};
+    packet.extended = (CANx->sFIFOMailBox[0].RIR >> 2) & 1U;
+    packet.addr = (packet.extended != 0U) ? (CANx->sFIFOMailBox[0].RIR >> 3) : (CANx->sFIFOMailBox[0].RIR >> 21);
+    packet.data_len_code = CANx->sFIFOMailBox[0].RDTR & 0xFU;
+    packet.bus = bus_number;
+    // RTR has no representation in the host ABI. Invalid classic DLC must not
+    // read extra bytes, masquerade as a data frame, or enter any safety hook.
+    if (((CANx->sFIFOMailBox[0].RIR & 2U) != 0U) || (packet.data_len_code > 8U)) {
+      can_health[can_number].total_rx_lost_cnt += 1U;
+    } else {
+      WORD_TO_BYTE_ARRAY(&packet.data[0], CANx->sFIFOMailBox[0].RDLR);
+      WORD_TO_BYTE_ARRAY(&packet.data[4], CANx->sFIFOMailBox[0].RDHR);
+      can_set_checksum(&packet);
+      int destination = safety_fwd_hook(bus_number, packet.addr);
+      if ((destination >= 0) && (destination < (int)PANDA_CAN_CNT)) {
+        CANPacket_t forwarded = packet;
+        can_send(&forwarded, (uint8_t)destination, true);
+        can_health[can_number].total_fwd_cnt += 1U;
+      }
+      safety_rx_invalid += safety_rx_hook(&packet) ? 0U : 1U;
+      ignition_can_hook(&packet);
+      led_set(LED_BLUE, true);
+      rx_buffer_overflow += can_push(&can_rx_q, &packet) ? 0U : 1U;
+    }
+    llcan_release_rx(CANx);
+  }
+}
+
+static void CAN1_TX_IRQ_Handler(void) { process_can(0U); }
+static void CAN1_RX0_IRQ_Handler(void) { can_rx(0U); }
+static void CAN1_SCE_IRQ_Handler(void) { can_sce(0U); }
+static void CAN2_TX_IRQ_Handler(void) { process_can(1U); }
+static void CAN2_RX0_IRQ_Handler(void) { can_rx(1U); }
+static void CAN2_SCE_IRQ_Handler(void) { can_sce(1U); }
+static void CAN3_TX_IRQ_Handler(void) { process_can(2U); }
+static void CAN3_RX0_IRQ_Handler(void) { can_rx(2U); }
+static void CAN3_SCE_IRQ_Handler(void) { can_sce(2U); }
+
+bool can_init(uint8_t can_number) {
+  REGISTER_INTERRUPT(CAN1_TX_IRQn, CAN1_TX_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_1)
+  REGISTER_INTERRUPT(CAN1_RX0_IRQn, CAN1_RX0_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_1)
+  REGISTER_INTERRUPT(CAN1_SCE_IRQn, CAN1_SCE_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_1)
+  REGISTER_INTERRUPT(CAN2_TX_IRQn, CAN2_TX_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_2)
+  REGISTER_INTERRUPT(CAN2_RX0_IRQn, CAN2_RX0_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_2)
+  REGISTER_INTERRUPT(CAN2_SCE_IRQn, CAN2_SCE_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_2)
+  REGISTER_INTERRUPT(CAN3_TX_IRQn, CAN3_TX_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_3)
+  REGISTER_INTERRUPT(CAN3_RX0_IRQn, CAN3_RX0_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_3)
+  REGISTER_INTERRUPT(CAN3_SCE_IRQn, CAN3_SCE_IRQ_Handler, CAN_INTERRUPT_RATE, FAULT_INTERRUPT_RATE_CAN_3)
+  bool ret = false;
+  if (can_number < PANDA_CAN_CNT) {
+    CAN_TypeDef *CANx = CANIF_FROM_CAN_NUM(can_number);
+    llcan_irq_disable(CANx);
+    ret = can_set_speed(can_number);
+    if (ret) {
+      ret = llcan_init(CANx);
+    }
+    if (ret) {
+      process_can(can_number);
+    }
+  }
+  return ret;
+}
