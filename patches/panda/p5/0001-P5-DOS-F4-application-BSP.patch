diff --git a/tests/p5/test_capabilities.py b/tests/p5/test_capabilities.py
new file mode 100644
index 0000000..6839b85
--- /dev/null
+++ b/tests/p5/test_capabilities.py
@@ -0,0 +1,149 @@
+"""Pure offline capability-aware view, sourced from the actual firmware initializer."""
+import ast
+from dataclasses import asdict
+import hashlib
+import os
+from pathlib import Path
+import re
+import struct
+import unittest
+
+from tools.p5.capabilities import (
+  ADC_TEMPERATURE, CAPABILITY_LAYOUT, CURRENT_UNAVAILABLE, CandidateCapabilities,
+  CapabilityError, HEALTH_HEADER_SHA256, HEALTH_LAYOUT, KNOWN_FEATURES, KNOWN_UNAVAILABLE,
+  decode_health, parse_capabilities,
+)
+
+PANDA = Path(os.environ["P5_PANDA_SOURCE"]).resolve()
+
+
+def firmware_capability_bytes():
+  source = (PANDA / "board/main_comms.h").read_text()
+  match = re.search(r"case 0xd5:\s*\{\s*const uint8_t capabilities\[16\] = \{([^}]+)\};", source, re.S)
+  if not match:
+    raise AssertionError("missing actual complete 0xd5 capability initializer")
+  values = []
+  for item in match[1].split(","):
+    token = item.strip()
+    if not token:
+      continue
+    if re.fullmatch(r"'[^']'", token):
+      values.append(ord(ast.literal_eval(token)))
+    elif re.fullmatch(r"(?:0x[0-9a-fA-F]+|\d+)[uU]?", token):
+      values.append(int(token.rstrip("uU"), 0))
+    else:
+      raise AssertionError(f"unexpected C byte literal: {token}")
+  reply = bytes(values)
+  if len(reply) != 16:
+    raise AssertionError("firmware initializer must contain exactly16bytes")
+  return reply
+
+
+def health_payload(current=0, spi=0, sound=0, temperature=75):
+  # Independent canonical wire offsets, verified by the unchanged header hash.
+  wire = bytearray(48)
+  struct.pack_into("<IHH", wire, 0, 123, 12500, current)
+  struct.pack_into("<H", wire, 28, 1)
+  wire[30] = 2
+  wire[37] = 128
+  wire[38] = 42
+  struct.pack_into("<H", wire, 39, spi)
+  struct.pack_into("<H", wire, 45, sound)
+  wire[47] = temperature
+  return bytes(wire)
+
+
+class CandidateCapabilitiesTests(unittest.TestCase):
+  @classmethod
+  def setUpClass(cls):
+    cls.reply = firmware_capability_bytes()
+    cls.capabilities = parse_capabilities(cls.reply)
+
+  def test_actual_firmware_bytes_and_unchanged_health_header(self):
+    self.assertEqual(hashlib.sha256((PANDA / "board/health.h").read_bytes().replace(b"\r", b"")).hexdigest(), HEALTH_HEADER_SHA256)
+    self.assertEqual(CAPABILITY_LAYOUT.size, 16)
+    self.assertEqual(HEALTH_LAYOUT.size, 48)
+    self.assertEqual(self.reply[:8], b"F4C1\1\0\x10\0")
+    self.assertEqual(self.capabilities.feature_bits, KNOWN_FEATURES)
+    self.assertEqual(self.capabilities.unavailable_bits, KNOWN_UNAVAILABLE)
+
+  def test_unsupported_zero_fields_are_absent_not_measurements(self):
+    view = decode_health(health_payload(), self.capabilities)
+    self.assertIsNone(view.current_milliamps)
+    self.assertIsNone(view.sound_output_level)
+    self.assertIsNone(view.spi_error_count)
+    self.assertEqual(view.voltage_millivolts, 12500)
+    self.assertEqual(view.temperature_celsius, 35)
+    self.assertEqual(view.uptime_seconds, 123)
+    self.assertEqual(view.harness_status, 2)
+    self.assertEqual(view.fan_power_percent, 42)
+    self.assertEqual(view.flags, 1)
+
+  def test_masked_fields_never_become_available_even_nonzero(self):
+    view = decode_health(health_payload(current=65000, spi=120, sound=30000), self.capabilities)
+    self.assertEqual((view.current_milliamps, view.spi_error_count, view.sound_output_level), (None, None, None))
+    self.assertEqual(view.unavailable_fields, ("current_milliamps", "sound_output_level", "spi_error_count"))
+
+  def test_no_binding_or_deployment_authority(self):
+    view = asdict(decode_health(health_payload(), self.capabilities))
+    self.assertEqual(view["runtime_binding"], "unbound")
+    self.assertFalse(view["deployable"])
+
+  def test_capability_lengths_and_nonbytes_fail(self):
+    for length in range(40):
+      if length != 16:
+        with self.subTest(length=length), self.assertRaises(CapabilityError):
+          parse_capabilities((self.reply + bytes(40))[:length])
+    for value in (None, "F4C1", bytearray(self.reply), 16):
+      with self.subTest(value=type(value)), self.assertRaises(CapabilityError):
+        parse_capabilities(value)
+
+  def test_magic_version_and_declared_length_fail(self):
+    for offset, value in ((0, ord("H")), (4, 2), (5, 1), (6, 0), (6, 15), (6, 17), (7, 1)):
+      mutated = bytearray(self.reply)
+      mutated[offset] = value
+      with self.subTest(offset=offset, value=value), self.assertRaises(CapabilityError):
+        parse_capabilities(bytes(mutated))
+
+  def test_all_unknown_feature_and_unavailable_bits_fail(self):
+    for field, start in ((8, 5), (12, 3)):
+      for bit in range(start, 32):
+        mutated = bytearray(self.reply)
+        struct.pack_into("<I", mutated, field, struct.unpack_from("<I", mutated, field)[0] | (1 << bit))
+        with self.subTest(field=field, bit=bit), self.assertRaises(CapabilityError):
+          parse_capabilities(bytes(mutated))
+
+  def test_each_required_feature_missing_fails(self):
+    for bit in range(5):
+      mutated = bytearray(self.reply)
+      struct.pack_into("<I", mutated, 8, KNOWN_FEATURES & ~(1 << bit))
+      with self.subTest(bit=bit), self.assertRaises(CapabilityError):
+        parse_capabilities(bytes(mutated))
+
+  def test_each_unavailable_flag_missing_fails(self):
+    for bit in range(3):
+      mutated = bytearray(self.reply)
+      struct.pack_into("<I", mutated, 12, KNOWN_UNAVAILABLE & ~(1 << bit))
+      with self.subTest(bit=bit), self.assertRaises(CapabilityError):
+        parse_capabilities(bytes(mutated))
+
+  def test_health_short_long_legacy_and_empty_are_invalid(self):
+    for length in (0, 1, 47, 49, 58, 64):
+      with self.subTest(length=length), self.assertRaises(CapabilityError):
+        decode_health(bytes(length), self.capabilities)
+
+  def test_cannot_bypass_validation_with_manual_capability_object(self):
+    for caps in (None, CandidateCapabilities(KNOWN_FEATURES & ~ADC_TEMPERATURE, KNOWN_UNAVAILABLE),
+                 CandidateCapabilities(KNOWN_FEATURES, KNOWN_UNAVAILABLE & ~CURRENT_UNAVAILABLE),
+                 CandidateCapabilities(True, KNOWN_UNAVAILABLE), CandidateCapabilities(KNOWN_FEATURES, -1)):
+      with self.subTest(caps=caps), self.assertRaises(CapabilityError):
+        decode_health(health_payload(), caps)
+
+  def test_zero_temperature_only_valid_with_explicit_adc_capability(self):
+    self.assertEqual(decode_health(health_payload(temperature=0), self.capabilities).temperature_celsius, -40)
+    with self.assertRaises(CapabilityError):
+      decode_health(health_payload(temperature=0), CandidateCapabilities(KNOWN_FEATURES & ~ADC_TEMPERATURE, KNOWN_UNAVAILABLE))
+
+
+if __name__ == "__main__":
+  unittest.main(verbosity=2)
