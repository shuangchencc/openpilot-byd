+    for (uint32_t i = 0U; i < (can_read_buffer.ptr - overflow_len); i++) {
+      can_read_buffer.data[i] = can_read_buffer.data[overflow_len + i];
+    }
     can_read_buffer.ptr -= overflow_len;
   }
 
