new file mode 100644
index 0000000..16b8366
--- /dev/null
+++ b/tests/p5/run_safety.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Fresh pinned opendbc debug/release hooks and explicit official regression selectors.
+
+The --opendbc tree must be an isolated source archive, since upstream libsafety
+writes temporary objects beside safety.c. No Panda import or device operation.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import io
+import json
+from pathlib import Path
+import sys
+import unittest
+
+
+def sha(path: Path) -> str:
+  return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> int:
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument("--opendbc", type=Path, required=True)
+  parser.add_argument("--output", type=Path, required=True)
+  args = parser.parse_args()
+  source = args.opendbc.resolve()
+  args.output.mkdir(parents=True, exist_ok=True)
+  if (source / ".git").exists():
+    parser.error("--opendbc must be an isolated archive, not a Git checkout")
+  sys.path.insert(0, str(source))
+  from opendbc.safety.tests.libsafety import libsafety_py as api
+  from opendbc.safety.tests.test_byd import TestBydSafety
+  from opendbc.safety.tests.test_defaults import TestNoOutput, TestSilent, TestSafetyFramework
+  from opendbc.car.structs import CarParams
+  import opendbc
+  assert Path(opendbc.__file__).resolve().is_relative_to(source)
+
+  binaries = {}
+  for release in (False, True):
+    path = Path(api._build_libsafety(release=release))
+    binaries["release" if release else "debug"] = {"path": str(path), "sha256": sha(path)}
+  api.load(binaries["debug"]["path"])
+
+  class ExplicitPolicyTests(unittest.TestCase):
+    def test_debug_byd35_is_reference_only(self):
+      self.assertEqual(int(CarParams.SafetyModel.byd), 35)
+      self.assertEqual(api.libsafety.set_safety_hooks(35, 0), 0)
+      self.assertFalse(api.libsafety.get_controls_allowed())
+
+    def test_release_denies_debug_byd35(self):
+      lib = api.ffi.dlopen(binaries["release"]["path"])
+      lib.set_controls_allowed(True)
+      self.assertEqual(lib.set_safety_hooks(35, 0), -1)
+      self.assertFalse(lib.get_controls_allowed())
+      for bus in range(3):
+        self.assertFalse(lib.safety_tx_hook(api.make_CANPacket(0x1E2, bus, b"\0" * 8)))
+
+    def test_byd_wrong_bus_and_length_tx_denied(self):
+      fixture = TestBydSafety()
+      fixture.setUp()
+      lib = api.libsafety
+      for bus in range(3):
+        for length in (0, 1, 7, 8, 12, 64):
+          lib.set_controls_allowed(True)
+          packet = api.make_CANPacket(0x1E2, bus, b"\0" * length)
+          if bus != 0 or length != 8:
+            self.assertFalse(lib.safety_tx_hook(packet), (bus, length))
+
+    def test_nooutput_silent_reject_all_lengths_even_controls_true(self):
+      for mode in (0, 19):
+        self.assertEqual(api.libsafety.set_safety_hooks(mode, 0), 0)
+        for bus in range(4):
+          for length in (0, 1, 8, 12, 64):
+            api.libsafety.set_controls_allowed(True)
+            self.assertFalse(api.libsafety.safety_tx_hook(api.make_CANPacket(0x1E2, bus, b"\0" * length)))
+
+    def test_byd_wrong_bus_length_rx_cannot_enable(self):
+      fixture = TestBydSafety()
+      for bus, length in ((0, 8), (1, 8), (2, 7), (2, 12)):
+        fixture.setUp()
+        good = fixture._pcm_status_msg(True)
+        data = bytes(api.ffi.buffer(good[0].data, 8))
+        data = (data + bytes(64))[:length]
+        # Unmonitored frames may return true, but must never enter the BYD rx
+        # hook or establish freshness/enable. Assert the actual contract.
+        api.libsafety.safety_rx_hook(api.make_CANPacket(0x32D, bus, data))
+        self.assertFalse(api.libsafety.get_controls_allowed(), (bus, length))
+        self.assertFalse(api.libsafety.safety_config_valid(), (bus, length))
+
+    def test_byd_valid_rx_then_exact_timeout_boundary(self):
+      fixture = TestBydSafety()
+      fixture.setUp()
+      for i in range(16):
+        now = 1000 + i * 20000
+        api.libsafety.set_timer(now)
+        for packet in (fixture._angle_meas_msg(0), fixture._speed_msg(0),
+                       fixture._user_brake_msg(False), fixture._pcm_status_msg(True)):
+          self.assertTrue(api.libsafety.safety_rx_hook(packet))
+      self.assertTrue(api.libsafety.safety_config_valid())
+      api.libsafety.set_controls_allowed(True)
+      api.libsafety.set_timer(now + 1000000)
+      api.libsafety.safety_tick()
+      self.assertTrue(api.libsafety.get_controls_allowed())
+      api.libsafety.set_timer(now + 1000001)
+      api.libsafety.safety_tick()
+      self.assertFalse(api.libsafety.get_controls_allowed())
+      self.assertFalse(api.libsafety.safety_config_valid())
+
+  # Select concrete classes; do not count inherited abstract/helper classes or
+  # upstream's intentionally empty test_angle_cmd_when_enabled as coverage.
+  selectors = []
+  excluded = {"test_angle_cmd_when_enabled": "upstream empty test; actual acceleration/jerk tests selected",
+              "test_allow_user_regen_at_zero_speed": "upstream BYD has no regen input",
+              "test_not_allow_user_regen_when_moving": "upstream BYD has no regen input",
+              "test_prev_user_regen": "upstream BYD has no regen input",
+              "test_rx_hook_speed_mismatch": "upstream BYD has no second independent speed input"}
+  suite = unittest.TestSuite()
+  for cls in (TestNoOutput, TestSilent, TestSafetyFramework, TestBydSafety, ExplicitPolicyTests):
+    for method in unittest.defaultTestLoader.getTestCaseNames(cls):
+      if cls is TestBydSafety and method in excluded:
+        continue
+      selectors.append(f"{cls.__module__}.{cls.__name__}.{method}")
+      suite.addTest(cls(method))
+  stream = io.StringIO()
+  result = unittest.TextTestRunner(stream=stream, verbosity=2).run(suite)
+  log = args.output / "safety.log"
+  log.write_text(stream.getvalue())
+  report = {"status": "PASS" if result.wasSuccessful() and not result.skipped else "FAIL",
+            "tests_run": result.testsRun, "failures": len(result.failures), "errors": len(result.errors),
+            "skipped": len(result.skipped), "selectors": selectors, "binaries": binaries,
+            "unselected_inapplicable_byd_methods": excluded,
+            "log_sha256": sha(log), "source": str(source),
+            "source_files": [{"path": str(p.relative_to(source)), "sha256": sha(p)}
+                             for p in sorted((source / "opendbc/safety").rglob("*")) if p.suffix in (".h", ".c", ".py")],
+            "scope": "Host execution of real pinned opendbc hooks. BYD35 is debug-only Atto3 reference, not Song PLUS safety support.",
+            "hardware_access": False, "mcu_execution": False}
+  (args.output / "safety.json").write_text(json.dumps(report, indent=2) + "\n")
+  print(f"{report['status']} safety: {result.testsRun} tests, {len(result.failures)} failures, {len(result.errors)} errors, {len(result.skipped)} skipped")
+  if report["status"] != "PASS":
+    print(stream.getvalue())
+  return 0 if report["status"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
