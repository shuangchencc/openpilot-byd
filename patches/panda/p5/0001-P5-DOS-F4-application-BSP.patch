+  CHECK(CAN1->TSR == CAN_TSR_ABRQ0 && CAN1->MSR == CAN_MSR_ERRI);
+  group("llbxcan_w1c_masks_never_clear_unrelated_flags");
+  printf("SUMMARY groups=%u assertions=%u failed=0 skipped=0\n", groups, assertions); return 0;
