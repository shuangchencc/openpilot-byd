diff --git a/tools/p5/CAPABILITIES.md b/tools/p5/CAPABILITIES.md
new file mode 100644
index 0000000..0aea61d
--- /dev/null
+++ b/tools/p5/CAPABILITIES.md
@@ -0,0 +1,24 @@
+# Candidate capability view (offline only)
+
+`capabilities.py` is a pure standard-library decoder for the candidate's separate
+`0xd5` reply. Version 1 requires the exact 16-byte `F4C1` record, all five declared
+reference features, and explicit absence of current measurement, sound amplitude
+and SPI-error measurement. Unknown versions, bits, lengths or missing required
+features fail closed; a DOS board-type value alone is not sufficient.
+
+The canonical 48-byte health layout and hash remain unchanged. The offline view
+preserves voltage and ADC temperature while representing absent current, sound
+and SPI error fields as `None`, including when their raw slots contain nonzero
+bytes. A zero temperature byte can mean -40 C only when the explicit ADC provider
+capability is present. Firmware separately returns no complete health reply when
+ADC acquisition or factory calibration fails.
+
+`tests/p5/run_capabilities.py --panda <source> --output <directory>` extracts the
+actual C initializer from the candidate `0xd5` branch, validates its record, runs
+negative cases, and writes a view example and source hashes. Tests do not import
+Panda, create transports or acquire device handles.
+
+This module does not change the P4 runtime. Its future live capability handshake,
+per-field absence propagation and physical board binding remain pending. Every
+view reports `runtime_binding=unbound` and `deployable=false`; parsing is not
+firmware authentication, freshness verification or safety approval.
diff --git a/tools/p5/build_candidate.py b/tools/p5/build_candidate.py
new file mode 100644
index 0000000..5a78a2b
--- /dev/null
+++ b/tools/p5/build_candidate.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""Build application-only ARM candidates. No bootstub, device I/O or downloads.
+
+Both policy modes use the PUBLIC DEVELOPMENT key for offline format validation.
+Neither output is a release-signed or deployable firmware.
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def sha(p):
+  return hashlib.sha256(p.read_bytes()).hexdigest()
+
+
+def main():
+  p = argparse.ArgumentParser(description=__doc__)
+  p.add_argument('--source', type=Path, required=True)
+  p.add_argument('--opendbc', type=Path, required=True)
+  p.add_argument('--arm-prefix', type=Path, required=True, help='directory containing arm-none-eabi-gcc wrappers')
+  p.add_argument('--output', type=Path, required=True)
+  p.add_argument('--target', choices=['f4', 'h7'], required=True)
+  p.add_argument('--policy', choices=['debug', 'release'], required=True)
+  a = p.parse_args()
+  src, dbc, out, prefix = [v.resolve() for v in (a.source, a.opendbc, a.output, a.arm_prefix)]
+  if out.exists() and any(out.iterdir()):
+    raise ValueError("output directory must be empty; stale headers are forbidden")
+  out.mkdir(parents=True, exist_ok=True)
+  assert not (src / 'board/obj/gitversion.h').exists(), 'source must not contain generated version override'
+  assert not (out / 'main.elf').exists(), 'use a fresh output directory'
+  gcc, objcopy = [str(prefix / ('arm-none-eabi-' + n)) for n in ('gcc', 'objcopy')]
+  health, can = src / 'board/health.h', dbc / 'opendbc/safety/can.h'
+  hashes = {str(p.relative_to(src if p.is_relative_to(src) else dbc)): sha(p) for p in (health, can)}
+  defines = [f'-D{name}=0x{int.from_bytes(hashlib.sha256(path.read_bytes().replace(bytes([13]), b"")).digest()[:4], "little"):08x}U'
+             for name, path in [('HEALTH_PACKET_VERSION', health), ('CAN_PACKET_VERSION_HASH', can)]]
+  # Content-derived version: stable in a clean archive and excludes generated files.
+  inputs = {str(p.relative_to(src)): sha(p) for p in sorted((src / 'board').rglob('*')) if p.is_file() and 'obj' not in p.relative_to(src).parts}
+  safety_inputs = {str(p.relative_to(dbc)): sha(p) for p in sorted((dbc / 'opendbc/safety').rglob('*.h'))}
+  identity = hashlib.sha256(json.dumps({'board': inputs, 'safety': safety_inputs}, sort_keys=True).encode()).hexdigest()
+  version = f'P5-{a.target}-{identity[:12]}-{a.policy}'
+  gen = out / 'board/obj'
+  gen.mkdir(parents=True)
+  (gen / 'gitversion.h').write_text(f'#pragma once\nextern const uint8_t gitversion[{len(version)+1}];\n' +
+                                  f'const uint8_t gitversion[{len(version)+1}] = "{version}";\n')
+  family = 'stm32f4' if a.target == 'f4' else 'stm32h7'
+  startup = 'startup_stm32f413xx.s' if a.target == 'f4' else 'startup_stm32h7x5xx.s'
+  linker = 'stm32f4_flash.ld' if a.target == 'f4' else 'stm32h7x5_flash.ld'
+  flags = ['-Wall', '-Wextra', '-Wstrict-prototypes', '-Werror', '-mlittle-endian', '-mthumb', '-nostdlib',
+           '-fno-builtin', '-std=gnu11', '-fsingle-precision-constant', '-Os', '-g', '-mfloat-abi=hard']
+  flags += (['-mcpu=cortex-m4', '-mfpu=fpv4-sp-d16', '-DSTM32F4', '-DSTM32F413xx',
+             '-DSONGPLUS_DOS_REFERENCE_CANDIDATE'] if a.target == 'f4' else ['-mcpu=cortex-m7', '-mfpu=fpv5-d16', '-DSTM32H7', '-DSTM32H725xx'])
+  if a.policy == 'debug':
+    flags += ['-DALLOW_DEBUG']
+  flags += defines + ['-I' + str(out), '-I' + str(src), '-I' + str(src / 'board' / family / 'inc'), '-I' + str(dbc),
+                      f'-ffile-prefix-map={src}=panda', f'-ffile-prefix-map={dbc}=opendbc', f'-ffile-prefix-map={out}=build']
+  commands = []
+  def run(cmd, env=None):
+    commands.append(cmd)
