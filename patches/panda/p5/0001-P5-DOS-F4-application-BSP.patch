diff --git a/board/stm32f4/stm32f4_flash.ld b/board/stm32f4/stm32f4_flash.ld
new file mode 100644
index 0000000..17872ef
--- /dev/null
+++ b/board/stm32f4/stm32f4_flash.ld
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright (c) 2026 Song PLUS independent port contributors.
+ * Newly authored candidate application layout. The historical Atollic linker
+ * file is deliberately not redistributed or used. This is NOT a bootstub or
+ * verified recovery layout for the physical C3XL.
+ *
+ * F413xG: 1 MiB flash, 256 KiB SRAM1 + 64 KiB SRAM2 (ST DS11581 Rev7).
+ * Reserve sector0 [08000000,08004000), and 136 bytes for VERS+RSA1024 tail.
+ * Static data and the 8 KiB stack use only the bottom 128 KiB, preserving
+ * historical enter_bootloader_mode at 2001fffc and new fault_cookie at 2001fff8.
+ * Remaining 192 KiB of silicon RAM is deliberately not an allocator region.
+ */
+ENTRY(Reset_Handler)
+_app_start = 0x08004000;
+_image_limit = 0x08100000 - 136;
+enter_bootloader_mode = 0x2001fffc;
+fault_cookie = 0x2001fff8;
+_estack = 0x2001fff8;
+_Min_Heap_Size = 0;
+_Min_Stack_Size = 8192;
+_stack_bottom = _estack - _Min_Stack_Size;
+MEMORY {
+  APP (rx) : ORIGIN = 0x08004000, LENGTH = 1024K - 16K - 136
+  RAM (rw) : ORIGIN = 0x20000000, LENGTH = 128K - 8 - 8192
+  STACK (rw) : ORIGIN = 0x2001dff8, LENGTH = 8192
+  COOKIES (rw) : ORIGIN = 0x2001fff8, LENGTH = 8
+}
+SECTIONS {
+  .isr_vector : { KEEP(*(.isr_vector)) } > APP
+  .text : {
+    *(.text .text.*) *(.rodata .rodata.*)
+    *(.glue_7 .glue_7t) KEEP(*(.init)) KEEP(*(.fini))
+    . = ALIGN(4); _etext = .;
+  } > APP
+  .ARM.extab : { *(.ARM.extab* .gnu.linkonce.armextab.*) } > APP
+  .ARM.exidx : { __exidx_start = .; *(.ARM.exidx*) __exidx_end = .; } > APP
+  .data : {
+    . = ALIGN(4); _sdata = .; *(.data .data.*) . = ALIGN(4); _edata = .;
+  } > RAM AT > APP
+  _sidata = LOADADDR(.data);
+  _image_end = LOADADDR(.data) + SIZEOF(.data);
+  .bss (NOLOAD) : {
+    . = ALIGN(4); _sbss = .; *(.bss .bss.*) *(COMMON) . = ALIGN(4); _ebss = .;
+  } > RAM
+  .stack (NOLOAD) : { _stack_reserved_start = .; . += _Min_Stack_Size; } > STACK
+  .cookies (NOLOAD) : { . += 8; } > COOKIES
+  .ARM.attributes 0 : { *(.ARM.attributes) }
+  /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
+}
+ASSERT(ADDR(.isr_vector) == _app_start, "application vector placement changed")
+ASSERT((_estack & 7) == 0, "stack must be 8-byte aligned")
+ASSERT(_ebss <= _stack_bottom, "static RAM overlaps reserved stack")
+ASSERT(_image_end <= _image_limit, "application overlaps signature tail")
+ASSERT(fault_cookie + 4 == enter_bootloader_mode, "cookie layout changed")
