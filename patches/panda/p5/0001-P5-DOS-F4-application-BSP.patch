@@ -0,0 +1,161 @@
+// Actual H7 fdcan.h with RX FIFO ACK and host-width address HAL substitutions.
+// Message RAM is a static host array. No MMIO/device descriptor is opened.
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define ALLOW_DEBUG
+#define ENTER_CRITICAL() do {} while (0)
+#define EXIT_CRITICAL() do {} while (0)
+#include "board/utils.h"
+#include "board/config.h"
+#include "board/drivers/drivers.h"
+#include "board/sys/faults.h"
+static uint32_t now_us;
+uint32_t microsecond_timer_get(void) { return now_us; }
+#include "opendbc/safety/safety.h"
+void print(const char *s) { (void)s; }
+void puth(unsigned int n) { (void)n; }
+static unsigned int refreshed;
+void refresh_can_tx_slots_available(void) { refreshed++; }
+#include "board/drivers/can_common.h"
+typedef struct { uint32_t PSR,ECR,IR,TXFQS,TXBAR,RXF0S,RXF0A; } FDCAN_GlobalTypeDef;
+static FDCAN_GlobalTypeDef mock_can[3];
+#define FDCAN1 (&mock_can[0])
+#define FDCAN2 (&mock_can[1])
+#define FDCAN3 (&mock_can[2])
+enum { FDCAN1_IT0_IRQn, FDCAN1_IT1_IRQn, FDCAN2_IT0_IRQn, FDCAN2_IT1_IRQn, FDCAN3_IT0_IRQn, FDCAN3_IT1_IRQn };
+#include "fdcan_register_constants.inc"
+#include "board/stm32h7/llfdcan_declarations.h"
+static uint32_t fake_message_ram[(3U*FDCAN_OFFSET)/4U];
+#undef FDCAN_START_ADDRESS
+#define FDCAN_START_ADDRESS ((uintptr_t)fake_message_ram)
+typedef struct { uint32_t header[2]; uint32_t data_word[16]; } canfd_fifo;
+#define CAN_ACK_ERROR 3U
+#define CAN_INTERRUPT_RATE 12000U
+#define LED_BLUE 2U
+static unsigned int led_events, reset_calls[3], acks[3];
+static uint32_t observed_speed, observed_data_speed;
+static bool observed_loopback, observed_silent, observed_non_iso;
+bool llcan_set_speed(FDCAN_GlobalTypeDef *can,uint32_t speed,uint32_t data_speed,bool non_iso,bool loopback,bool silent) {
+  (void)can; observed_speed=speed; observed_data_speed=data_speed; observed_non_iso=non_iso; observed_loopback=loopback; observed_silent=silent; return true;
+}
+bool llcan_init(FDCAN_GlobalTypeDef *can) { (void)can; return true; }
+void llcan_clear_send(FDCAN_GlobalTypeDef *can) { reset_calls[can-mock_can]++; }
+static void led_set(uint8_t led,bool on) { if(led==LED_BLUE && on) led_events++; }
+static struct { void (*handler)(void); uint32_t call_rate; } interrupts[6];
+#define REGISTER_INTERRUPT(irq,fn,maxrate,fault) interrupts[irq].handler=fn;
+static void mock_rx_ack(FDCAN_GlobalTypeDef *can,uint32_t index) { can->RXF0A=index; can->RXF0S=0U; acks[can-mock_can]++; }
+#include "instrumented_fdcan.inc"
+static unsigned assertions,groups;
+#define CHECK(x) do {assertions++;if(!(x)){fprintf(stderr,"%s:%d: %s\n",__FILE__,__LINE__,#x);exit(1);}}while(0)
+#define GROUP(s) do {groups++;printf("PASS %s\n",s);}while(0)
+static canfd_fifo *tx(unsigned bus) {return (canfd_fifo *)(uintptr_t)(FDCAN_START_ADDRESS+bus*FDCAN_OFFSET+FDCAN_RX_FIFO_0_EL_CNT*FDCAN_RX_FIFO_0_EL_SIZE);}
+static canfd_fifo *rx(unsigned bus,unsigned index) {return (canfd_fifo *)(uintptr_t)(FDCAN_START_ADDRESS+bus*FDCAN_OFFSET+index*FDCAN_RX_FIFO_0_EL_SIZE);}
+static void reset(void) {
+  memset(mock_can,0,sizeof(mock_can));memset(can_health,0,sizeof(can_health));memset(acks,0,sizeof(acks));
+  memset(reset_calls,0,sizeof(reset_calls));memset(interrupts,0,sizeof(interrupts));
+  memset((void *)(uintptr_t)FDCAN_START_ADDRESS,0,3U*FDCAN_OFFSET);
+  can_clear(&can_rx_q);can_set_orientation(false);
+  for(unsigned i=0;i<3;i++){can_clear(can_queues[i]);bus_config[i].canfd_enabled=false;bus_config[i].canfd_auto=false;bus_config[i].brs_enabled=false;bus_config[i].canfd_non_iso=false;}
+  safety_tx_blocked=0U;safety_rx_invalid=0U;rx_buffer_overflow=0U;tx_buffer_overflow=0U;led_events=0U;refreshed=0U;
+  CHECK(set_safety_hooks(SAFETY_NOOUTPUT,0U)==0);
+}
+static CANPacket_t packet(unsigned bus,unsigned dlc,bool fd,bool ext) {
+  CANPacket_t p={0};p.bus=bus;p.addr=ext?0x1fffffffU:0x7ffU;p.data_len_code=dlc;p.fd=fd;p.extended=ext;
+  for(unsigned i=0;i<64;i++)p.data[i]=(uint8_t)(0x80U+i);
+  can_set_checksum(&p);return p;
+}
+static void receive(unsigned bus,unsigned dlc,bool fd,bool brs,bool ext,unsigned index,bool full) {
+  unsigned actual=full?(index+1U)%FDCAN_RX_FIFO_0_EL_CNT:index;
+  canfd_fifo *fifo=rx(bus,actual);
+  fifo->header[0]=ext?((1U<<30)|0x1abcdefU):(0x123U<<18);
+  fifo->header[1]=(dlc<<16)|(fd?1U<<21:0U)|(brs?1U<<20:0U);
+  for(unsigned i=0;i<16;i++)fifo->data_word[i]=0x83828180U+0x04040404U*i;
+  mock_can[bus].RXF0S=1U|(index<<FDCAN_RXF0S_F0GI_Pos)|(full?FDCAN_RXF0S_F0F:0U);
+  mock_can[bus].IR=0U;can_rx((uint8_t)bus);
+}
+int main(void) {
+  reset();CHECK(CAN_RX_BUFFER_SIZE==4096U && CAN_TX_BUFFER_SIZE==416U);CHECK(sizeof(CANPacket_t)==72U);
+  GROUP("fdcan_original_h7_queue_and_current_packet_sizes");
+  for(unsigned bus=0;bus<3;bus++)for(unsigned dlc=0;dlc<16;dlc++)for(unsigned fd=0;fd<2;fd++) {
+    reset();CHECK(set_safety_hooks(SAFETY_ALLOUTPUT,0U)==0);bus_config[bus].brs_enabled=fd!=0;
+    CANPacket_t p=packet(bus,dlc,fd!=0,dlc%2!=0);can_send(&p,(uint8_t)bus,false);
+    CHECK(can_health[bus].total_tx_cnt==1U && mock_can[bus].TXBAR==1U);
+    CHECK(tx(bus)->header[0]==((uint32_t)p.extended<<30|(p.extended?p.addr:(uint32_t)p.addr<<18)));
+    CHECK(tx(bus)->header[1]==(dlc<<16|(fd?1U<<21:0U)|(fd?1U<<20:0U)));
+    CHECK(memcmp(tx(bus)->data_word,p.data,GET_LEN(&p))==0);
+    CANPacket_t receipt;CHECK(can_pop(&can_rx_q,&receipt));CHECK(receipt.returned&&!receipt.rejected&&receipt.fd==fd&&receipt.bus==bus);
+    CHECK(receipt.data_len_code==dlc&&can_check_checksum(&receipt));
+  }
+  GROUP("fdcan_three_buses_all_dlc_fd_brs_and_returned_packets");
+  reset();CHECK(set_safety_hooks(SAFETY_ALLOUTPUT,0U)==0);bus_config[1].canfd_auto=true;
+  CANPacket_t p=packet(1U,8U,true,false);can_send(&p,1U,false);CHECK((tx(1)->header[1]&(1U<<21))==0U);
+  receive(1U,15U,true,true,true,0U,false);CHECK(bus_config[1].canfd_enabled&&bus_config[1].brs_enabled);
+  p=packet(1U,8U,false,false);can_send(&p,1U,false);CHECK((tx(1)->header[1]&(3U<<20))==(3U<<20));
+  GROUP("fdcan_auto_mode_and_observed_fd_brs_enable_preserved");
+  for(unsigned bus=0;bus<3;bus++)for(unsigned dlc=0;dlc<16;dlc++) {
+    reset();receive(bus,dlc,dlc>8,dlc>8,dlc%2,3U,false);
+    CANPacket_t got;CHECK(can_pop(&can_rx_q,&got));CHECK(got.bus==bus&&got.data_len_code==dlc&&got.fd==(dlc>8));
+    CHECK(got.addr==(dlc%2?0x1abcdefU:0x123U));CHECK(got.extended==(dlc%2));
+    CHECK(!got.returned&&!got.rejected&&can_check_checksum(&got));CHECK(got.data[0]==0x80U||dlc==0);
+    CHECK(can_health[bus].total_rx_cnt==1U&&acks[bus]==1U&&mock_can[bus].RXF0A==3U);
+  }
+  GROUP("fdcan_rx_all_dlc_addresses_local_buses_and_checksum");
+  reset();receive(2U,15U,true,true,true,45U,true);CHECK(mock_can[2].RXF0A==0U&&can_health[2].total_rx_lost_cnt==1U);
+  CANPacket_t got;CHECK(can_pop(&can_rx_q,&got));CHECK(got.data_len_code==15U&&got.fd&&got.addr==0x1abcdefU);
+  GROUP("fdcan_full_fifo_overwrite_advances_and_wraps_read_index");
+  reset();p=packet(0U,15U,true,false);can_send(&p,0U,false);CHECK(safety_tx_blocked==1U&&mock_can[0].TXBAR==0U);
+  CHECK(can_pop(&can_rx_q,&got));CHECK(got.rejected&&can_check_checksum(&got));
+  receive(0U,15U,true,true,false,0U,false);CHECK(can_health[0].total_fwd_cnt==0U&&mock_can[2].TXBAR==0U);
+  GROUP("fdcan_real_nooutput_denies_fd_tx_and_forwarding");
+  reset();CHECK(set_safety_hooks(SAFETY_ALLOUTPUT,1U)==0);
+  receive(0U,15U,true,true,true,0U,false);CHECK(can_health[0].total_fwd_cnt==1U&&can_health[2].total_tx_cnt==1U);
+  CHECK(tx(2)->header[1]==((15U<<16)|(1U<<21)));CHECK(tx(2)->data_word[15]==0xbfbebdbcU);
+  receive(2U,8U,false,false,false,0U,false);CHECK(can_health[2].total_fwd_cnt==1U&&can_health[0].total_tx_cnt==1U);
+  GROUP("fdcan_actual_safety_forwarding_preserves_full64_payload");
+  reset();CHECK(set_safety_hooks(SAFETY_ALLOUTPUT,0U)==0);mock_can[0].TXFQS=FDCAN_TXFQS_TFQF;
+  p=packet(0U,15U,true,false);for(unsigned i=0;i<416;i++)can_send(&p,0U,false);
+  CHECK(tx_buffer_overflow==1U&&can_slots_empty(&can_tx1_q)==0U&&mock_can[0].TXBAR==0U);
+  mock_can[0].TXFQS=0U;process_can(0U);CHECK(can_slots_empty(&can_tx1_q)==1U&&can_health[0].total_tx_cnt==1U);
+  CHECK(can_slots_empty(&can_tx2_q)==415U&&can_slots_empty(&can_tx3_q)==415U);
+  GROUP("fdcan_full_fifo_tx_backpressure_and_queue_isolation");
+  reset();p=packet(0U,15U,true,false);for(unsigned i=0;i<4095;i++)CHECK(can_push(&can_rx_q,&p));
+  receive(1U,15U,true,true,false,0U,false);CHECK(rx_buffer_overflow==1U&&acks[1]==1U);
+  GROUP("fdcan_rx_queue_overflow_still_acknowledges_fifo");
+  reset();can_ring *rings[]={&can_rx_q,&can_tx1_q};
+  for(unsigned r=0U;r<2U;r++) {
+    can_ring *ring=rings[r];unsigned count=ring->fifo_size-1U,cut=count*3U/4U;
+    for(unsigned i=0U;i<count;i++){p=packet(0U,8U,false,true);p.addr=i;can_set_checksum(&p);CHECK(can_push(ring,&p));}
+    for(unsigned i=0U;i<cut;i++){CHECK(can_pop(ring,&got));CHECK(got.addr==i&&can_check_checksum(&got));}
+    for(unsigned i=0U;i<cut;i++){p=packet(0U,8U,false,true);p.addr=count+i;can_set_checksum(&p);CHECK(can_push(ring,&p));}
+    CHECK(can_slots_empty(ring)==0U);
+    for(unsigned i=cut;i<count+cut;i++){CHECK(can_pop(ring,&got));CHECK(got.addr==i&&can_check_checksum(&got));}
+    CHECK(can_slots_empty(ring)==count&&!can_pop(ring,&got));
+  }
+  GROUP("fdcan_actual_large_rx_tx_queue_wrap_preserves_order");
+  reset();p=packet(0U,15U,true,false);p.data[0]^=1U;CHECK(can_push(&can_tx1_q,&p));process_can(0U);
+  CHECK(can_health[0].total_tx_checksum_error_cnt==1U&&mock_can[0].TXBAR==0U&&can_health[0].total_tx_cnt==0U);
+  GROUP("fdcan_mailbox_checksum_defense_preserved");
+  reset();mock_can[1].PSR=FDCAN_PSR_BO|FDCAN_PSR_EW|FDCAN_PSR_EP|(3U<<FDCAN_PSR_LEC_Pos)|(6U<<FDCAN_PSR_DLEC_Pos);
+  mock_can[1].ECR=(200U<<FDCAN_ECR_TEC_Pos)|(100U<<FDCAN_ECR_REC_Pos);
+  interrupts[FDCAN2_IT0_IRQn].call_rate=123U;interrupts[FDCAN2_IT1_IRQn].call_rate=456U;now_us=100001U;
+  update_can_health_pkt(1U,FDCAN_IR_BO|FDCAN_IR_RF0L);CHECK(can_health[1].bus_off&&can_health[1].error_warning&&can_health[1].error_passive);
+  CHECK(can_health[1].last_stored_error==3U&&can_health[1].last_data_stored_error==6U);
+  CHECK(can_health[1].receive_error_cnt==100U&&can_health[1].transmit_error_cnt==200U);
+  CHECK(can_health[1].total_error_cnt==1U&&can_health[1].total_rx_lost_cnt==1U&&can_health[1].total_tx_lost_cnt==1U);
+  CHECK(can_health[1].can_core_reset_cnt==1U&&reset_calls[1]==1U);CHECK(can_health[1].irq0_call_rate==123U&&can_health[1].irq1_call_rate==456U);
+  now_us=200001U;update_can_health_pkt(1U,FDCAN_IR_BO);CHECK(reset_calls[1]==1U);
+  now_us=200002U;update_can_health_pkt(1U,FDCAN_IR_BO);CHECK(reset_calls[1]==2U);
+  GROUP("fdcan_error_counters_and_reset_rate_boundary_preserved");
+  reset();now_us=400003U;mock_can[0].PSR=3U<<FDCAN_PSR_LEC_Pos;mock_can[0].ECR=127U<<FDCAN_ECR_TEC_Pos;
+  update_can_health_pkt(0U,FDCAN_IR_PEA);CHECK(reset_calls[0]==0U);
+  mock_can[0].ECR=128U<<FDCAN_ECR_TEC_Pos;update_can_health_pkt(0U,FDCAN_IR_PEA);CHECK(reset_calls[0]==1U);
+  GROUP("fdcan_ack_error_reset_requires_tec_over127");
+  reset();can_set_orientation(true);CHECK(set_safety_hooks(SAFETY_ALLOUTPUT,0U)==0);
+  p=packet(0U,15U,true,false);can_send(&p,0U,false);CHECK(can_health[2].total_tx_cnt==1U&&mock_can[0].TXBAR==0U);
+  CHECK(can_pop(&can_rx_q,&got)&&got.bus==0U);receive(2U,8U,false,false,false,0U,false);CHECK(can_pop(&can_rx_q,&got)&&got.bus==0U);
+  GROUP("fdcan_orientation_keeps_protocol_local_bus_mapping");
+  printf("SUMMARY groups=%u assertions=%u failed=0 skipped=0\n",groups,assertions);return 0;
+}
diff --git a/tests/p5/test_firmware_liveness.c b/tests/p5/test_firmware_liveness.c
new file mode 100644
index 0000000..da9614e
--- /dev/null
+++ b/tests/p5/test_firmware_liveness.c
@@ -0,0 +1,246 @@
+// Host oracle for the actual pinned firmware C. Source extraction is performed
+// by run_firmware_liveness.py; no copied candidate liveness model is used here.
+// HAL calls below only record intent. In particular set_safety_hooks accepts
+// and records a mode, without pretending to exercise MCU CAN safety hooks.
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "firmware_liveness_constants.h"
+
+static unsigned assertions;
+#define CHECK(x) do { ++assertions; if (!(x)) { \
+  fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #x); exit(1); } } while (0)
+
+enum { HARNESS_STATUS_NC = 0, HARNESS_STATUS_FLIPPED = 2, CAN_MODE_NORMAL = 0,
+       CAN_MODE_OBD_CAN2 = 1, LED_GREEN = 1, LED_BLUE = 2 };
+#define CANIF_FROM_CAN_NUM(x) (x)
+struct fake_timer { uint32_t SR; };
+static struct fake_timer fake_timer;
+#define TICK_TIMER (&fake_timer)
+struct fake_request { uint8_t request; uint16_t param1; };
+static struct { uint8_t status; } harness;
+
+static uint32_t heartbeat_counter, heartbeat_tick_counter, heartbeat_engaged_mismatches;
+static bool heartbeat_lost, heartbeat_disabled, heartbeat_engaged;
+static bool controls_allowed, siren_enabled, relay_malfunction, power_save_enabled;
+static bool ignition_can, can_silent;
+static uint32_t uptime_cnt, safety_mode_cnt, ignition_can_cnt;
+static uint16_t current_safety_mode, current_safety_param;
+static uint32_t safety_tx_blocked, safety_rx_invalid;
+static uint32_t now_us;
+static bool ignition_line, som_gpio;
+static unsigned safety_calls, power_calls, ir_calls, fan_calls, can_init_calls, safety_tick_calls;
+static uint16_t last_mode, last_param;
+static uint32_t last_ir, last_fan;
+
+static void print(const char *text) { (void)text; }
+static void puth(uint32_t value) { (void)value; }
+static uint32_t microsecond_timer_get(void) { return now_us; }
+static uint32_t voltage(void) { return 12000U; }
+static void siren(bool enabled) { (void)enabled; }
+static void can_mode(unsigned mode) { (void)mode; }
+static void ir(uint32_t power) { ++ir_calls; last_ir = power; }
+static bool som(void) { return som_gpio; }
+static struct {
+  uint32_t (*read_voltage_mV)(void);
+  void (*set_siren)(bool);
+  void (*set_can_mode)(unsigned);
+  void (*set_ir_power)(uint32_t);
+  bool (*read_som_gpio)(void);
+} board = {voltage, siren, can_mode, ir, som};
+#define current_board (&board)
+
+static int set_safety_hooks(uint16_t mode, uint16_t param) {
+  ++safety_calls; last_mode = mode; last_param = param;
+  current_safety_mode = mode; current_safety_param = param;
+  return 0;
+}
+static void assert_fatal(bool condition, const char *message) { (void)message; CHECK(condition); }
+static void set_intercept_relay(bool intercept, bool ignition) { (void)intercept; (void)ignition; }
+static void can_clear_send(unsigned interface, unsigned bus) { (void)interface; (void)bus; }
+static void can_init_all(void) { ++can_init_calls; }
+static void set_power_save_state(bool enabled) { ++power_calls; power_save_enabled = enabled; }
+static void fan_tick(void) {}
+static void harness_tick(void) {}
+static void sound_tick(void) {}
+static void can_set_orientation(bool flipped) { (void)flipped; }
+static void led_set(unsigned led, bool enabled) { (void)led; (void)enabled; }
+static bool harness_check_ignition(void) { return ignition_line; }
+static void bootkick_tick(bool started, bool recent_heartbeat) { (void)started; (void)recent_heartbeat; }
+static void fan_set_power(uint32_t power) { ++fan_calls; last_fan = power; }
+static void check_registers(void) {}
+static void safety_tick(void) { ++safety_tick_calls; }
+
+#include "firmware_liveness_source.h"
+
+static void init(bool started) {
+  current_safety_mode = SAFETY_TOYOTA;  // Arbitrary pinned car-mode predicate fixture, not a vehicle claim.
+  current_safety_param = 123U;
+  ignition_line = started;
+  heartbeat_engaged = true;
+  initialize_heartbeat_watchdog();
+  CHECK(wd_state.threshold == 375000U);
+  CHECK(wd_state.fault == FAULT_HEARTBEAT_LOOP_WATCHDOG);
+  CHECK(HEARTBEAT_IGNITION_CNT_ON == 5U);
+  CHECK(HEARTBEAT_IGNITION_CNT_OFF == 2U);
+}
+
+static void control(uint8_t request, uint16_t param) {
+  const struct fake_request req = {request, param};
+  heartbeat_control(&req);
+}
+
+static void second(void) {
+  // The untouched handler decimates eight 125 ms fake ticks to one counter step.
+  for (unsigned i = 0; i < 8U; ++i) {
+    now_us += 125000U;
+    TICK_TIMER->SR = 1U;
+    tick_handler();
+    CHECK(TICK_TIMER->SR == 0U);
+  }
+}
+
+static void heartbeat_write_exact_semantics(void) {
+  init(true);
+  const uint16_t params[] = {0U, 1U, 2U, UINT16_MAX};
+  for (unsigned i = 0; i < sizeof(params) / sizeof(params[0]); ++i) {
+    heartbeat_counter = UINT32_MAX; heartbeat_tick_counter = UINT32_MAX;
+    heartbeat_lost = true; heartbeat_disabled = true; controls_allowed = true;
+    control(0xf3U, params[i]);
+    CHECK(heartbeat_counter == 0U && heartbeat_tick_counter == 0U);
+    CHECK(!heartbeat_lost && !heartbeat_disabled);
+    CHECK(heartbeat_engaged == (params[i] == 1U));
+    CHECK(controls_allowed && safety_calls == 0U && fan_calls == 0U && ir_calls == 0U);
+  }
+  puts("TRACE heartbeat 0xf3 resets counters/lost/disabled; engaged iff param1==1; does not itself set SILENT or clear controls_allowed");
+}
+
+static void boundary(bool started) {
+  init(started);
+  const uint32_t limit = started ? 5U : 2U;
+  heartbeat_counter = limit - 2U;
+  second(); CHECK(heartbeat_counter == limit - 1U); CHECK(safety_calls == 0U);
+  second(); CHECK(heartbeat_counter == limit); CHECK(safety_calls == 1U);
+  CHECK(last_mode == SAFETY_SILENT && last_param == 0U && can_silent);
+  CHECK(heartbeat_lost && !heartbeat_engaged && power_save_enabled);
+  CHECK(can_init_calls == 1U && safety_tick_calls == 2U);
+  second(); CHECK(heartbeat_counter == limit + 1U); CHECK(safety_calls == 1U);
+  printf("TRACE ignition=%s counter=%u/%u/%u SILENT_calls=0/1/1\n", started ? "on" : "off", limit - 1U, limit, limit + 1U);
+}
+
+static void heartbeat_saturates_and_repeated_timeout(void) {
+  init(true); heartbeat_counter = UINT32_MAX;
+  second(); CHECK(heartbeat_counter == UINT32_MAX && safety_calls == 1U);
+  second(); CHECK(heartbeat_counter == UINT32_MAX && safety_calls == 1U);
+  CHECK(heartbeat_lost && power_calls == 1U && ir_calls == 2U && fan_calls == 2U);
+}
+
+static void engaged_false_third_mismatch(void) {
+  init(true); controls_allowed = true;
+  for (unsigned i = 1; i <= 3; ++i) {
+    control(0xf3U, 0U);
+    CHECK(controls_allowed);  // Receiving engaged=false is not an immediate exit.
+    second();
+    CHECK(heartbeat_engaged_mismatches == i);
+    CHECK(controls_allowed == (i < 3U));
+    CHECK(safety_calls == 0U && current_safety_mode == SAFETY_TOYOTA);
+  }
+  puts("TRACE heartbeat engaged=false mismatch_count=1/2/3 controls_allowed=true/true/false; safety mode unchanged");
+}
+
+static void engaged_mismatch_reset(void) {
+  init(true); controls_allowed = true;
+  for (unsigned i = 0; i < 2; ++i) { control(0xf3U, 0U); second(); }
+  CHECK(heartbeat_engaged_mismatches == 2U && controls_allowed);
+  control(0xf3U, 1U); second(); CHECK(heartbeat_engaged_mismatches == 0U && controls_allowed);
+  control(0xf3U, 0U); second(); CHECK(heartbeat_engaged_mismatches == 1U && controls_allowed);
+  controls_allowed = false; second(); CHECK(heartbeat_engaged_mismatches == 0U);
+}
+
+static void car_mode_cannot_disable_heartbeat(void) {
+  init(true); control(0xf8U, 0U); CHECK(!heartbeat_disabled);
+  heartbeat_disabled = true; heartbeat_counter = 4U;
+  second(); CHECK(!heartbeat_disabled && current_safety_mode == SAFETY_SILENT && heartbeat_lost);
+}
+
+static void nooutput_disabled_and_lost_flag(void) {
+  init(false); current_safety_mode = SAFETY_NOOUTPUT;
+  control(0xf8U, 0U); CHECK(heartbeat_disabled);
+  heartbeat_counter = 2U; second();
+  CHECK(current_safety_mode == SAFETY_NOOUTPUT && !heartbeat_lost && safety_calls == 0U);
+  control(0xf3U, 0U); CHECK(!heartbeat_disabled && heartbeat_counter == 0U);
+  second(); CHECK(safety_calls == 0U);
+  second(); CHECK(safety_calls == 1U && current_safety_mode == SAFETY_SILENT && !heartbeat_lost);
+  puts("TRACE noOutput expiry still enters SILENT, but heartbeat_lost only records a lost car-safety session");
+}
+
+static void timeout_peripheral_intents(void) {
+  init(true); heartbeat_counter = 4U; som_gpio = true;
+  second(); CHECK(ir_calls == 1U && last_ir == 0U && fan_calls == 1U && last_fan == 30U);
+  som_gpio = false;
+  second(); CHECK(ir_calls == 2U && last_ir == 0U && fan_calls == 2U && last_fan == 0U);
+  CHECK(power_save_enabled);
+  puts("TRACE timeout upstream HAL intent IR=0; fan=30 iff SOM GPIO high else 0; physical cooling untested");
+}
+
+static void watchdog_boundary(bool wrap) {
+  init(true);
+  const uint32_t base = wrap ? UINT32_MAX - 100U : 100U;
+  const uint32_t elapsed[] = {374999U, 375000U, 375001U};
+  for (unsigned i = 0; i < 3U; ++i) {
+    faults = 0U; fault_status = FAULT_STATUS_NONE;
+    now_us = base; initialize_heartbeat_watchdog();
+    now_us = base + elapsed[i]; simple_watchdog_kick();
+    CHECK(wd_state.last_ts == now_us);
+    CHECK((faults & FAULT_HEARTBEAT_LOOP_WATCHDOG) == (i == 2U ? FAULT_HEARTBEAT_LOOP_WATCHDOG : 0U));
+    CHECK(fault_status == (i == 2U ? FAULT_STATUS_TEMPORARY : FAULT_STATUS_NONE));
+    CHECK(safety_calls == 0U && current_safety_mode == SAFETY_TOYOTA);
+    CHECK(heartbeat_engaged && !heartbeat_lost && !power_save_enabled);
+    CHECK(fan_calls == 0U && ir_calls == 0U);
+  }
+  now_us += 125000U; simple_watchdog_kick();
+  CHECK((faults & FAULT_HEARTBEAT_LOOP_WATCHDOG) != 0U);  // Fault persists; timely kicks do not recover it.
+  printf("TRACE software_watchdog%s elapsed_us=374999/375000/375001 fault=false/false/true SILENT_calls=0\n", wrap ? "_uint32_wrap" : "");
+}
+
+static void watchdog_stall_only_observed_on_resume(void) {
+  init(true); now_us = 1000000U;
+  CHECK(faults == 0U && safety_calls == 0U);  // No interrupt/kick executed while stalled.
+  simple_watchdog_kick();
+  CHECK((faults & FAULT_HEARTBEAT_LOOP_WATCHDOG) != 0U && safety_calls == 0U);
+  CHECK(heartbeat_counter == 0U && !heartbeat_lost);
+  puts("TRACE halted tick loop produces no autonomous software-watchdog action; subsequent kick records late-loop fault only");
+}
+
+static void watchdog_fault_does_not_prevent_later_heartbeat_timeout(void) {
+  init(true); now_us = 375001U; simple_watchdog_kick();
+  CHECK(faults == FAULT_HEARTBEAT_LOOP_WATCHDOG && safety_calls == 0U);
+  heartbeat_counter = 4U; second();
+  CHECK(faults == FAULT_HEARTBEAT_LOOP_WATCHDOG && safety_calls == 1U);
+  CHECK(current_safety_mode == SAFETY_SILENT && heartbeat_lost);
+  puts("TRACE late kick first records watchdog fault without SILENT; independent later heartbeat counter expiry requests SILENT");
+}
+
+int main(int argc, char **argv) {
+  if (argc != 2) return 2;
+  const char *name = argv[1];
+  if (!strcmp(name, "heartbeat_write_exact_semantics")) heartbeat_write_exact_semantics();
+  else if (!strcmp(name, "ignition_on_counter_boundary")) boundary(true);
+  else if (!strcmp(name, "ignition_off_counter_boundary")) boundary(false);
+  else if (!strcmp(name, "heartbeat_saturates_and_repeated_timeout")) heartbeat_saturates_and_repeated_timeout();
+  else if (!strcmp(name, "engaged_false_third_mismatch")) engaged_false_third_mismatch();
+  else if (!strcmp(name, "engaged_mismatch_reset")) engaged_mismatch_reset();
+  else if (!strcmp(name, "car_mode_cannot_disable_heartbeat")) car_mode_cannot_disable_heartbeat();
+  else if (!strcmp(name, "nooutput_disabled_and_lost_flag")) nooutput_disabled_and_lost_flag();
+  else if (!strcmp(name, "timeout_peripheral_intents")) timeout_peripheral_intents();
+  else if (!strcmp(name, "watchdog_strict_threshold")) watchdog_boundary(false);
+  else if (!strcmp(name, "watchdog_timer_wrap")) watchdog_boundary(true);
+  else if (!strcmp(name, "watchdog_stall_only_observed_on_resume")) watchdog_stall_only_observed_on_resume();
+  else if (!strcmp(name, "watchdog_fault_does_not_prevent_later_heartbeat_timeout")) watchdog_fault_does_not_prevent_later_heartbeat_timeout();
+  else return 3;
+  printf("{\"case\":\"%s\",\"assertions\":%u,\"failed\":0,\"skipped\":0}\n", name, assertions);
+  return 0;
+}
diff --git a/tests/p5/test_llbxcan.c b/tests/p5/test_llbxcan.c
new file mode 100644
index 0000000..c434926
--- /dev/null
+++ b/tests/p5/test_llbxcan.c
@@ -0,0 +1,130 @@
+// The full production low-level bxCAN implementation, with STM32 register/NVIC
+// and register-write monitoring mocks. No physical clock or CAN bus is exercised.
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef struct { uint32_t FR1, FR2; } Filter;
+typedef struct {
+  uint32_t MCR, MSR, BTR, FMR, FA1R, FM1R, FS1R, FFA1R, IER, RF0R, TSR;
+  Filter sFilterRegister[28];
+} CAN_TypeDef;
+static CAN_TypeDef registers[3];
+#define CAN1 (&registers[0])
+#define CAN2 (&registers[1])
+#define CAN3 (&registers[2])
+enum { CAN1_TX_IRQn, CAN1_RX0_IRQn, CAN1_SCE_IRQn, CAN2_TX_IRQn, CAN2_RX0_IRQn, CAN2_SCE_IRQn, CAN3_TX_IRQn, CAN3_RX0_IRQn, CAN3_SCE_IRQn };
+#define CAN_INIT_TIMEOUT_MS 500U
+#define CAN_MCR_INRQ 1U
+#define CAN_MCR_TTCM (1U << 7)
+#define CAN_MCR_ABOM (1U << 6)
+#define CAN_MSR_INAK 1U
+#define CAN_MSR_ERRI (1U << 2)
+#define CAN_BTR_TS1_0 (1U << 16)
+#define CAN_BTR_TS2_0 (1U << 20)
+#define CAN_BTR_SJW_0 (1U << 24)
+#define CAN_BTR_SILM (1U << 31)
+#define CAN_BTR_LBKM (1U << 30)
+#define CAN_FMR_FINIT 1U
+#define CAN_FMR_CAN2SB (63U << 8)
+#define CAN_IER_TMEIE 1U
+#define CAN_IER_FMPIE0 (1U << 1)
+#define CAN_IER_FFIE0 (1U << 2)
+#define CAN_IER_FOVIE0 (1U << 3)
+#define CAN_IER_EWGIE (1U << 8)
+#define CAN_IER_EPVIE (1U << 9)
+#define CAN_IER_BOFIE (1U << 10)
+#define CAN_IER_LECIE (1U << 11)
+#define CAN_IER_ERRIE (1U << 15)
+#define CAN_RF0R_FOVR0 (1U << 4)
+#define CAN_RF0R_RFOM0 (1U << 5)
+#define CAN_TSR_RQCP0 1U
+#define CAN_TSR_ABRQ0 (1U << 7)
+static unsigned int writes, delays, enabled[9], disabled[9];
+static bool ack_enter, ack_exit;
+static void update_ack(void) {
+  for (unsigned int i = 0U; i < 3U; i++) {
+    if ((registers[i].MCR & CAN_MCR_INRQ) && ack_enter) registers[i].MSR |= CAN_MSR_INAK;
+    if (!(registers[i].MCR & CAN_MCR_INRQ) && ack_exit) registers[i].MSR &= ~CAN_MSR_INAK;
+  }
+}
+static void register_set(volatile uint32_t *addr, uint32_t value, uint32_t mask) {
+  (void)mask; writes++; *addr = value; update_ack();
+}
+static void register_set_bits(volatile uint32_t *addr, uint32_t value) { writes++; *addr |= value; update_ack(); }
+static void register_clear_bits(volatile uint32_t *addr, uint32_t value) { writes++; *addr &= ~value; update_ack(); }
+static void delay(unsigned int loops) { (void)loops; delays++; update_ack(); }
+void print(const char *text) { (void)text; }
+static void NVIC_EnableIRQ(unsigned int irq) { enabled[irq]++; }
+static void NVIC_DisableIRQ(unsigned int irq) { disabled[irq]++; }
+#include "board/stm32f4/llbxcan.h"
+
+static unsigned int assertions, groups;
+#define CHECK(condition) do { assertions++; if (!(condition)) { fprintf(stderr, "%s:%d: %s\n", __FILE__, __LINE__, #condition); exit(1); } } while (0)
+static void group(const char *name) { groups++; printf("PASS %s\n", name); }
+static void reset(void) {
+  memset(registers, 0, sizeof(registers)); memset(enabled, 0, sizeof(enabled)); memset(disabled, 0, sizeof(disabled));
+  writes = 0U; delays = 0U; ack_enter = true; ack_exit = true;
+}
+int main(void) {
+  reset();
+  for (unsigned int i = 0U; i < SPEEDS_ARRAY_SIZE; i++) {
+    CHECK(llcan_set_speed(CAN1, speeds[i], false, false));
+    uint32_t prescaler = (CAN1->BTR & 0x3ffU) + 1U;
+    CHECK(prescaler > 0U && prescaler <= 1024U); CHECK(CAN_PCLK * 10U / (CAN_QUANTA * prescaler) == speeds[i]);
+    CHECK((CAN1->BTR & (CAN_BTR_SILM | CAN_BTR_LBKM)) == 0U); CHECK((CAN1->MCR & CAN_MCR_ABOM) != 0U);
+    CHECK((CAN1->MSR & CAN_MSR_INAK) == 0U);
+  }
+  CHECK(DATA_SPEEDS_ARRAY_SIZE == 1U && data_speeds[0] == 0U); group("llbxcan_all_supported_rates_exact_timing");
+
+  reset(); const uint32_t invalid[] = {0U, 1U, 99U, 333U, 9999U, 20000U, UINT32_MAX};
+  for (unsigned int i = 0U; i < sizeof(invalid) / sizeof(invalid[0]); i++) {
+    CHECK(!llcan_set_speed(CAN1, invalid[i], false, false)); CHECK(writes == 0U && delays == 0U); CHECK(CAN1->BTR == 0U && CAN1->MCR == 0U);
+  }
+  group("llbxcan_invalid_rate_never_divides_or_mutates");
+
+  reset();
+  for (unsigned int i = 0U; i < 3U; i++) {
+    CHECK(llcan_set_speed(&registers[i], 5000U, false, true)); CHECK((registers[i].BTR & CAN_BTR_SILM) != 0U);
+    CHECK((registers[i].BTR & CAN_BTR_LBKM) == 0U);
+    CHECK(llcan_set_speed(&registers[i], 5000U, true, false)); CHECK((registers[i].BTR & (CAN_BTR_LBKM | CAN_BTR_SILM)) == (CAN_BTR_LBKM | CAN_BTR_SILM));
+  }
+  group("llbxcan_silent_and_internal_loopback_all_controllers");
+
+  reset(); ack_enter = false; CHECK(!llcan_set_speed(CAN1, 5000U, false, true));
+  CHECK(delays == 500U); CHECK(CAN1->BTR == 0U); CHECK(CAN1->MCR & CAN_MCR_INRQ);
+  group("llbxcan_enter_init_timeout_bounded");
+
+  reset(); ack_exit = false; CHECK(!llcan_set_speed(CAN2, 5000U, false, true));
+  CHECK(delays == 500U); CHECK(CAN2->MSR & CAN_MSR_INAK); CHECK(CAN2->BTR & CAN_BTR_SILM);
+  group("llbxcan_exit_init_timeout_bounded");
+
+  reset(); CHECK(llcan_init(CAN1)); CHECK(CAN1->FA1R == 1U && CAN1->FS1R == 1U);
+  CHECK((CAN1->FMR & CAN_FMR_CAN2SB) == (14U << 8)); CHECK((CAN1->FMR & CAN_FMR_FINIT) == 0U);
+  CAN1->sFilterRegister[0].FR1 = 0x12345678U;
+  CHECK(llcan_init(CAN2)); CHECK(CAN1->FA1R == ((1U << 14) | 1U)); CHECK(CAN1->FS1R == ((1U << 14) | 1U));
+  CHECK(CAN1->sFilterRegister[0].FR1 == 0x12345678U); CHECK(CAN1->sFilterRegister[14].FR1 == 0U && CAN1->sFilterRegister[14].FR2 == 0U);
+  CHECK(CAN2->FA1R == 0U && CAN2->FMR == 0U); CHECK(CAN1->FFA1R == 0U && CAN1->FM1R == 0U);
+  CHECK(llcan_init(CAN3)); CHECK(CAN3->FA1R == 1U && CAN3->FS1R == 1U); CHECK(CAN3->FMR == 0U);
+  CHECK(CAN1->FA1R == ((1U << 14) | 1U)); group("llbxcan_can2_shared_filters_and_can3_isolation");
+
+  reset();
+  for (unsigned int i = 0U; i < 3U; i++) { CHECK(llcan_init(&registers[i])); llcan_irq_disable(&registers[i]); }
+  for (unsigned int i = 0U; i < 9U; i++) CHECK(enabled[i] == 1U && disabled[i] == 1U);
+  uint32_t irq_mask = CAN_IER_TMEIE | CAN_IER_FMPIE0 | CAN_IER_ERRIE | CAN_IER_LECIE | CAN_IER_BOFIE | CAN_IER_EPVIE | CAN_IER_EWGIE | CAN_IER_FOVIE0 | CAN_IER_FFIE0;
+  CHECK(CAN1->IER == irq_mask && CAN2->IER == irq_mask && CAN3->IER == irq_mask);
+  group("llbxcan_all_nine_irqs_and_error_sources");
+
+  reset(); ack_exit = false; CAN3->MSR = CAN_MSR_INAK; CHECK(!llcan_init(CAN3)); CHECK(delays == 500U);
+  CHECK(CAN3->IER == 0U && CAN3->FA1R == 0U); for (unsigned int i = 0U; i < 9U; i++) CHECK(enabled[i] == 0U);
+  group("llbxcan_stuck_init_does_not_enable_interrupts");
+
+  reset(); CAN1->RF0R = 0xffffffffU; llcan_release_rx(CAN1); CHECK(CAN1->RF0R == CAN_RF0R_RFOM0);
+  CAN1->RF0R = 0xffffffffU; llcan_clear_rx_overrun(CAN1); CHECK(CAN1->RF0R == CAN_RF0R_FOVR0);
+  CAN1->TSR = 0xffffffffU; llcan_clear_tx_status(CAN1); CHECK(CAN1->TSR == CAN_TSR_RQCP0);
