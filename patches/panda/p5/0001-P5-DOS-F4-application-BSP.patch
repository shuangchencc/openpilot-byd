@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Compile/run actual F4 driver and LL code with explicit host register HAL mocks."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+
+def run(command, **kwargs):
+  result = subprocess.run(command, capture_output=True, text=True, timeout=180, **kwargs)
+  if result.returncode:
+    raise RuntimeError(f"Command failed ({result.returncode}): {command}\n{result.stdout}\n{result.stderr}")
+  return result.stdout
+
+
+def main():
+  parser = argparse.ArgumentParser()
+  parser.add_argument("--source", type=Path, required=True)
+  parser.add_argument("--opendbc", type=Path, required=True)
+  parser.add_argument("--output", type=Path, required=True)
+  parser.add_argument("--compiler", default="clang")
+  args = parser.parse_args()
+  source = args.source.resolve()
+  args.output.mkdir(parents=True, exist_ok=True)
+  output = args.output.resolve()
+  reports = []
+  for name in ("bxcan", "llbxcan"):
+    binary = output / name
+    dependency_file = output / f"{name}.d"
+    command = [args.compiler, "-std=gnu11", "-Wall", "-Wextra", "-Werror", "-Wno-unused-function",
+               "-Wno-unused-parameter", "-fsanitize=address,undefined", "-fno-sanitize-recover=all", "-g",
+               "-I", str(source), "-I", str(source / "board"), "-I", str(args.opendbc.resolve()),
+               "-MMD", "-MF", str(dependency_file), str(source / f"tests/p5/test_{name}.c"), "-o", str(binary)]
+    run(command, cwd=source)
+    sanitizers = {"ASAN_OPTIONS": "detect_leaks=0" if sys.platform == "darwin" else "detect_leaks=1", "UBSAN_OPTIONS": "halt_on_error=1"}
+    stdout = run([str(binary)], env={**os.environ, **sanitizers})
+    (output / f"{name}.log").write_text(stdout)
+    match = re.search(r"SUMMARY groups=(\d+) assertions=(\d+) failed=0 skipped=0", stdout)
+    groups = re.findall(r"^PASS (\S+)$", stdout, re.MULTILINE)
+    if not match or int(match[1]) != len(groups) or len(set(groups)) != len(groups):
+      raise RuntimeError("Missing or duplicate acceptance groups")
+    dependencies = dependency_file.read_text().replace("\\\n", " ").split(":", 1)[1].split()
+    sources = [{"path": str(Path(path).resolve()), "sha256": hashlib.sha256(Path(path).read_bytes()).hexdigest()}
+               for path in sorted(set(dependencies))]
+    reports.append({"name": name, "groups": groups, "group_count": len(groups), "assertions": int(match[2]),
+                    "failed": 0, "skipped": 0, "command": command, "compiler_inputs": sources,
+                    "binary_sha256": hashlib.sha256(binary.read_bytes()).hexdigest()})
+  report = {"status": "PASS", "scope": "actual F4 driver and LL code; host HAL register mocks; no device or MCU execution",
+            "compiler": run([args.compiler, "--version"]).splitlines()[0], "suites": reports,
+            "groups": sum(r["group_count"] for r in reports), "assertions": sum(r["assertions"] for r in reports),
+            "failed": 0, "skipped": 0, "device_access": False}
+  (output / "result.json").write_text(json.dumps(report, indent=2) + "\n")
+  print(json.dumps({key: report[key] for key in ("status", "groups", "assertions", "failed", "skipped")}, sort_keys=True))
+
+
+if __name__ == "__main__":
+  main()
