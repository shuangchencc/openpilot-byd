diff --git a/openpilot/selfdrive/pandad/compatibility/native_binding.cc b/openpilot/selfdrive/pandad/compatibility/native_binding.cc
new file mode 100644
index 0000000..c8ef3d2
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_binding.cc
@@ -0,0 +1,187 @@
+#include "native_binding.h"
+#include <algorithm>
+
+namespace openpilot::pandad::compatibility {
+namespace {
+template <class T> std::string hex(const T &bytes) {
+  constexpr char chars[] = "0123456789abcdef";
+  std::string out;
+  for (auto byte : bytes) { out += chars[byte >> 4]; out += chars[byte & 15]; }
+  return out;
+}
+bool digest(const std::string &s) {
+  return s.size() == 64 && std::any_of(s.begin(),s.end(),[](char c){return c != '0';}) &&
+    std::all_of(s.begin(),s.end(),[](char c){return (c>='0' && c<='9') || (c>='a' && c<='f');});
+}
+bool printable(const std::string &s) {
+  return !s.empty() && s.size() <= 128 && std::all_of(s.begin(),s.end(),[](unsigned char c){return c>32 && c<127;});
+}
+bool same_raw(NativeUsbObservation a, NativeUsbObservation b) {
+  a.lease_nonce = b.lease_nonce = 0;
+  return a == b;
+}
+bool raw_valid(const NativeUsbObservation &r, const std::string &transport) {
+  const std::array<std::uint8_t,8> protocol{{0xf5,0x12,0xbc,0xff,0x76,0xf2,0xab,0x75}};
+  const std::vector<std::uint8_t> f4{'F','4','C','1',1,0,16,0,31,0,0,0,7,0,0,0};
+  const auto nonblank=[](const auto &a) {
+    return !std::all_of(a.begin(),a.end(),[](auto b){return b==0;}) && !std::all_of(a.begin(),a.end(),[](auto b){return b==255;});
+  };
+  return (transport == "USB" ? printable(r.serial) : transport == "SPI" && r.serial.empty()) &&
+    nonblank(r.uid) && nonblank(r.application_signature) && r.protocol == protocol &&
+    ((r.board_type == 6 && r.f4_capabilities == f4) || (r.board_type == 7 && r.f4_capabilities.empty()));
+}
+std::string nonce(const NativeObservedBoard &o) { return o.transport + ":" + std::to_string(o.raw.lease_nonce); }
+class ReadOnlyHandoff final : public Backend {
+public:
+  explicit ReadOnlyHandoff(std::unique_ptr<Backend> inner) : inner_(std::move(inner)) {}
+  Result transact(const Request &r, std::uint32_t budget) override {
+    if (!valid_request(r) || !budget || budget>kBackendSliceMs) return {Status::Invalid,0,{},true,false};
+    bool allowed=r.kind==Kind::BulkRead && r.endpoint==0x81;
+    if (r.kind==Kind::ControlRead && r.payload.empty()) {
+      const auto length=r.request==0xc1 ? 1U : r.request==0xc3 ? 12U : r.request==0xdd ? 8U :
+        (r.request==0xd3 || r.request==0xd4 || r.request==0xc2) ? 64U : r.request==0xd5 ? 16U : r.request==0xd2 ? 48U : r.request==0xb2 ? 2U : 0U;
+      allowed=(length && !r.index && r.read_length==length && (r.request==0xc2 ? r.value<3 : r.value==0));
+    }
+    if (!allowed || cancelled_) return {cancelled_ ? Status::Cancelled : Status::Invalid,0,{},true,false};
+    return inner_->transact(r,budget);
+  }
+  void cancel() noexcept override { cancelled_=true; inner_->cancel(); }
+private:
+  std::unique_ptr<Backend> inner_;
+  std::atomic<bool> cancelled_{false};
+};
+SessionIdentity identity(const NativeBoardBinding &b) {
+  return {"uid:"+hex(b.expected.uid), b.expected.board_type==6 ? "DOS":"RED_PANDA",
+    b.expected.board_type==6 ? "F4":"H7",b.exact_mcu,b.transport,kSessionProtocol,b.capabilities,hex(b.expected.application_signature)};
+}
+}  // namespace
+
+NativeBindingResult validate_native_binding(const NativeBindingProfile &p, const std::vector<NativeObservedBoard> &inventory,
+                                            const NativeEvidenceVerifier &verify) {
+  NativeBindingResult result;
+  result.profile.schema = kNativeSessionProfileSchema;
+  result.profile.purpose = "native_read_only_candidate";
+  const auto reject=[&](const char *reason) { result.reason=reason; return result; };
+  if (p.schema != "songplus-native-binding/v1" || p.device_access_enabled || p.can_tx_enabled || p.firmware_install_enabled)
+    return reject("INVALID_SCHEMA_OR_PERMISSION");
+  if (p.binding_status == "UNBOUND") {
+    const SessionCapabilities empty_caps;
+    for (std::size_t i=0;i<2;++i) {
+      const auto &b=p.slots[i];
+      if (b.slot!=i || !(b.expected==NativeUsbObservation{}) || b.expected.observed_us || !b.transport.empty() || !b.exact_mcu.empty() ||
+          !(b.capabilities==empty_caps) || !b.physical_evidence_sha256.empty() || !b.spi_selector.path.empty() ||
+          !b.spi_selector.identity_evidence_sha256.empty() || b.spi_selector.physical_identity_verified ||
+          b.spi_selector.expected_major || b.spi_selector.expected_minor || b.spi_selector.expected_mode ||
+          b.spi_selector.expected_bits_per_word || b.spi_selector.expected_max_speed_hz) return reject("PARTIAL_UNBOUND_PROFILE");
+    }
+    SessionProfile empty; empty.roles=p.roles;
+    try { const SessionRegistry checked(empty); (void)checked; }
+    catch (...) { return reject("PARTIAL_UNBOUND_ROLES"); }
+    return result;
+  }
+  if (p.binding_status != "CANDIDATE" || !verify) return reject("PHYSICAL_EVIDENCE_VERIFIER_REQUIRED");
+  if (inventory.size() != 2) return reject("COMPLETE_TWO_BOARD_INVENTORY_REQUIRED");
+  if (!inventory[0].raw.lease_nonce || !inventory[1].raw.lease_nonce ||
+      inventory[0].raw.lease_nonce == inventory[1].raw.lease_nonce || inventory[0].raw.uid == inventory[1].raw.uid)
+    return reject("DUPLICATE_OR_INVALID_LEASE_IDENTITY");
+  if (p.slots[0].expected.uid == p.slots[1].expected.uid) return reject("DUPLICATE_BOUND_UID");
+  if (inventory[0].transport == "USB" && inventory[1].transport == "USB" && inventory[0].raw.serial == inventory[1].raw.serial)
+    return reject("DUPLICATE_USB_SERIAL");
+  SessionProfile candidate = result.profile;
+  candidate.binding_status = "NATIVE_READ_ONLY_BOUND";
+  candidate.roles = p.roles;
+  for (std::size_t slot=0;slot<2;++slot) {
+    const auto &b=p.slots[slot];
+    if (b.slot != slot || b.expected.lease_nonce || b.expected.observed_us || !raw_valid(b.expected,b.transport)) return reject("INVALID_EXPECTED_IDENTITY");
+    if (!digest(b.physical_evidence_sha256) || !printable(b.exact_mcu) ||
+        (b.expected.board_type==6 ? b.exact_mcu.rfind("STM32F413",0)!=0 : b.exact_mcu.rfind("STM32H7",0)!=0))
+      return reject("EXACT_MCU_OR_PHYSICAL_EVIDENCE_MISSING");
+    if (b.expected.board_type==6 && (b.capabilities.can_fd || b.capabilities.ir || b.transport=="SPI"))
+      return reject("F4_UNSUPPORTED_CAPABILITY_OR_TRANSPORT");
+    if (b.transport=="SPI" && (!valid_native_spi_selector(b.spi_selector) || *b.spi_selector.expected_mode!=0 ||
+        *b.spi_selector.expected_bits_per_word!=8 || *b.spi_selector.expected_max_speed_hz>50000000 || b.spi_selector.identity_evidence_sha256 != b.physical_evidence_sha256))
+      return reject("SPI_NODE_CONFIGURATION_EVIDENCE_MISSING");
+    try { if (!verify(b)) return reject("PHYSICAL_EVIDENCE_NOT_VERIFIED"); }
+    catch (...) { return reject("PHYSICAL_EVIDENCE_VERIFIER_FAILED"); }
+    const auto found=std::find_if(inventory.begin(),inventory.end(),[&](const auto &o){return o.raw.uid==b.expected.uid;});
+    if (found==inventory.end() || found->transport!=b.transport || !same_raw(found->raw,b.expected)) return reject("OBSERVED_IDENTITY_MISMATCH");
+    if ((b.transport=="USB" && (!found->usb_alt0_verified || found->spi_first_request_id)) ||
+        (b.transport=="SPI" && (!found->spi_first_request_id || found->usb_alt0_verified || !(found->spi_selector==b.spi_selector)))) return reject("SESSION_ACTIVATION_EVIDENCE_MISSING");
+    result.observations[slot]=*found;
+    candidate.slots[slot]={static_cast<std::uint32_t>(slot),identity(b),"noOutput"};
+  }
+  try { const SessionRegistry checked(candidate); (void)checked; }
+  catch (...) { return reject("INVALID_ROLES_OR_CAPABILITIES"); }
+  result.profile=std::move(candidate); result.bound=true; result.reason="MATCHED_READ_ONLY_CANDIDATE_NO_DEPLOYMENT_PERMISSION";
+  return result;
+}
+NativeLease native_usb_read_only_lease(NativeUsbInventory &inventory, std::size_t index, const NativeBindingResult &binding, std::size_t slot,
+                                       Clock &clock, bool allow) {
+  NativeLease result;
+  if (!binding.bound || slot>=2) return result;
+  const auto &observed=binding.observations[slot]; result.observed=observed;
+  if (!allow || observed.transport!="USB" || !observed.usb_alt0_verified || observed.spi_first_request_id) return result;
+  NativeUsbActivation activation;
+  activation.lease_nonce=observed.raw.lease_nonce; activation.allow_device_io=true;
+  activation.profile_validated=true; activation.bulk_alt0_verified=true;
+  std::uint64_t activated_us=0;
+  auto backend=inventory.activate(index,observed.raw,activation,clock,&activated_us);
+  if (!backend) return result;
+  result.observed_us=activated_us;
+  result.io=std::make_unique<OwnedTransport>(); result.io->backend=std::move(backend);
+  result.io->transport=std::make_unique<Transport>(*result.io->backend,clock);
+  return result;
+}
+NativeLease native_spi_read_only_lease(NativeSpiProbeResult &&probe, const NativeObservedBoard &observed) {
+  NativeLease result; result.observed=observed;
+  if (probe.complete() && observed.transport=="SPI" && observed.spi_first_request_id && !observed.usb_alt0_verified &&
+      probe.observation == observed.raw && probe.first_request_id==observed.spi_first_request_id &&
+      probe.validated_selector==observed.spi_selector) {
+    result.observed_us=probe.completed_us; result.io=std::move(probe.transport);
+  }
+  return result;
+}
+bool NativeReadOnlyProviders::stage(std::vector<NativeLease> leases, std::uint64_t revision, std::uint64_t observed_us, bool allow) {
+  leases_={}; snapshot_={}; binding_={};
+  const auto now=clock_.now_us();
+  if (!allow || !revision || revision<=last_revision_ || !observed_us || observed_us>now || now-observed_us>=kLoopMaxGapUs || leases.size()!=2)
+    return false;
+  std::vector<NativeObservedBoard> observations;
+  std::uint64_t oldest=now;
+  for (const auto &lease:leases) {
+    if (!lease.io || !lease.io->backend || !lease.io->transport || !lease.io->transport->healthy() ||
+        !lease.observed_us || lease.observed_us>now || now-lease.observed_us>=kLoopMaxGapUs ||
+        !lease.observed.raw.lease_nonce || consumed_.count(lease.observed.raw.lease_nonce) || consumed_.size()>126) return false;
+    oldest=std::min(oldest,lease.observed_us);
+    observations.push_back(lease.observed);
+  }
+  if (observed_us!=oldest) return false;
+  last_revision_=revision;
+  for (const auto &o:observations) consumed_.insert(o.raw.lease_nonce);
+  binding_=validate_native_binding(profile_,observations,verifier_);
+  if (!binding_.bound) return false;
+  snapshot_.revision=revision; snapshot_.observed_us=observed_us;
+  for (std::size_t slot=0;slot<2;++slot) {
+    const auto &o=binding_.observations[slot];
+    const auto it=std::find_if(leases.begin(),leases.end(),[&](const auto &l){return l.observed.raw.lease_nonce==o.raw.lease_nonce;});
+    leases_[slot]=std::move(it->io);
+    // Enforce receive-only at the final handoff as well, even if a caller
+    // accidentally supplies a provider created with a broader grant.
+    leases_[slot]->transport.reset();
+    leases_[slot]->backend=std::make_unique<ReadOnlyHandoff>(std::move(leases_[slot]->backend));
+    leases_[slot]->transport=std::make_unique<Transport>(*leases_[slot]->backend,clock_);
+    snapshot_.items.push_back({binding_.profile.slots[slot].expected,nonce(o),o.usb_alt0_verified,o.spi_first_request_id});
+  }
+  return true;
+}
+std::unique_ptr<OwnedTransport> NativeReadOnlyProviders::open(const DiscoveryItem &item, const SessionBinding &binding) {
+  if (!binding_.bound || binding.slot>=2 || binding.safety_config_semantics!="noOutput") return nullptr;
+  const auto slot=binding.slot;
+  const auto &expected=snapshot_.items[slot];
+  const auto now=clock_.now_us();
+  if (now<snapshot_.observed_us || now-snapshot_.observed_us>=kLoopMaxGapUs ||
+      !(item.identity==binding.expected) || !(item.identity==expected.identity) || item.handle_nonce!=expected.handle_nonce ||
+      item.usb_alt0_verified!=expected.usb_alt0_verified || item.spi_first_request_id!=expected.spi_first_request_id) return nullptr;
+  return std::move(leases_[slot]);
+}
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_binding.h b/openpilot/selfdrive/pandad/compatibility/native_binding.h
new file mode 100644
index 0000000..7074c85
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_binding.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include <functional>
+#include "native_usb.h"
+#include "native_spi_probe.h"
+
+namespace openpilot::pandad::compatibility {
+struct NativeObservedBoard {
+  NativeUsbObservation raw;
+  std::string transport;
+  bool usb_alt0_verified = false;
+  std::uint32_t spi_first_request_id = 0;
+  NativeSpiSelector spi_selector;
+};
+struct NativeBoardBinding {
+  std::uint32_t slot = 0;
+  // Expected raw identity must have nonce zero: leases belong to discovery,
+  // never to persisted profiles. SPI serial is empty; USB serial is explicit.
+  NativeUsbObservation expected;
+  std::string transport;
+  std::string exact_mcu;
+  SessionCapabilities capabilities;
+  std::string physical_evidence_sha256;
+  NativeSpiSelector spi_selector;
+};
+struct NativeBindingProfile {
+  NativeBindingProfile() { slots[1].slot = 1; }
+  std::string schema = "songplus-native-binding/v1";
+  std::string binding_status = "UNBOUND";
+  std::array<NativeBoardBinding,2> slots{{NativeBoardBinding{},NativeBoardBinding{}}};
+  SessionRoles roles;
+  bool device_access_enabled = false, can_tx_enabled = false, firmware_install_enabled = false;
+};
+// This callback must check the referenced evidence content AND its association
+// with this exact board/MCU/capability/transport tuple. A digest or true boolean
+// in a JSON file is not verification. No production verifier ships in P9.
+using NativeEvidenceVerifier = std::function<bool(const NativeBoardBinding &)>;
+struct NativeBindingResult {
+  bool bound = false;
+  std::string reason = "UNBOUND_PROFILE";
+  SessionProfile profile;
+  std::array<NativeObservedBoard,2> observations;
+};
+NativeBindingResult validate_native_binding(const NativeBindingProfile &,
+  const std::vector<NativeObservedBoard> &, const NativeEvidenceVerifier & = {});
+
+struct NativeLease {
+  NativeObservedBoard observed;
+  std::uint64_t observed_us = 0;
+  std::unique_ptr<OwnedTransport> io;
+};
+// Adapter helpers never discover/reopen devices and default-deny activation.
+NativeLease native_usb_read_only_lease(NativeUsbInventory &, std::size_t,
+  const NativeBindingResult &, std::size_t slot, Clock &, bool allow_read_only_activation = false);
+NativeLease native_spi_read_only_lease(NativeSpiProbeResult &&, const NativeObservedBoard &);
+
+// Bridges retained native providers to the existing epoch/whole-group owner.
+// Staging requires all two identities and transfers each lease exactly once.
+// Snapshot timestamps are NOT renewed without a new complete probe: the P8
+// freshness barrier will retire a stale group. There is no production launcher.
+class NativeReadOnlyProviders final : public DiscoveryProvider, public TransportFactory {
+public:
+  NativeReadOnlyProviders(const NativeBindingProfile &profile, NativeEvidenceVerifier verifier, Clock &clock)
+    : profile_(profile), verifier_(std::move(verifier)), clock_(clock) {}
+  bool stage(std::vector<NativeLease> leases, std::uint64_t revision,
+             std::uint64_t observed_us, bool allow_read_only_handoff = false);
+  DiscoverySnapshot snapshot() override { return snapshot_; }
+  std::unique_ptr<OwnedTransport> open(const DiscoveryItem &, const SessionBinding &) override;
+  NativeBindingResult binding() const { return binding_; }
+private:
+  const NativeBindingProfile profile_;
+  NativeEvidenceVerifier verifier_;
+  Clock &clock_;
+  NativeBindingResult binding_;
+  DiscoverySnapshot snapshot_;
+  std::array<std::unique_ptr<OwnedTransport>,2> leases_;
+  std::set<std::uint64_t> consumed_;
+  std::uint64_t last_revision_ = 0;
+};
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_spi.cc b/openpilot/selfdrive/pandad/compatibility/native_spi.cc
new file mode 100644
index 0000000..d9d3300
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_spi.cc
@@ -0,0 +1,220 @@
+#include "native_spi.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <fcntl.h>
+#include <limits>
+
+#ifdef __linux__
+#include <linux/spi/spidev.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+#endif
+
+namespace openpilot::pandad::compatibility {
+namespace {
+Status error_status(int error) {
+  if (error == ENODEV || error == ENXIO || error == EBADF) return Status::Disconnected;
+  if (error == ETIMEDOUT) return Status::Timeout;
+  if (error == EAGAIN || error == EWOULDBLOCK) return Status::Busy;
+  return Status::IoError;
+}
+Result rejected(Status status) { return {status, 0, {}, true, false}; }
+bool canonical_number(const std::string &value) {
+  if (value.empty() || (value.size() > 1 && value.front() == '0') || value.size() > 10) return false;
+  std::uint64_t number = 0;
+  for (const char ch : value) {
+    if (ch < '0' || ch > '9') return false;
+    number = number * 10 + static_cast<unsigned>(ch - '0');
+    if (number > std::numeric_limits<std::uint32_t>::max()) return false;
+  }
+  return true;
+}
+class LinuxSpiSyscalls final : public NativeSpiSyscalls {
+public:
+#ifdef __linux__
+  NativeSpiCall open_device(const std::string &path, int flags) override { return result(::open(path.c_str(), flags)); }
+  NativeSpiCall stat_device(int fd, NativeSpiNode &node) override {
+    struct stat metadata{};
+    auto call = result(::fstat(fd, &metadata));
+    if (call.value == 0) node = {S_ISCHR(metadata.st_mode), static_cast<std::uint32_t>(::major(metadata.st_rdev)), static_cast<std::uint32_t>(::minor(metadata.st_rdev))};
+    return call;
+  }
+  NativeSpiCall read_mode(int fd, std::uint32_t &mode) override { return result(::ioctl(fd, SPI_IOC_RD_MODE32, &mode)); }
+  NativeSpiCall read_bits(int fd, std::uint8_t &bits) override { return result(::ioctl(fd, SPI_IOC_RD_BITS_PER_WORD, &bits)); }
+  NativeSpiCall read_speed(int fd, std::uint32_t &speed) override { return result(::ioctl(fd, SPI_IOC_RD_MAX_SPEED_HZ, &speed)); }
+  NativeSpiCall lock_device(int fd, bool acquire) override { return result(::flock(fd, acquire ? LOCK_EX | LOCK_NB : LOCK_UN)); }
+  NativeSpiCall message(int fd, const std::uint8_t *tx, std::uint8_t *rx, std::size_t bytes) override {
+    struct spi_ioc_transfer transfer{};
+    transfer.tx_buf = reinterpret_cast<std::uintptr_t>(tx);
+    transfer.rx_buf = reinterpret_cast<std::uintptr_t>(rx);
+    transfer.len = static_cast<std::uint32_t>(bytes);
+    // speed_hz/bits_per_word/delay/cs_change remain zero: retain the inspected
+    // driver configuration and use one full-duplex CS assertion, no overrides.
+    return result(::ioctl(fd, SPI_IOC_MESSAGE(1), &transfer));
+  }
+  NativeSpiCall close_device(int fd) override { return result(::close(fd)); }
+private:
+  static NativeSpiCall result(int value) { return {value, value < 0 ? errno : 0}; }
+#else
+  NativeSpiCall open_device(const std::string &, int) override { return unsupported(); }
+  NativeSpiCall stat_device(int, NativeSpiNode &) override { return unsupported(); }
+  NativeSpiCall read_mode(int, std::uint32_t &) override { return unsupported(); }
+  NativeSpiCall read_bits(int, std::uint8_t &) override { return unsupported(); }
+  NativeSpiCall read_speed(int, std::uint32_t &) override { return unsupported(); }
+  NativeSpiCall lock_device(int, bool) override { return unsupported(); }
+  NativeSpiCall message(int, const std::uint8_t *, std::uint8_t *, std::size_t) override { return unsupported(); }
+  NativeSpiCall close_device(int) override { return unsupported(); }
+private:
+  static NativeSpiCall unsupported() { return {-1, ENOTSUP}; }
+#endif
+};
+}  // namespace
+
+std::shared_ptr<NativeSpiSyscalls> make_linux_spi_syscalls() { return std::make_shared<LinuxSpiSyscalls>(); }
+
+bool operator==(const NativeSpiSelector &a, const NativeSpiSelector &b) {
+  return a.path == b.path && a.identity_evidence_sha256 == b.identity_evidence_sha256 &&
+    a.physical_identity_verified == b.physical_identity_verified && a.expected_major == b.expected_major &&
+    a.expected_minor == b.expected_minor && a.expected_mode == b.expected_mode &&
+    a.expected_bits_per_word == b.expected_bits_per_word && a.expected_max_speed_hz == b.expected_max_speed_hz;
+}
+
+bool valid_native_spi_selector(const NativeSpiSelector &selector) {
+  constexpr const char *prefix = "/dev/spidev";
+  constexpr std::size_t prefix_size = 11;
+  if (selector.path.compare(0, prefix_size, prefix) != 0 || selector.path.size() > 32) return false;
+  const auto dot = selector.path.find('.', prefix_size);
+  if (dot == std::string::npos || !canonical_number(selector.path.substr(prefix_size, dot - prefix_size)) ||
+      !canonical_number(selector.path.substr(dot + 1))) return false;
+  if (!selector.physical_identity_verified || selector.identity_evidence_sha256.size() != 64 ||
+      !std::all_of(selector.identity_evidence_sha256.begin(), selector.identity_evidence_sha256.end(),
+                   [](char ch) { return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'); })) return false;
+  return selector.expected_major && *selector.expected_major > 0 && selector.expected_minor &&
+         selector.expected_mode && selector.expected_bits_per_word && *selector.expected_bits_per_word > 0 &&
+         *selector.expected_bits_per_word <= 32 && selector.expected_max_speed_hz && *selector.expected_max_speed_hz > 0;
+}
+
+NativeSpiIo::~NativeSpiIo() { end(); close(); }
+void NativeSpiIo::close() noexcept {
+  if (fd_ >= 0) {
+    // Never retry close: Linux may already have released the descriptor on EINTR.
+    (void)calls_->close_device(fd_);
+    fd_ = -1;
+  }
+}
+
+Status NativeSpiIo::check_node_and_configuration() {
+  if (cancelled_.load()) return Status::Cancelled;
+  NativeSpiNode node;
+  auto call = calls_->stat_device(fd_, node);
+  if (call.value != 0) return error_status(call.error);
+  if (cancelled_.load()) return Status::Cancelled;
+  if (!node.character_device || node.major != *selector_.expected_major || node.minor != *selector_.expected_minor) return Status::Invalid;
+  std::uint32_t mode = 0, speed = 0;
+  std::uint8_t bits = 0;
+  call = calls_->read_mode(fd_, mode);
+  if (call.value != 0) return error_status(call.error);
+  if (cancelled_.load()) return Status::Cancelled;
+  call = calls_->read_bits(fd_, bits);
+  if (call.value != 0) return error_status(call.error);
+  if (cancelled_.load()) return Status::Cancelled;
+  call = calls_->read_speed(fd_, speed);
+  if (call.value != 0) return error_status(call.error);
+  if (cancelled_.load()) return Status::Cancelled;
+  return mode == *selector_.expected_mode && bits == *selector_.expected_bits_per_word &&
+         speed == *selector_.expected_max_speed_hz ? Status::Ok : Status::Invalid;
+}
+
+Status NativeSpiIo::activate(const NativeSpiSelector &selector, NativeSpiActivation permit) {
+  if (cancelled_.load()) return Status::Cancelled;
+  if (permit != NativeSpiActivation::VerifiedProfile || !valid_native_spi_selector(selector) || !calls_ || activated_once_) return Status::Invalid;
+  activated_once_ = true;
+  selector_ = selector;
+  const auto opened = calls_->open_device(selector.path, O_RDWR | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+  if (opened.value < 0) return error_status(opened.error);
+  fd_ = opened.value;
+  if (cancelled_.load()) { close(); return Status::Cancelled; }
+  const auto locked = calls_->lock_device(fd_, true);
+  if (locked.value != 0) { close(); return error_status(locked.error); }
+  lease_ = true;
+  const auto status = check_node_and_configuration();
+  end();
+  if (status != Status::Ok || poisoned_ || cancelled_.load()) {
+    close();
+    return cancelled_.load() ? Status::Cancelled : (poisoned_ ? Status::IoError : status);
+  }
+  return Status::Ok;
+}
+
+Status NativeSpiIo::begin(std::uint32_t timeout_ms) {
+  if (cancelled_.load()) return Status::Cancelled;
+  if (fd_ < 0 || poisoned_) return Status::Disconnected;
+  if (lease_) return Status::Busy;
+  if (timeout_ms == 0 || timeout_ms > kBackendSliceMs) return Status::Invalid;
+  const auto start = clock_.now_us();
+  auto previous = start;
+  const auto budget = static_cast<std::uint64_t>(timeout_ms) * 1000;
+  auto elapsed = [&](std::uint64_t &spent) {
+    const auto now = clock_.now_us();
+    if (now < previous) { poisoned_ = true; return false; }
+    previous = now; spent = now - start; return true;
+  };
+  for (std::uint32_t attempt = 0; attempt < kNativeSpiLockAttempts; ++attempt) {
+    if (cancelled_.load()) return Status::Cancelled;
+    std::uint64_t spent = 0;
+    if (!elapsed(spent)) return Status::IoError;
+    if (spent >= budget) return Status::Timeout;
+    const auto locked = calls_->lock_device(fd_, true);
+    if (locked.value == 0) {
+      lease_ = true;
+      auto status = check_node_and_configuration();
+      if (cancelled_.load()) status = Status::Cancelled;
+      else if (!elapsed(spent)) status = Status::IoError;
+      else if (spent >= budget) status = Status::Timeout;
+      if (status != Status::Ok) {
+        poisoned_ = true;
+        end();
+      }
+      return status;
+    }
+    if (locked.error != EAGAIN && locked.error != EWOULDBLOCK) return error_status(locked.error);
+    if (attempt + 1 < kNativeSpiLockAttempts) {
+      if (!elapsed(spent)) return Status::IoError;
+      if (spent >= budget) return Status::Timeout;
+      clock_.wait_us(static_cast<std::uint32_t>(std::min<std::uint64_t>(kNativeSpiLockWaitUs, budget - spent)));
+    }
+  }
+  return Status::Busy;
+}
+
+void NativeSpiIo::end() noexcept {
+  if (lease_) {
+    lease_ = false;
+    if (calls_->lock_device(fd_, false).value != 0) { poisoned_ = true; close(); }
+  }
+}
+
+Result NativeSpiIo::exchange(const std::vector<std::uint8_t> &tx, std::uint32_t timeout_ms) {
+  if (cancelled_.load()) return rejected(Status::Cancelled);
+  if (fd_ < 0 || poisoned_) return rejected(Status::Disconnected);
+  if (!lease_ || tx.empty() || tx.size() > kSpiBufferBytes || timeout_ms == 0 || timeout_ms > kBackendSliceMs) return rejected(Status::Invalid);
+  const auto started = clock_.now_us();
+  std::vector<std::uint8_t> rx(tx.size());
+  const auto call = calls_->message(fd_, tx.data(), rx.data(), tx.size());
+  if (call.value < 0) { poisoned_ = true; return {error_status(call.error), 0, {}, false, true}; }
+  if (static_cast<std::size_t>(call.value) > tx.size()) { poisoned_ = true; return {Status::IoError, 0, {}, false, true}; }
+  rx.resize(static_cast<std::size_t>(call.value));
+  auto status = rx.size() == tx.size() ? Status::Ok : Status::Short;
+  const auto completed = clock_.now_us();
+  if (cancelled_.load()) status = Status::Cancelled;
+  else if (completed < started) status = Status::IoError;
+  else if (completed - started >= static_cast<std::uint64_t>(timeout_ms) * 1000) status = Status::Timeout;
+  if (status != Status::Ok) poisoned_ = true;
+  return {status, rx.size(), std::move(rx), true, static_cast<std::size_t>(call.value) != tx.size()};
+}
+
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_spi.h b/openpilot/selfdrive/pandad/compatibility/native_spi.h
new file mode 100644
index 0000000..0184cbd
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_spi.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "spi_backend.h"
+
+namespace openpilot::pandad::compatibility {
+
+// These are verified observations of this exact node and board. Missing identity
+// or configuration is unbound; no path, MCU, mode or speed is guessed.
+struct NativeSpiSelector {
+  std::string path;
+  std::string identity_evidence_sha256;
+  bool physical_identity_verified = false;
+  std::optional<std::uint32_t> expected_major;
+  std::optional<std::uint32_t> expected_minor;
+  std::optional<std::uint32_t> expected_mode;
+  std::optional<std::uint8_t> expected_bits_per_word;
+  std::optional<std::uint32_t> expected_max_speed_hz;
+};
+bool operator==(const NativeSpiSelector &, const NativeSpiSelector &);
+enum class NativeSpiActivation { Denied, VerifiedProfile };
+struct NativeSpiCall { int value = -1; int error = 0; };
+struct NativeSpiNode {
+  bool character_device = false;
+  std::uint32_t major = 0, minor = 0;
+};
+
+// Every syscall has an injected seam. The Linux implementation issues only
+// SPI_IOC_RD_* and one SPI_IOC_MESSAGE(1), never WR_* or reset/GPIO operations.
+// Implementations return the captured errno, not an ambient mutable errno.
+class NativeSpiSyscalls {
+public:
+  virtual ~NativeSpiSyscalls() = default;
+  virtual NativeSpiCall open_device(const std::string &, int flags) = 0;
+  virtual NativeSpiCall stat_device(int fd, NativeSpiNode &) = 0;
+  virtual NativeSpiCall read_mode(int fd, std::uint32_t &) = 0;
+  virtual NativeSpiCall read_bits(int fd, std::uint8_t &) = 0;
+  virtual NativeSpiCall read_speed(int fd, std::uint32_t &) = 0;
+  virtual NativeSpiCall lock_device(int fd, bool acquire) = 0;
+  virtual NativeSpiCall message(int fd, const std::uint8_t *tx, std::uint8_t *rx, std::size_t bytes) = 0;
+  virtual NativeSpiCall close_device(int fd) = 0;
+};
+
+// Construction is inert, including on non-Linux hosts. Unsupported syscall
+// implementations fail closed; no device enumeration or fallback is performed.
+std::shared_ptr<NativeSpiSyscalls> make_linux_spi_syscalls();
+bool valid_native_spi_selector(const NativeSpiSelector &selector);
+inline constexpr bool kNativeSpiKernelDeadlineProven = false;
+inline constexpr std::uint32_t kNativeSpiLockAttempts = 32;
+inline constexpr std::uint32_t kNativeSpiLockWaitUs = 100;
+
+// The owner serializes activate/begin/exchange/end/destruction. Only cancel may
+// run concurrently. cancel does not close or interrupt an in-flight kernel call.
+// Linux synchronous SPI_IOC_MESSAGE has no hard timeout: offline budgets and
+// cancellation are checked before/after it, not proof of a kernel deadline.
+class NativeSpiIo final : public SpiIo {
+public:
+  NativeSpiIo(std::shared_ptr<NativeSpiSyscalls> calls, Clock &clock)
+      : calls_(std::move(calls)), clock_(clock) {}
+  ~NativeSpiIo() override;
+  NativeSpiIo(const NativeSpiIo &) = delete;
+  NativeSpiIo &operator=(const NativeSpiIo &) = delete;
+  Status activate(const NativeSpiSelector &, NativeSpiActivation permit = NativeSpiActivation::Denied);
+  Status begin(std::uint32_t timeout_ms) override;
+  void end() noexcept override;
+  void cancel() noexcept override { cancelled_.store(true); }
+  Result exchange(const std::vector<std::uint8_t> &, std::uint32_t timeout_ms) override;
+  bool active() const { return fd_ >= 0 && !cancelled_.load() && !poisoned_; }
+private:
+  Status check_node_and_configuration();
+  void close() noexcept;
+  std::shared_ptr<NativeSpiSyscalls> calls_;
+  Clock &clock_;
+  NativeSpiSelector selector_;
+  int fd_ = -1;
+  bool lease_ = false, activated_once_ = false, poisoned_ = false;
+  std::atomic<bool> cancelled_{false};
+};
+
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_spi_probe.cc b/openpilot/selfdrive/pandad/compatibility/native_spi_probe.cc
new file mode 100644
index 0000000..13fecb2
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_spi_probe.cc
@@ -0,0 +1,136 @@
+#include "native_spi_probe.h"
+
+#include <algorithm>
+#include <limits>
+#include <set>
+
+#include "firmware_capabilities.h"
+
+namespace openpilot::pandad::compatibility {
+namespace {
+constexpr std::array<std::uint8_t, 8> kProtocol{{0xf5, 0x12, 0xbc, 0xff, 0x76, 0xf2, 0xab, 0x75}};
+template<std::size_t N> bool uniform(const std::array<std::uint8_t, N> &bytes, std::uint8_t value) {
+  return std::all_of(bytes.begin(), bytes.end(), [=](auto byte) { return byte == value; });
+}
+class ReadOnlySpiBackend final : public Backend {
+public:
+  ReadOnlySpiBackend(NativeSpiIo &io, Clock &clock, std::uint32_t first_id) : io_(io), inner_(io, clock, first_id) {}
+  void permit_f4_read() { f4_ = true; }
+  void cancel() noexcept override { cancelled_.store(true); inner_.cancel(); }
+  Result transact(const Request &request, std::uint32_t timeout_ms) override {
+    if (cancelled_.load()) return {Status::Cancelled, 0, {}};
+    if (!valid_request(request) || !timeout_ms || timeout_ms > kBackendSliceMs ||
+        (request.kind != Kind::ControlRead && request.kind != Kind::BulkRead)) return {Status::Invalid, 0, {}};
+    if (request.kind == Kind::BulkRead && request.endpoint != 0x81) return {Status::Invalid, 0, {}};
+    if (request.kind == Kind::ControlRead) {
+      const std::size_t expected = request.request == 0xc3 ? 12 : request.request == 0xc1 ? 1 :
+        request.request == 0xdd ? 8 : (request.request == 0xd3 || request.request == 0xd4 || request.request == 0xc2) ? 64 :
+        request.request == 0xd5 && f4_ ? 16 : request.request == 0xd2 ? 48 : request.request == 0xb2 ? 2 : 0;
+      if (!expected || request.read_length != expected || request.index != 0 ||
+          (request.request == 0xc2 ? request.value >= 3 : request.value != 0)) return {Status::Invalid, 0, {}};
+    }
+    auto result = inner_.transact(request, timeout_ms);
+    // SpiBackend's lease destructor runs before this check. An unlock failure
+    // closes/poisons the fd and must invalidate even a fully received reply.
+    if (!io_.active() && (result.status == Status::Ok || result.status == Status::Short)) result.status = Status::IoError;
+    return result;
+  }
+private:
+  NativeSpiIo &io_;
+  SpiBackend inner_;
+  bool f4_ = false;
+  std::atomic<bool> cancelled_{false};
+};
+}  // namespace
+
+NativeSpiProbeResult discover_native_spi(std::shared_ptr<NativeSpiSyscalls> calls, Clock &clock,
+                                         const NativeSpiProbePolicy &policy, bool allow_device_io) {
+  NativeSpiProbeResult result;
+  if (!allow_device_io || !calls || !valid_native_spi_selector(policy.selector) || !policy.first_request_id ||
+      *policy.selector.expected_mode != 0 || *policy.selector.expected_bits_per_word != 8 ||
+      *policy.selector.expected_max_speed_hz > 50000000 ||
+      policy.first_request_id > std::numeric_limits<std::uint32_t>::max() - 5 ||
+      !policy.budget_ms || policy.budget_ms > kMaxTransportTimeoutMs || policy.f4_application_signatures.size() > 2) return result;
+  std::set<std::array<std::uint8_t, 128>> signatures;
+  for (const auto &signature : policy.f4_application_signatures)
+    if (uniform(signature, 0) || uniform(signature, 0xff) || !signatures.insert(signature).second) return result;
+  const auto start = clock.now_us();
+  auto previous = start;
+  bool clock_fault = false;
+  const auto budget = static_cast<std::uint64_t>(policy.budget_ms) * 1000;
+  auto remaining_ms = [&]() -> std::uint32_t {
+    const auto now = clock.now_us();
+    if (now < previous) { clock_fault = true; return 0; }
+    previous = now;
+    const auto elapsed = now - start;
+    return elapsed >= budget ? 0 : static_cast<std::uint32_t>((budget - elapsed) / 1000);
+  };
+  const auto expired_status = [&] { return clock_fault ? Status::IoError : Status::Timeout; };
+  auto fail = [&](Status status, const std::string &reason) {
+    NativeSpiProbeResult failed;
+    failed.status = status; failed.reason = reason;
+    return failed;
+  };
+  if (!remaining_ms()) return fail(expired_status(), "PROBE_CLOCK_OR_DEADLINE");
+  auto io = std::make_unique<NativeSpiIo>(std::move(calls), clock);
+  auto status = io->activate(policy.selector, NativeSpiActivation::VerifiedProfile);
+  if (status != Status::Ok) return fail(status, "SPI_ACTIVATION_FAILED");
+  if (!remaining_ms()) return fail(expired_status(), "PROBE_CLOCK_OR_DEADLINE");
+  auto owner = std::make_unique<OwnedTransport>();
+  auto backend = std::make_unique<ReadOnlySpiBackend>(*io, clock, policy.first_request_id);
+  auto *read_only = backend.get();
+  owner->spi_io = std::move(io);
+  owner->backend = std::move(backend);
+  owner->transport = std::make_unique<Transport>(*owner->backend, clock);
+  NativeUsbObservation observed;
+  observed.lease_nonce = allocate_native_lease_nonce();
+  if (!observed.lease_nonce) return fail(Status::Poisoned, "LEASE_NONCE_EXHAUSTED");
+  auto read = [&](std::uint8_t request, std::uint8_t *data, std::size_t length) {
+    const auto remaining = remaining_ms();
+    if (!remaining) return expired_status();
+    Request read_request; read_request.kind = Kind::ControlRead; read_request.request = request; read_request.read_length = length;
+    const auto reply = owner->transport->perform(read_request, remaining);
+    if (!remaining_ms()) return expired_status();
+    if (reply.status != Status::Ok) return reply.status == Status::Short ? Status::Poisoned : reply.status;
+    if (!reply.actual_known || reply.delivery_uncertain || reply.actual != length || reply.data.size() != length) return Status::Poisoned;
+    std::copy(reply.data.begin(), reply.data.end(), data);
+    return Status::Ok;
+  };
+  status = read(0xc3, observed.uid.data(), observed.uid.size());
+  if (status != Status::Ok) return fail(status, "UID_PROBE_FAILED");
+  if (uniform(observed.uid, 0) || uniform(observed.uid, 0xff)) return fail(Status::Poisoned, "INVALID_UID_REPLY");
+  status = read(0xc1, &observed.board_type, 1);
+  if (status != Status::Ok) return fail(status, "BOARD_TYPE_PROBE_FAILED");
+  if (observed.board_type != 6 && observed.board_type != 7) return fail(Status::Poisoned, "UNKNOWN_BOARD_TYPE");
+  status = read(0xdd, observed.protocol.data(), observed.protocol.size());
+  if (status != Status::Ok) return fail(status, "PROTOCOL_PROBE_FAILED");
+  if (observed.protocol != kProtocol) return fail(Status::Poisoned, "PROTOCOL_MISMATCH");
+  status = read(0xd3, observed.application_signature.data(), 64);
+  if (status != Status::Ok) return fail(status, "SIGNATURE_FIRST_PROBE_FAILED");
+  status = read(0xd4, observed.application_signature.data() + 64, 64);
+  if (status != Status::Ok) return fail(status, "SIGNATURE_SECOND_PROBE_FAILED");
+  if (uniform(observed.application_signature, 0) || uniform(observed.application_signature, 0xff)) return fail(Status::Poisoned, "INVALID_SIGNATURE_REPLY");
+  if (signatures.count(observed.application_signature)) {
+    if (observed.board_type != 6) return fail(Status::Poisoned, "F4_SIGNATURE_BOARD_CONFLICT");
+    read_only->permit_f4_read();
+    observed.f4_capabilities.resize(kF4CapabilityLength);
+    status = read(kF4CapabilityRequest, observed.f4_capabilities.data(), observed.f4_capabilities.size());
+    if (status != Status::Ok) return fail(status, "F4_CAPABILITY_PROBE_FAILED");
+    if (!valid_f4_capabilities(observed.f4_capabilities)) return fail(Status::Poisoned, "F4_CAPABILITY_MISMATCH");
+  }
+  if (!remaining_ms()) return fail(expired_status(), "PROBE_CLOCK_OR_DEADLINE");
+  result.status = Status::Ok;
+  result.reason = "READ_ONLY_SPI_OBSERVATION_RETAINED";
+  result.observation = std::move(observed);
+  result.validated_selector = policy.selector;
+  result.first_request_id = policy.first_request_id;
+  result.started_us = start;
+  result.completed_us = previous;
+  result.transport = std::move(owner);
+  return result;
+}
+
+NativeSpiProbeResult discover_native_spi(Clock &clock, const NativeSpiProbePolicy &policy, bool allow_device_io) {
+  return discover_native_spi(make_linux_spi_syscalls(), clock, policy, allow_device_io);
+}
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_spi_probe.h b/openpilot/selfdrive/pandad/compatibility/native_spi_probe.h
new file mode 100644
index 0000000..8aaebae
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_spi_probe.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "native_spi.h"
+#include "native_usb.h"
+#include "runtime_integration.h"
+
+namespace openpilot::pandad::compatibility {
+struct NativeSpiProbePolicy {
+  // The observed configuration must explicitly be mode0/8-bit and <=50MHz,
+  // matching the locked byte-protocol ceiling. This does not establish target
+  // timing or compatibility at any selected speed; physical evidence is needed.
+  NativeSpiSelector selector;
+  // Explicit nonzero seed, with room for all identity reads. The caller must
+  // supply freshness across physical sessions/process restarts: nonzero alone
+  // does not prevent the MCU from recognizing an earlier id+CRC as a replay.
+  std::uint32_t first_request_id = 0;
+  std::uint32_t budget_ms = 100;
+  std::vector<std::array<std::uint8_t, 128>> f4_application_signatures;
+};
+struct NativeSpiProbeResult {
+  Status status = Status::Invalid;
+  std::string reason = "UNBOUND_OR_DEVICE_IO_DENIED";
+  NativeUsbObservation observation;
+  // Filled only after the complete same-fd probe succeeds. These immutable
+  // observations let handoff validate selector/seed and retain original age.
+  NativeSpiSelector validated_selector;
+  std::uint32_t first_request_id = 0;
+  std::uint64_t started_us = 0, completed_us = 0;
+  std::unique_ptr<OwnedTransport> transport;
+  bool complete() const { return status == Status::Ok && transport != nullptr; }
+};
+
+// Read-only describes the firmware operations, not passive SPI observation:
+// requesting identity actively transmits SPI framing and consumes reply state.
+// Explicit permission is mandatory. Discovery and all later reads retain the
+// same fd/backend; no reopen, fallback, reset, configuration or OUT is allowed.
+// Returned facts are untrusted software observations, not MCU identity proof.
+NativeSpiProbeResult discover_native_spi(std::shared_ptr<NativeSpiSyscalls>, Clock &,
+                                         const NativeSpiProbePolicy &, bool allow_device_io = false);
+NativeSpiProbeResult discover_native_spi(Clock &, const NativeSpiProbePolicy &, bool allow_device_io = false);
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_usb.cc b/openpilot/selfdrive/pandad/compatibility/native_usb.cc
new file mode 100644
index 0000000..7e391cb
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_usb.cc
@@ -0,0 +1,314 @@
+#include "native_usb.h"
+
+#include <algorithm>
+#include <atomic>
+#include <limits>
+#include <mutex>
+#include <set>
+#include <utility>
+
+#include "firmware_capabilities.h"
+#include "control_session.h"
+
+namespace openpilot::pandad::compatibility {
+namespace {
+constexpr std::array<std::uint8_t, 8> kProtocol{{0xf5, 0x12, 0xbc, 0xff, 0x76, 0xf2, 0xab, 0x75}};
+
+Status usb_error(int value) {
+  switch (value) {
+    case kUsbTimeout: return Status::Timeout;
+    case kUsbNoDevice: return Status::Disconnected;
+    case kUsbPipe: return Status::Stall;
+    case kUsbBusy: return Status::Busy;
+    case kUsbInterrupted: return Status::Cancelled;
+    case kUsbInvalid: return Status::Invalid;
+    default: return Status::IoError;
+  }
+}
+struct Budget {
+  Clock &clock;
+  std::uint64_t start, previous, limit;
+  explicit Budget(Clock &c, std::uint32_t ms) : clock(c), start(c.now_us()), previous(start), limit(ms * 1000ULL) {}
+  std::uint32_t slice() {
+    const auto now = clock.now_us();
+    if (now < previous || now < start || now - start >= limit) return 0;
+    previous = now;
+    return static_cast<std::uint32_t>(std::min<std::uint64_t>(kBackendSliceMs, (limit - (now - start)) / 1000));
+  }
+};
+struct Context {
+  explicit Context(std::unique_ptr<LibusbApi> a) : api(std::move(a)) {}
+  ~Context() { if (initialized) api->shutdown(); }
+  std::unique_ptr<LibusbApi> api;
+  std::mutex mutex;
+  bool initialized = false;
+};
+struct Lease {
+  std::shared_ptr<Context> context;
+  UsbHandle handle = 0;
+  std::uint64_t nonce = 0;
+  UsbDeviceInfo descriptor;
+  NativeUsbObservation observed;
+  bool claimed = false;
+  ~Lease() {
+    if (!handle) return;
+    std::lock_guard<std::mutex> lock(context->mutex);
+    if (claimed) context->api->release(handle, 0);
+    context->api->close(handle);
+  }
+};
+bool normal(const UsbDeviceInfo &d) {
+  return (d.vendor == 0xbbaa || d.vendor == 0x3801) && d.product == 0xddcc;
+}
+bool valid_descriptor(const UsbDeviceInfo &d) {
+  if (!d.id || !d.active_configuration_known || !d.serial_index ||
+      (d.bcd_device != 0x600 && d.bcd_device != 0x700) || d.alternates.empty() ||
+      d.alternates.size() > kUsbMaxAlternates) return false;
+  unsigned found = 0;
+  std::set<std::pair<unsigned, unsigned>> alternatives;
+  for (const auto &alt : d.alternates) {
+    if (!alternatives.insert({alt.interface_number, alt.alternate_setting}).second ||
+        alt.endpoints.size() > kUsbMaxEndpoints) return false;
+    std::set<unsigned> endpoints;
+    bool rx = false, tx = false;
+    for (const auto &ep : alt.endpoints) {
+      if (!endpoints.insert(ep.address).second) return false;
+      if (alt.interface_number == 0 && alt.alternate_setting == 0 &&
+          (ep.address == 0x81 || ep.address == 0x03)) {
+        if ((ep.attributes & 3) != 2 || ep.max_packet_size != 64) return false;
+        rx |= ep.address == 0x81; tx |= ep.address == 0x03;
+      }
+    }
+    if (alt.interface_number == 0 && alt.alternate_setting == 0) {
+      if (!rx || !tx) return false;
+      ++found;
+    }
+  }
+  return found == 1;
+}
+bool valid_serial(const std::string &s) {
+  return !s.empty() && s.size() <= 128 && std::all_of(s.begin(), s.end(), [](unsigned char c) { return c > 32 && c < 127; });
+}
+template<std::size_t N> bool uniform(const std::array<std::uint8_t, N> &bytes, std::uint8_t value) {
+  return std::all_of(bytes.begin(), bytes.end(), [=](auto b) { return b == value; });
+}
+Status probe(Lease &lease, const NativeUsbProbePolicy &policy, Budget &budget, NativeUsbObservation &observed) {
+  observed.lease_nonce = lease.nonce;
+  auto &api = *lease.context->api;
+  auto timeout = budget.slice();
+  if (!timeout) return Status::Timeout;
+  int result = api.serial(lease.handle, lease.descriptor.serial_index, observed.serial, timeout);
+  if (!budget.slice()) return Status::Timeout;
+  if (result != 0) return usb_error(result);
+  if (!valid_serial(observed.serial)) return Status::Poisoned;
+  auto read = [&](std::uint8_t request, std::uint8_t *bytes, std::size_t length) {
+    const auto slice = budget.slice();
+    if (!slice) return Status::Timeout;
+    // Immutable, exhaustive read-only discovery allowlist; no bulk, OUT,
+    // configuration, reset, clear-halt or bootstub traffic can reach this path.
+    if (request != 0xc3 && request != 0xc1 && request != 0xdd && request != 0xd3 && request != 0xd4 && request != 0xd5)
+      return Status::Invalid;
+    const int count = api.control(lease.handle, 0xc0, request, 0, 0, bytes, static_cast<std::uint16_t>(length), slice);
+    if (!budget.slice()) return Status::Timeout;
+    if (count < 0) return usb_error(count);
+    return count == static_cast<int>(length) ? Status::Ok : Status::Poisoned;
+  };
+  Status status = read(0xc3, observed.uid.data(), observed.uid.size());
+  if (status != Status::Ok) return status;
+  if (uniform(observed.uid, 0) || uniform(observed.uid, 0xff)) return Status::Poisoned;
+  status = read(0xc1, &observed.board_type, 1);
+  if (status != Status::Ok) return status;
+  if ((observed.board_type != 6 && observed.board_type != 7) ||
+      lease.descriptor.bcd_device != static_cast<std::uint16_t>(observed.board_type << 8)) return Status::Poisoned;
+  status = read(0xdd, observed.protocol.data(), observed.protocol.size());
+  if (status != Status::Ok) return status;
+  if (observed.protocol != kProtocol) return Status::Poisoned;
+  status = read(0xd3, observed.application_signature.data(), 64);
+  if (status != Status::Ok) return status;
+  status = read(0xd4, observed.application_signature.data() + 64, 64);
+  if (status != Status::Ok) return status;
+  if (uniform(observed.application_signature, 0) || uniform(observed.application_signature, 0xff)) return Status::Poisoned;
+  if (std::find(policy.f4_application_signatures.begin(), policy.f4_application_signatures.end(), observed.application_signature) !=
+      policy.f4_application_signatures.end()) {
+    if (observed.board_type != 6) return Status::Poisoned;
+    observed.f4_capabilities.resize(kF4CapabilityLength);
+    status = read(kF4CapabilityRequest, observed.f4_capabilities.data(), observed.f4_capabilities.size());
+    if (status != Status::Ok) return status;
+    if (!valid_f4_capabilities(observed.f4_capabilities)) return Status::Poisoned;
+  }
+  if (!budget.slice()) return Status::Timeout;
+  observed.observed_us = budget.previous;
+  return Status::Ok;
+}
+
+class NativeUsbBackend final : public Backend {
+public:
+  NativeUsbBackend(std::unique_ptr<Lease> lease, NativeUsbActivation grant) : lease_(std::move(lease)), grant_(grant) {}
+  void cancel() noexcept override { cancelled_.store(true); }
+  Result transact(const Request &request, std::uint32_t timeout_ms) override {
+    if (cancelled_.load()) return {Status::Cancelled, 0, {}};
+    if (!valid_request(request) || !timeout_ms || timeout_ms > kBackendSliceMs) return {Status::Invalid, 0, {}};
+    const bool read = is_read(request.kind);
+    if ((request.kind == Kind::BulkRead && request.endpoint != 0x81) ||
+        (request.kind == Kind::BulkWrite && (request.endpoint != 0x03 || !grant_.allow_can_tx))) return {Status::Invalid, 0, {}};
+    if (request.kind == Kind::ControlWrite) {
+      // Candidate writes remain noOutput/disengaged only. Permission is not
+      // authority to select a vehicle safety model, alternative experience,
+      // engaged heartbeat, arbitrary parameters or payload bytes.
+      const bool allowed_value =
+        (request.request == 0xdc && request.value == kNoOutputSafetyModel) ||
+        ((request.request == 0xdf || request.request == 0xf3) && request.value == 0) ||
+        (request.request == 0xb1 && request.value <= 100) ||
+        (request.request == 0xb0 && request.value <= 50);
+      if (!grant_.allow_control_writes || !allowed_value || request.index != 0 || !request.payload.empty())
+        return {Status::Invalid, 0, {}};
+    }
+    // These USB vendor IN codes have mutating firmware handlers despite IN
+    // direction. Never permit arbitrary controlRead to bypass write policy.
+    if (request.kind == Kind::ControlRead) {
+      const std::size_t expected = request.request == 0xc3 ? 12 : request.request == 0xc1 ? 1 :
+        request.request == 0xdd ? 8 : (request.request == 0xd3 || request.request == 0xd4 || request.request == 0xc2) ? 64 :
+        request.request == 0xd5 ? 16 : request.request == 0xd2 ? 48 : request.request == 0xb2 ? 2 : 0;
+      if (!expected || request.read_length != expected || request.index != 0 ||
+          (request.request == 0xc2 ? request.value >= 3 : request.value != 0)) return {Status::Invalid, 0, {}};
+    }
+    std::unique_lock<std::mutex> lock(lease_->context->mutex, std::try_to_lock);
+    if (!lock.owns_lock()) return {Status::Busy, 0, {}};
+    if (cancelled_.load()) return {Status::Cancelled, 0, {}};
+    if (poisoned_) return {Status::Poisoned, 0, {}};
+    const std::size_t length = read ? request.read_length : request.payload.size();
+    std::vector<std::uint8_t> data = read ? std::vector<std::uint8_t>(length) : request.payload;
+    int actual = 0, error = 0;
+    if (request.kind == Kind::ControlRead || request.kind == Kind::ControlWrite) {
+      const int count = lease_->context->api->control(lease_->handle, read ? 0xc0 : 0x40,
+        static_cast<std::uint8_t>(request.request), static_cast<std::uint16_t>(request.value),
+        static_cast<std::uint16_t>(request.index), data.data(), static_cast<std::uint16_t>(length), timeout_ms);
+      if (count < 0) {
+        poisoned_ = true;  // USB control errors have no confirmed partial count.
+        return {usb_error(count), 0, {}, false, !read};
+      }
+      else actual = count;
+    } else {
+      error = lease_->context->api->bulk(lease_->handle, static_cast<std::uint8_t>(request.endpoint),
+        data.data(), static_cast<int>(length), actual, timeout_ms);
+    }
+    if (error == kUsbOverflow || actual < 0 || static_cast<std::size_t>(actual) > length) {
+      poisoned_ = true;
+      return {Status::Poisoned, 0, {}, false, !read};
+    }
+    Status status = error == 0 ? (static_cast<std::size_t>(actual) == length ? Status::Ok : Status::Short) : usb_error(error);
+    if (error == kUsbNoDevice || error == kUsbPipe || error == kUsbIo) poisoned_ = true;
+    if (read) data.resize(actual); else data.clear();
+    return {status, static_cast<std::size_t>(actual), std::move(data), true, !read && status != Status::Ok};
+  }
+private:
+  std::unique_ptr<Lease> lease_;
+  NativeUsbActivation grant_;
+  std::atomic<bool> cancelled_{false};
+  bool poisoned_ = false;
+};
+}  // namespace
+
+bool operator==(const NativeUsbObservation &a, const NativeUsbObservation &b) {
+  return a.lease_nonce == b.lease_nonce && a.serial == b.serial && a.uid == b.uid && a.board_type == b.board_type && a.protocol == b.protocol &&
+    a.application_signature == b.application_signature && a.f4_capabilities == b.f4_capabilities;
+}
+struct NativeUsbInventory::Impl {
+  std::vector<std::unique_ptr<Lease>> leases;
+  std::vector<NativeUsbObservation> observations;
+  NativeUsbProbePolicy policy;
+  Status status = Status::Invalid;
+  std::string reason = "UNBOUND_OR_PERMISSION_DENIED";
+  bool complete = false;
+  void fail(Status value, const char *why) { complete = false; status = value; reason = why; leases.clear(); }
+};
+NativeUsbInventory::NativeUsbInventory() : impl_(std::make_unique<Impl>()) {}
+NativeUsbInventory::~NativeUsbInventory() = default;
+NativeUsbInventory::NativeUsbInventory(NativeUsbInventory &&) noexcept = default;
+NativeUsbInventory &NativeUsbInventory::operator=(NativeUsbInventory &&) noexcept = default;
+bool NativeUsbInventory::complete() const { return impl_ && impl_->complete; }
+Status NativeUsbInventory::status() const { return impl_ ? impl_->status : Status::Invalid; }
+std::string NativeUsbInventory::reason() const { return impl_ ? impl_->reason : "MOVED_INVENTORY"; }
+std::vector<NativeUsbObservation> NativeUsbInventory::observations() const { return impl_ ? impl_->observations : std::vector<NativeUsbObservation>{}; }
+
+NativeUsbInventory discover_native_usb(std::unique_ptr<LibusbApi> api, Clock &clock,
+                                      const NativeUsbProbePolicy &policy, bool allow_device_io) {
+  NativeUsbInventory result;
+  auto &out = *result.impl_;
+  if (!allow_device_io || !api || policy.expected_count == 0 || policy.expected_count > 2 ||
+      policy.budget_ms == 0 || policy.budget_ms > 100 || policy.f4_application_signatures.size() > 2) return result;
+  std::set<std::array<std::uint8_t, 128>> signatures;
+  for (const auto &s : policy.f4_application_signatures)
+    if (uniform(s, 0) || uniform(s, 0xff) || !signatures.insert(s).second) return result;
+  out.policy = policy;
+  auto context = std::make_shared<Context>(std::move(api));
+  Budget budget(clock, policy.budget_ms);
+  if (!budget.slice()) { out.fail(Status::Timeout, "DISCOVERY_DEADLINE"); return result; }
+  int error = context->api->initialize();
+  context->initialized = error == 0;
+  if (error != 0) { out.fail(usb_error(error), "INITIALIZE_FAILED"); return result; }
+  if (!budget.slice()) { out.fail(Status::Timeout, "DISCOVERY_DEADLINE"); return result; }
+  std::vector<UsbDeviceInfo> devices;
+  error = context->api->enumerate(devices);
+  if (!budget.slice()) { out.fail(Status::Timeout, "DISCOVERY_DEADLINE"); return result; }
+  if (error != 0) { out.fail(usb_error(error), "INCOMPLETE_INVENTORY"); return result; }
+  if (devices.size() > kUsbMaxInventoryDevices) { out.fail(Status::Poisoned, "INVENTORY_OVERFLOW"); return result; }
+  const auto count = std::count_if(devices.begin(), devices.end(), normal);
+  if (static_cast<std::size_t>(count) != policy.expected_count) { out.fail(Status::Poisoned, "UNEXPECTED_USB_INVENTORY"); return result; }
+  std::set<UsbDeviceId> ids;
+  std::set<std::string> serials;
+  std::set<std::array<std::uint8_t, 12>> uids;
+  for (const auto &d : devices) {
+    if (!normal(d)) continue;
+    if (!ids.insert(d.id).second || !valid_descriptor(d)) { out.fail(Status::Poisoned, "INVALID_DESCRIPTOR"); return result; }
+    if (!budget.slice()) { out.fail(Status::Timeout, "DISCOVERY_DEADLINE"); return result; }
+    auto lease = std::make_unique<Lease>(); lease->context = context; lease->descriptor = d;
+    error = context->api->open(d.id, lease->handle);
+    if (!budget.slice()) { out.fail(Status::Timeout, "DISCOVERY_DEADLINE"); return result; }
+    if (error != 0 || !lease->handle) { out.fail(error ? usb_error(error) : Status::IoError, "INACCESSIBLE_CANDIDATE"); return result; }
+    lease->nonce = allocate_native_lease_nonce();
+    if (!lease->nonce) { out.fail(Status::Poisoned, "LEASE_NONCE_EXHAUSTED"); return result; }
+    NativeUsbObservation observation;
+    const auto status = probe(*lease, policy, budget, observation);
+    if (status != Status::Ok) { out.fail(status, "IDENTITY_PROBE_FAILED"); return result; }
+    if (!serials.insert(observation.serial).second || !uids.insert(observation.uid).second) {
+      out.fail(Status::Poisoned, "DUPLICATE_SOFTWARE_IDENTITY"); return result;
+    }
+    lease->observed = observation;
+    out.observations.push_back(observation);
+    out.leases.push_back(std::move(lease));
+  }
+  out.complete = true; out.status = Status::Ok; out.reason = "OBSERVED_NOT_TRUSTED";
+  return result;
+}
+NativeUsbInventory discover_native_usb(Clock &clock, const NativeUsbProbePolicy &policy, bool allow_device_io) {
+  return discover_native_usb(make_native_libusb_api(), clock, policy, allow_device_io);
+}
+std::unique_ptr<Backend> NativeUsbInventory::activate(std::size_t index, const NativeUsbObservation &expected,
+                                                   const NativeUsbActivation &grant, Clock &clock,
+                                                   std::uint64_t *activation_observed_us) {
+  if (activation_observed_us) *activation_observed_us = 0;
+  if (!impl_ || !impl_->complete || index >= impl_->leases.size() || !impl_->leases[index]) return nullptr;
+  if (!grant.allow_device_io || !grant.profile_validated || !grant.bulk_alt0_verified ||
+      grant.lease_nonce == 0 || grant.lease_nonce != impl_->observations[index].lease_nonce ||
+      !(expected == impl_->observations[index])) {
+    impl_->fail(Status::Invalid, "ACTIVATION_EVIDENCE_MISSING"); return nullptr;
+  }
+  auto lease = std::move(impl_->leases[index]);
+  Budget budget(clock, impl_->policy.budget_ms);
+  if (!budget.slice()) { impl_->fail(Status::Timeout, "ACTIVATION_DEADLINE"); return nullptr; }
+  int error = lease->context->api->claim(lease->handle, 0);
+  lease->claimed = error == 0;
+  if (!budget.slice()) { impl_->fail(Status::Timeout, "ACTIVATION_DEADLINE"); return nullptr; }
+  if (error != 0) { impl_->fail(usb_error(error), "CLAIM_FAILED"); return nullptr; }
+  NativeUsbObservation current;
+  const auto status = probe(*lease, impl_->policy, budget, current);
+  if (status != Status::Ok || !(current == expected)) {
+    impl_->fail(status == Status::Ok ? Status::Poisoned : status, "ACTIVATION_IDENTITY_CHANGED"); return nullptr;
+  }
+  lease->observed = current;
+  auto backend = std::make_unique<NativeUsbBackend>(std::move(lease), grant);
+  if (activation_observed_us) *activation_observed_us = current.observed_us;
+  return backend;
+}
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_usb.h b/openpilot/selfdrive/pandad/compatibility/native_usb.h
new file mode 100644
index 0000000..8a44ccd
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_usb.h
@@ -0,0 +1,103 @@
