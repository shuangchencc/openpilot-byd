+  }
+  void release(UsbHandle, int n) override { CHECK(n == 0); ++state->released; }
+  void close(UsbHandle h) override { state->closed.push_back(h); }
+  void shutdown() override { ++state->shutdown; }
+private:
+  std::shared_ptr<State> state;
+};
