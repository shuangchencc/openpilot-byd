+}
+void wire_errors_no_retry_or_reopen() {
+  for (unsigned variant = 0; variant < 3; ++variant) {
+    Fixture f;
+    if (variant == 0) f.calls->fail_request = 0xc3;
+    if (variant == 1) f.calls->wrong_id = true;
+    if (variant == 2) f.calls->corrupt_crc = true;
