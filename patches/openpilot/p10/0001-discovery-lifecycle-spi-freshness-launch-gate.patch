+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+typedef struct { uint8_t request; uint16_t value, index, length; } __attribute__((packed)) ControlPacket_t;
+extern uint8_t oracle_uid[12];
+extern uint8_t hw_type;
+#define UID_BASE oracle_uid
