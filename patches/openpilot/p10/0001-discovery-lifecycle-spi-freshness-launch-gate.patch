+  std::unique_lock<std::mutex> guard(state_->mutex,std::try_to_lock);if(!guard.owns_lock() || state_->busy)return nullptr;
+  if(!state_->worker_started) {
+    std::size_t empty=0;if(!worker_lanes.compare_exchange_strong(empty,1))return nullptr;
+    try{std::thread worker([state=state_]{State::work(state);});worker.detach();state_->worker_started=true;}
+    catch(...){worker_lanes.fetch_sub(1);return nullptr;}
+  }
+  auto box=std::make_shared<Mailbox>();box->kind=r.kind;box->generation=r.generation;state_->pending=r;state_->pending_mailbox=box;state_->owner_mailbox=box;state_->busy=true;
+  state_->wake.notify_one();return std::make_unique<Task>(state_,std::move(box));
+}
+bool NativeDiscoveryExecutor::commit(const DiscoveryTaskRequest &r,DiscoveryTaskResult &result) {
+  if(getpid()!=state_->process || !allowed_ || state_->stop || state_->retire_requested || !state_->owner_mailbox)return false;
+  const auto box=state_->owner_mailbox;
+  if(box->cancelled || !box->consumed || box->committed || box->generation!=r.generation || box->kind!=r.kind || box->delivered_payload!=result.payload.get())return false;
+  // Every attempted delivery is single-use, including a rejected handoff.
+  box->committed=true;
+  if(result.generation!=r.generation || result.kind!=r.kind || result.snapshot.items.size()!=2 ||
+      result.snapshot.revision<=last_committed_revision_ || !result.snapshot.observed_us || !clock_)return false;
+  std::uint64_t now=0;try{now=clock_->now_us();}catch(...){return false;}
+  if(now>=r.deadline_us || result.snapshot.observed_us!=std::min(result.slot_observed_us[0],result.slot_observed_us[1]))return false;
+  for(const auto stamp:result.slot_observed_us)if(!stamp || stamp<r.started_us || stamp>now || now-stamp>=kLoopMaxGapUs)return false;
+  auto *handoff=dynamic_cast<NativeDiscoveryHandoff *>(result.payload.get());if(!handoff)return false;
+  try{SessionRegistry checked(handoff->profile);(void)checked;}catch(...){return false;}
+  if(handoff->profile.binding_status!="NATIVE_READ_ONLY_BOUND")return false;
+  std::array<DiscoveryItem,2> items;
+  for(unsigned slot=0;slot<2;++slot){const auto it=std::find_if(result.snapshot.items.begin(),result.snapshot.items.end(),[&](const auto &item){return item.identity==handoff->profile.slots[slot].expected;});
+    if(it==result.snapshot.items.end() || !handoff->ports[slot] || !handoff->ports[slot]->active())return false;items[slot]=*it;}
+  if(r.kind==DiscoveryTaskKind::Reprobe){if(committed_.items.size()!=2)return false;for(unsigned slot=0;slot<2;++slot)if(ports_[slot]!=handoff->ports[slot] || !same_item(committed_.items[slot],items[slot]))return false;}
+  else {if(!committed_.items.empty())return false;ports_=handoff->ports;opened_={};}
+  committed_=result.snapshot;committed_.items={items[0],items[1]};committed_profile_=handoff->profile;last_committed_revision_=result.snapshot.revision;return true;
+}
+void NativeDiscoveryExecutor::retire(const char *reason) noexcept {
+  if(getpid()!=state_->process)return;
+  if(!committed_.items.empty() || state_->busy){try{if(revoke_)revoke_(reason);}catch(...){/* still revoke all ports */}}
+  for(auto &p:ports_)if(p)p->cancel();ports_={};opened_={};committed_={};committed_profile_={};
+  if(state_->owner_mailbox)state_->owner_mailbox->cancelled=true;
+  if(state_->worker_started){state_->busy=true;state_->retire_requested=true;state_->wake.notify_one();}
+}
+std::unique_ptr<OwnedTransport> NativeDiscoveryExecutor::open(const DiscoveryItem &item,const SessionBinding &binding) {
+  if(getpid()!=state_->process || binding.slot>=2 || binding.safety_config_semantics!="noOutput" || committed_.items.size()!=2 || !clock_)return nullptr;
+  const auto slot=binding.slot;
+  if(opened_[slot] || !ports_[slot] || !ports_[slot]->active() || !(binding.expected==committed_profile_.slots[slot].expected) || !same_item(item,committed_.items[slot]))return nullptr;
+  const auto now=clock_->now_us();if(now<committed_.observed_us || now-committed_.observed_us>=kLoopMaxGapUs)return nullptr;
+  opened_[slot]=true;auto out=std::make_unique<OwnedTransport>();out->backend=std::make_unique<PortProxy>(ports_[slot],clock_);out->transport=std::make_unique<Transport>(*out->backend,*clock_);return out;
+}
+std::optional<SpiFreshnessProof> NativeDiscoveryExecutor::live_spi_proof(std::size_t slot) {
+  if(getpid()!=state_->process || slot>=2 || committed_.items.size()!=2 || !ports_[slot] || !ports_[slot]->active() || committed_.items[slot].identity.transport!="SPI")return std::nullopt;
+  std::uint64_t now=0;try{now=clock_->now_us();}catch(...){return std::nullopt;}
+  if(now<committed_.observed_us || now-committed_.observed_us>=kLoopMaxGapUs)return std::nullopt;
+  return ports_[slot]->live_spi_proof();
+}
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/native_discovery_executor.h b/openpilot/selfdrive/pandad/compatibility/native_discovery_executor.h
new file mode 100644
index 0000000..f4b8809
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/native_discovery_executor.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <functional>
+#include <optional>
+#include "discovery_scheduler.h"
+#include "native_binding.h"
+#include "spi_freshness.h"
+
+namespace openpilot::pandad::compatibility {
+
+// A port never owns a native fd/handle. Its destruction/cancellation only
+// changes local state. The engine exclusively owns and destroys the real I/O.
+class NativeDiscoveryPort : public Backend {
+public:
+  virtual std::optional<SpiFreshnessProof> live_spi_proof() = 0;
+  virtual bool active() const = 0;
+};
+struct NativeDiscoveryHandoff final : DiscoveryTaskPayload {
+  SessionProfile profile;
+  std::array<std::shared_ptr<NativeDiscoveryPort>,2> ports;
+};
+class NativeDiscoveryEngine {
+public:
+  virtual ~NativeDiscoveryEngine() = default;
+  // Only the one worker invokes these methods. execute may block in a native
+  // kernel call. Cancellation is cooperative and never kills that thread.
+  virtual DiscoveryTaskResult execute(const DiscoveryTaskRequest &, const std::atomic<bool> &cancelled) = 0;
+  virtual void retire() noexcept = 0;
+};
+struct NativeDiscoveryEngineConfig {
+  NativeBindingProfile profile;
+  NativeEvidenceVerifier physical_evidence;
+  std::function<bool(const NativeUsbObservation &)> usb_session_alt0;
+  std::function<bool(const NativeBoardBinding &)> spi_cooperative_ownership;
+  // Shared lifetime and safe concurrent reads are mandatory: the serialized
+  // owner and the worker may consult this clock at the same time.
+  std::shared_ptr<Clock> clock;
+  std::function<std::unique_ptr<LibusbApi>()> usb_api;
+  std::function<std::shared_ptr<NativeSpiSyscalls>()> spi_syscalls;
+  std::uint32_t spi_first_request_id = 1;
+  bool allow_read_only_device_io = false;
+};
+// Inert creation. Default-denied configuration does not construct native APIs,
+// enumerate, open or claim. The concrete engine uses the P9 implementations,
+// the P10 SPI freshness fence, and same-handle identity reprobes.
+std::unique_ptr<NativeDiscoveryEngine> make_native_discovery_engine(NativeDiscoveryEngineConfig);
+
+using NativeEpochRetirer = std::function<void(const char *)>;
+class NativeDiscoveryExecutor final : public DiscoveryTaskProvider, public DiscoveryCommitSink, public TransportFactory {
+public:
+  NativeDiscoveryExecutor(std::unique_ptr<NativeDiscoveryEngine>, std::shared_ptr<Clock>,
+                          NativeEpochRetirer = {}, bool allow_jobs = false);
+  ~NativeDiscoveryExecutor();
+  NativeDiscoveryExecutor(const NativeDiscoveryExecutor &)=delete;
+  NativeDiscoveryExecutor &operator=(const NativeDiscoveryExecutor &)=delete;
+  NativeDiscoveryExecutor(NativeDiscoveryExecutor &&)=delete;
+  NativeDiscoveryExecutor &operator=(NativeDiscoveryExecutor &&)=delete;
+  std::unique_ptr<DiscoveryTask> start(const DiscoveryTaskRequest &) override;
+  bool commit(const DiscoveryTaskRequest &, DiscoveryTaskResult &) override;
+  void retire(const char *) noexcept override;
+  std::unique_ptr<OwnedTransport> open(const DiscoveryItem &, const SessionBinding &) override;
+  // Reads the CURRENT owned live backend proof through a try-lock, never a
+  // saved admission receipt. The caller must compare it with current binding.
+  std::optional<SpiFreshnessProof> live_spi_proof(std::size_t slot);
+  // Process-wide lane cap also covers a destroyed executor with a stuck ioctl.
+  // This read-only diagnostic is used by offline lifecycle tests.
+  static std::size_t occupied_worker_lanes();
+private:
+  struct State;
+  class Task;
+  std::shared_ptr<State> state_;
+  std::shared_ptr<Clock> clock_;
+  NativeEpochRetirer revoke_;
+  bool allowed_ = false;
+  DiscoverySnapshot committed_;
+  SessionProfile committed_profile_;
+  std::array<std::shared_ptr<NativeDiscoveryPort>,2> ports_;
+  std::array<bool,2> opened_{};
+  std::uint64_t last_committed_revision_=0;
+};
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/production_gate.cc b/openpilot/selfdrive/pandad/compatibility/production_gate.cc
new file mode 100644
index 0000000..af39541
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/production_gate.cc
@@ -0,0 +1,181 @@
+#include "production_gate.h"
+
+#include <algorithm>
+#include <iostream>
+#include <set>
+
+namespace openpilot::pandad::compatibility {
+namespace {
+bool digest(const std::string &s) {
+  return s.size() == 64 && std::any_of(s.begin(), s.end(), [](char c) { return c != '0'; }) &&
+    std::all_of(s.begin(), s.end(), [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+}
+bool valid_purpose(LaunchPurpose p) {
+  return p >= LaunchPurpose::OfflineDiagnostics && p <= LaunchPurpose::Deployment;
+}
+void print_default_decision(const char *mode, const LaunchDecision &decision) {
+  std::cout << "{\"suite\":\"p10_production_main\",\"mode\":\"" << mode
+    << "\",\"entry\":\"" << mode
+    << "\",\"passed\":" << (std::string(mode) == "offline_check" ? 1 : 0)
+    << ",\"failed\":0,\"skipped\":0"
+    << ",\"ready_for_review\":false,\"profile_bound\":false,\"production_start_authorized\":false,"
+       "\"real_device_io\":false,\"device_access_authorized\":false,\"runtime_writes_authorized\":false,\"can_tx_authorized\":false,"
+       "\"deployment_authorized\":false,\"blockers\":[";
+  for (std::size_t i = 0; i < decision.blockers.size(); ++i) {
+    if (i) std::cout << ',';
+    std::cout << '"' << decision.blockers[i] << '"';
+  }
+  std::cout << ",\"PRODUCTION_AUTHORITY_AND_NATIVE_LAUNCHER_UNAVAILABLE\"]}\n";
+}
+}  // namespace
+
+const char *launch_requirement_name(LaunchRequirement r) {
+  switch (r) {
+    case LaunchRequirement::LockedRelease: return "LOCKED_RELEASE";
+    case LaunchRequirement::PhysicalIdentity: return "PHYSICAL_IDENTITY";
+    case LaunchRequirement::RecoveryChain: return "RECOVERY_CHAIN";
+    case LaunchRequirement::PowerAndTopology: return "POWER_AND_TOPOLOGY";
+    case LaunchRequirement::ExclusiveOwnership: return "EXCLUSIVE_OWNERSHIP";
+    case LaunchRequirement::UsbActiveInterface: return "USB_ACTIVE_INTERFACE";
+    case LaunchRequirement::SpiConfiguration: return "SPI_CONFIGURATION";
+    case LaunchRequirement::SpiCrossProcessFreshness: return "SPI_CROSS_PROCESS_FRESHNESS";
+    case LaunchRequirement::DiscoveryScheduling: return "DISCOVERY_SCHEDULING";
+    case LaunchRequirement::KernelIoDeadline: return "KERNEL_IO_DEADLINE";
+    case LaunchRequirement::ResourceBudget: return "RESOURCE_BUDGET";
+    case LaunchRequirement::GroupHealthSafety: return "GROUP_HEALTH_SAFETY";
+    case LaunchRequirement::HeartbeatAndShutdown: return "HEARTBEAT_AND_SHUTDOWN";
+    case LaunchRequirement::PeripheralRoles: return "PERIPHERAL_ROLES";
+    case LaunchRequirement::DriverMonitoring: return "DRIVER_MONITORING";
+    case LaunchRequirement::AudibleAlerts: return "AUDIBLE_ALERTS";
+    case LaunchRequirement::VehicleSignals: return "VEHICLE_SIGNALS";
+    case LaunchRequirement::VehicleController: return "VEHICLE_CONTROLLER";
+    case LaunchRequirement::IndependentPandaSafety: return "INDEPENDENT_PANDA_SAFETY";
+    case LaunchRequirement::ClosedCourse: return "CLOSED_COURSE";
+    case LaunchRequirement::InstallationAndRollback: return "INSTALLATION_AND_ROLLBACK";
+  }
+  return "INVALID_REQUIREMENT";
+}
+const char *launch_purpose_name(LaunchPurpose p) {
+  switch (p) {
+    case LaunchPurpose::OfflineDiagnostics: return "offline_diagnostics";
+    case LaunchPurpose::NativeReadOnly: return "native_read_only";
+    case LaunchPurpose::NativeNoOutputRuntime: return "native_no_output_runtime";
+    case LaunchPurpose::VehicleControl: return "vehicle_control";
+    case LaunchPurpose::Deployment: return "deployment";
+  }
+  return "invalid";
+}
+std::vector<LaunchRequirement> required_launch_evidence(LaunchPurpose purpose, bool usb, bool spi) {
+  if (!valid_purpose(purpose) || purpose == LaunchPurpose::OfflineDiagnostics) return {};
+  using R = LaunchRequirement;
+  std::vector<R> out{R::LockedRelease, R::PhysicalIdentity, R::RecoveryChain, R::PowerAndTopology,
+                     R::ExclusiveOwnership, R::PeripheralRoles, R::DiscoveryScheduling, R::KernelIoDeadline};
+  if (usb) out.push_back(R::UsbActiveInterface);
+  if (spi) { out.push_back(R::SpiConfiguration); out.push_back(R::SpiCrossProcessFreshness); }
+  if (purpose >= LaunchPurpose::NativeNoOutputRuntime) {
+    for (auto r : {R::ResourceBudget, R::GroupHealthSafety,
+                   R::HeartbeatAndShutdown}) out.push_back(r);
+  }
+  if (purpose >= LaunchPurpose::VehicleControl) {
+    for (auto r : {R::DriverMonitoring, R::AudibleAlerts, R::VehicleSignals, R::VehicleController,
+                   R::IndependentPandaSafety, R::ClosedCourse}) out.push_back(r);
+  }
+  if (purpose == LaunchPurpose::Deployment) out.push_back(R::InstallationAndRollback);
+  return out;
+}
+
+LaunchDecision evaluate_production_gate(const LaunchRequest &request, const NativeEvidenceVerifier &physical,
+                                       const LaunchEvidenceVerifier &verify, const LiveSpiProofReader &live_spi) {
+  LaunchDecision out;
+  if (!valid_purpose(request.purpose)) { out.blockers.push_back("INVALID_PURPOSE"); return out; }
+  // Pure offline diagnostics need neither profile nor attestation. This only
+  // approves the review operation; every authority field stays false.
+  if (request.purpose == LaunchPurpose::OfflineDiagnostics) { out.ready_for_review = true; return out; }
+  if (request.observations.size() > 2 || request.evidence.size() > kLaunchEvidenceLimit) {
+    out.blockers.push_back("INPUT_CAPACITY_EXCEEDED"); return out;
+  }
+  const auto binding = validate_native_binding(request.profile, request.observations, physical);
+  out.profile_bound = binding.bound;
+  if (!binding.bound) out.blockers.push_back("PROFILE_UNBOUND:" + binding.reason);
+  if (!digest(request.release_chain_sha256)) out.blockers.push_back("RELEASE_CHAIN_INVALID");
+  if (!request.process_epoch || !request.discovery_revision) out.blockers.push_back("SESSION_CONTEXT_MISSING");
+  bool fresh = request.now_us && request.observations.size() == 2;
+  bool usb = false, spi = false;
+  for (const auto &board : request.observations) {
+    usb |= board.transport == "USB";
+    spi |= board.transport == "SPI";
+    fresh &= board.raw.observed_us && board.raw.observed_us <= request.now_us &&
+             request.now_us - board.raw.observed_us < kLoopMaxGapUs;
+  }
+  if (!fresh) out.blockers.push_back("COMPLETE_PROBE_NOT_FRESH");
+  const LaunchEvidenceContext context{request, binding};
+  if (binding.bound && out.blockers.empty()) {
+    for (std::size_t slot = 0; slot < binding.observations.size(); ++slot) {
+      const auto &board = binding.observations[slot];
+      if (board.transport != "SPI") continue;
+      std::optional<SpiFreshnessProof> current;
+      try { if (live_spi) current = live_spi(slot, context); } catch (...) { current.reset(); }
+      const auto proof = current.value_or(SpiFreshnessProof{});
+      if (!proof.synchronized || !proof.same_fd_lifetime_lock || !proof.first_fence_id ||
+          !proof.second_fence_id || proof.first_fence_id == proof.second_fence_id ||
+          !proof.completed_us || proof.completed_us > board.raw.observed_us ||
+          proof.completed_us > request.now_us ||
+          proof.expected_uid != board.raw.uid || proof.lease_nonce != board.raw.lease_nonce) {
+        out.blockers.push_back("LIVE_SPI_FRESHNESS_PROOF_REQUIRED:" + std::to_string(slot));
+      }
+    }
+  }
+  if (!out.blockers.empty()) {
+    // Still enumerate unresolved hardware gates for a useful UNBOUND report;
+    // never invoke evidence verifiers against an invalid/unbound context.
+    const auto diagnostic = required_launch_evidence(request.purpose, usb || !binding.bound, spi || !binding.bound);
+    for (auto requirement : diagnostic) {
+      out.blockers.push_back("EVIDENCE_NOT_EVALUATED:" + std::string(launch_requirement_name(requirement)));
+    }
+    return out;
+  }
+  const auto required = required_launch_evidence(request.purpose, usb, spi);
+  std::set<LaunchRequirement> seen;
+  for (const auto &evidence : request.evidence) {
+    if (std::find(required.begin(), required.end(), evidence.requirement) == required.end()) {
+      out.blockers.push_back("UNEXPECTED_EVIDENCE"); return out;
+    }
+    if (!seen.insert(evidence.requirement).second) {
+      out.blockers.push_back("DUPLICATE_EVIDENCE"); return out;
+    }
+  }
+  for (auto requirement : required) {
+    const auto found = std::find_if(request.evidence.begin(), request.evidence.end(),
+                                   [&](const auto &e) { return e.requirement == requirement; });
+    const auto name = std::string(launch_requirement_name(requirement));
+    if (found == request.evidence.end()) { out.blockers.push_back("EVIDENCE_MISSING:" + name); continue; }
+    if (!digest(found->content_sha256) || !found->attested_us || found->attested_us > request.now_us ||
+        request.now_us - found->attested_us >= kLaunchAttestationMaxAgeUs ||
+        found->expires_us <= request.now_us || found->expires_us <= found->attested_us ||
+        found->expires_us - found->attested_us > kLaunchAttestationMaxAgeUs) {
+      out.blockers.push_back("EVIDENCE_INVALID_OR_EXPIRED:" + name); continue;
+    }
+    bool accepted = false;
+    try { accepted = verify && verify(*found, context); } catch (...) { accepted = false; }
+    if (!accepted) { out.blockers.push_back("EVIDENCE_NOT_VERIFIED:" + name); continue; }
+    out.verified_requirements.push_back(requirement);
+  }
+  out.ready_for_review = out.blockers.empty();
+  return out;
+}
+
+int pandad_production_check_offline_main() {
+  const auto decision = evaluate_production_gate(LaunchRequest{});
+  if (decision.ready_for_review || decision.profile_bound || decision.production_start_authorized ||
+      decision.device_access_authorized || decision.runtime_writes_authorized || decision.can_tx_authorized ||
+      decision.deployment_authorized || decision.blockers.empty()) return 1;
+  std::cout << "PASS p10_main_production_check_defaults_blocked\n";
+  print_default_decision("offline_check", decision);
+  return 0;
+}
+int pandad_production_start_denied_main() {
+  print_default_decision("production_denied", evaluate_production_gate(LaunchRequest{}));
+  return 3;
+}
+
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/production_gate.h b/openpilot/selfdrive/pandad/compatibility/production_gate.h
new file mode 100644
index 0000000..693a728
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/production_gate.h
@@ -0,0 +1,85 @@
+#pragma once
+
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "native_binding.h"
+#include "spi_freshness.h"
+
+namespace openpilot::pandad::compatibility {
+
+// A review purpose is not a permission. In particular, passing this pure
+// evaluator cannot open a device, construct a write-capable provider, or install
+// software. P10 ships no production authority or production native launcher.
+enum class LaunchPurpose { OfflineDiagnostics, NativeReadOnly, NativeNoOutputRuntime, VehicleControl, Deployment };
+enum class LaunchRequirement {
+  LockedRelease, PhysicalIdentity, RecoveryChain, PowerAndTopology,
+  ExclusiveOwnership, UsbActiveInterface, SpiConfiguration, SpiCrossProcessFreshness,
+  DiscoveryScheduling, KernelIoDeadline, ResourceBudget, GroupHealthSafety,
+  HeartbeatAndShutdown, PeripheralRoles, DriverMonitoring, AudibleAlerts,
+  VehicleSignals, VehicleController, IndependentPandaSafety, ClosedCourse,
+  InstallationAndRollback,
+};
+const char *launch_requirement_name(LaunchRequirement);
+const char *launch_purpose_name(LaunchPurpose);
+
+struct LaunchEvidence {
+  LaunchRequirement requirement = LaunchRequirement::LockedRelease;
+  std::string content_sha256;
+  // A verifier may re-attest historical physical evidence for this current
+  // session. These are attestation times, not a rewrite of acquisition time.
+  std::uint64_t attested_us = 0;
+  std::uint64_t expires_us = 0;
+};
+struct LaunchRequest {
+  LaunchPurpose purpose = LaunchPurpose::Deployment;
+  NativeBindingProfile profile;
+  std::vector<NativeObservedBoard> observations;
+  std::string release_chain_sha256;
+  std::uint64_t process_epoch = 0;
+  std::uint64_t discovery_revision = 0;
+  std::uint64_t now_us = 0;
+  std::vector<LaunchEvidence> evidence;
+};
+struct LaunchEvidenceContext {
+  const LaunchRequest &request;
+  const NativeBindingResult &binding;
+};
+// Must inspect referenced evidence and match the complete current context,
+// including identities, MCU/capabilities/roles, application signatures, lock,
+// process epoch, discovery revision and retained leases. A JSON boolean/hash,
+// an offline test receipt, or caller-supplied timestamps are not verification.
+// This callback is injected for offline tests. No production verifier ships.
+using LaunchEvidenceVerifier = std::function<bool(const LaunchEvidence &, const LaunchEvidenceContext &)>;
+// The serialized executor supplies a current proof() from its owned live SPI
+// backend, matching the requested fixed slot and context. Do not load a saved
+// proof from JSON or cache this callback's result across evaluations/handoff.
+// No default reader exists. A readiness result is only about this invocation;
+// post-handoff production admission/revocation is not implemented by this API.
+using LiveSpiProofReader = std::function<std::optional<SpiFreshnessProof>(std::size_t, const LaunchEvidenceContext &)>;
+struct LaunchDecision {
+  bool ready_for_review = false;
+  bool profile_bound = false;
+  // These remain false in every P10 evaluation, including fully injected tests.
+  bool device_access_authorized = false;
+  bool runtime_writes_authorized = false;
+  bool can_tx_authorized = false;
+  bool deployment_authorized = false;
+  bool production_start_authorized = false;
+  std::vector<std::string> blockers;
+  std::vector<LaunchRequirement> verified_requirements;
+};
+inline constexpr std::size_t kLaunchEvidenceLimit = 21;
+inline constexpr std::uint64_t kLaunchAttestationMaxAgeUs = 1000000;
+std::vector<LaunchRequirement> required_launch_evidence(LaunchPurpose, bool has_usb, bool has_spi);
+LaunchDecision evaluate_production_gate(const LaunchRequest &, const NativeEvidenceVerifier & = {},
+                                       const LaunchEvidenceVerifier & = {}, const LiveSpiProofReader & = {});
+
+// Called only before hardware setup. Both use the built-in UNBOUND profile;
+// neither reads a config/environment/file nor constructs an I/O provider.
+int pandad_production_check_offline_main();
+int pandad_production_start_denied_main();
+
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/spi_freshness.cc b/openpilot/selfdrive/pandad/compatibility/spi_freshness.cc
new file mode 100644
index 0000000..7350b54
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/spi_freshness.cc
@@ -0,0 +1,248 @@
+#include "spi_freshness.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <unistd.h>
+#include <limits>
+#include <set>
+
+#include "firmware_capabilities.h"
+
+namespace openpilot::pandad::compatibility {
+namespace {
+using Bytes = std::vector<std::uint8_t>;
+constexpr std::array<std::uint8_t, 8> kProtocol{{0xf5, 0x12, 0xbc, 0xff, 0x76, 0xf2, 0xab, 0x75}};
+template<std::size_t N> bool uniform(const std::array<std::uint8_t, N> &data, std::uint8_t byte) {
+  return std::all_of(data.begin(), data.end(), [=](auto x) { return x == byte; });
+}
+Request read_request(std::uint8_t command, std::size_t length) {
+  Request request; request.kind = Kind::ControlRead; request.request = command; request.read_length = length; return request;
+}
+bool read_only_allowed(const Request &request, bool f4) {
+  if (!valid_request(request)) return false;
+  if (request.kind == Kind::BulkRead) return request.endpoint == 0x81;
+  if (request.kind != Kind::ControlRead || request.index != 0) return false;
+  const std::size_t expected = request.request == 0xc3 ? 12 : request.request == 0xc1 ? 1 :
+    request.request == 0xdd ? 8 : (request.request == 0xd3 || request.request == 0xd4 || request.request == 0xc2) ? 64 :
+    request.request == 0xd5 && f4 ? 16 : request.request == 0xd2 ? 48 : request.request == 0xb2 ? 2 : 0;
+  return expected && request.read_length == expected && (request.request == 0xc2 ? request.value < 3 : request.value == 0);
+}
+// flock belongs to an open-file description shared across fork. A child must
+// neither use the inherited session nor unlock its parent's description during
+// destruction. Closing only its inherited descriptor preserves the parent's
+// lock; CLOEXEC handles exec separately. No child read/write/open is forwarded.
+class ProcessBoundSyscalls final : public NativeSpiSyscalls {
+public:
+  explicit ProcessBoundSyscalls(std::shared_ptr<NativeSpiSyscalls> calls)
+      : calls_(std::move(calls)), owner_(::getpid()) {}
+  bool owner() const { return owner_ == ::getpid(); }
+  NativeSpiCall open_device(const std::string &path, int flags) override { return owner() && calls_ ? calls_->open_device(path, flags) : denied(); }
+  NativeSpiCall stat_device(int fd, NativeSpiNode &node) override { return owner() && calls_ ? calls_->stat_device(fd, node) : denied(); }
+  NativeSpiCall read_mode(int fd, std::uint32_t &mode) override { return owner() && calls_ ? calls_->read_mode(fd, mode) : denied(); }
+  NativeSpiCall read_bits(int fd, std::uint8_t &bits) override { return owner() && calls_ ? calls_->read_bits(fd, bits) : denied(); }
+  NativeSpiCall read_speed(int fd, std::uint32_t &speed) override { return owner() && calls_ ? calls_->read_speed(fd, speed) : denied(); }
+  NativeSpiCall lock_device(int fd, bool acquire) override {
+    if (!owner()) return acquire ? denied() : NativeSpiCall{0, 0};
+    return calls_ ? calls_->lock_device(fd, acquire) : denied();
+  }
+  NativeSpiCall message(int fd, const std::uint8_t *tx, std::uint8_t *rx, std::size_t bytes) override {
+    return owner() && calls_ ? calls_->message(fd, tx, rx, bytes) : denied();
+  }
+  NativeSpiCall close_device(int fd) override { return calls_ ? calls_->close_device(fd) : denied(); }
+private:
+  static NativeSpiCall denied() { return {-1, EPERM}; }
+  std::shared_ptr<NativeSpiSyscalls> calls_;
+  pid_t owner_;
+};
+// Owns the native descriptor and the OS lock for its entire active lifetime.
+// SpiBackend's per-request begin/end operates only the local transaction flag.
+class SessionIo final : public SpiIo {
+public:
+  SessionIo(std::shared_ptr<NativeSpiSyscalls> calls, Clock &clock)
+      : calls_(std::make_shared<ProcessBoundSyscalls>(std::move(calls))), native_(calls_, clock) {}
+  Status activate(const NativeSpiSelector &selector) {
+    auto status = native_.activate(selector, NativeSpiActivation::VerifiedProfile);
+    if (status == Status::Ok) status = native_.begin(kBackendSliceMs);
+    held_ = status == Status::Ok;
+    return status;
+  }
+  Status begin(std::uint32_t timeout_ms) override {
+    if (!calls_->owner() || !held_ || !native_.active()) return Status::Disconnected;
+    if (!timeout_ms || timeout_ms > kBackendSliceMs) return Status::Invalid;
+    if (transaction_) return Status::Busy;
+    transaction_ = true; return Status::Ok;
+  }
+  void end() noexcept override { transaction_ = false; }
+  void cancel() noexcept override { native_.cancel(); }
+  Result exchange(const Bytes &tx, std::uint32_t timeout_ms) override {
+    if (!held_ || !transaction_) return {Status::Invalid, 0, {}};
+    return native_.exchange(tx, timeout_ms);
+  }
+  bool active() const { return calls_->owner() && held_ && native_.active(); }
+  bool owning_process() const { return calls_->owner(); }
+private:
+  std::shared_ptr<ProcessBoundSyscalls> calls_;
+  NativeSpiIo native_;
+  bool held_ = false, transaction_ = false;
+};
+}  // namespace
+
+class SpiFreshnessBackend::Impl {
+public:
+  Impl(std::shared_ptr<NativeSpiSyscalls> calls, Clock &clock) : io(std::move(calls), clock), clock(clock) {}
+  SessionIo io;
+  Clock &clock;
+  std::unique_ptr<SpiBackend> backend;
+  SpiFreshnessProof evidence;
+  std::atomic<bool> cancelled{false};
+  bool attempted = false, poisoned = false, f4 = false;
+  std::uint64_t last_time = 0;
+  bool time_valid() {
+    const auto now = clock.now_us();
+    if (now < last_time) { poisoned = true; return false; }
+    last_time = now; return true;
+  }
+};
+SpiFreshnessBackend::SpiFreshnessBackend(std::shared_ptr<NativeSpiSyscalls> calls, Clock &clock)
+    : impl_(std::make_unique<Impl>(std::move(calls), clock)) {}
+SpiFreshnessBackend::~SpiFreshnessBackend() = default;
+void SpiFreshnessBackend::cancel() noexcept { impl_->cancelled.store(true); impl_->io.cancel(); }
+void SpiFreshnessBackend::permit_f4_read() { impl_->f4 = true; }
+SpiFreshnessProof SpiFreshnessBackend::proof() const {
+  auto proof = impl_->evidence;
+  proof.synchronized = proof.synchronized && !impl_->cancelled.load() && !impl_->poisoned && impl_->io.active();
+  proof.same_fd_lifetime_lock = proof.synchronized;
+  return proof;
+}
+Status SpiFreshnessBackend::activate(const NativeSpiSelector &selector,
+    const std::array<std::uint8_t, 12> &expected_uid, std::uint32_t first_id, std::uint32_t budget_ms,
+    bool cooperative_ownership_verified, bool allow_device_io) {
+  auto &state = *impl_;
+  if (state.cancelled.load()) return Status::Cancelled;
+  if (!state.io.owning_process() || state.attempted || !cooperative_ownership_verified || !allow_device_io || !first_id ||
+      first_id > std::numeric_limits<std::uint32_t>::max() - 2 || !budget_ms || budget_ms > kMaxTransportTimeoutMs ||
+      !valid_native_spi_selector(selector) || *selector.expected_mode != 0 || *selector.expected_bits_per_word != 8 ||
+      *selector.expected_max_speed_hz > 50000000 || uniform(expected_uid, 0) || uniform(expected_uid, 0xff)) return Status::Invalid;
+  state.attempted = true;
+  const auto start = state.clock.now_us(); state.last_time = start;
+  auto remaining = [&]() -> std::uint32_t {
+    if (!state.time_valid() || state.cancelled.load()) return 0;
+    const auto elapsed = state.last_time - start;
+    return elapsed >= static_cast<std::uint64_t>(budget_ms) * 1000 ? 0 :
+      static_cast<std::uint32_t>(std::min<std::uint64_t>(kBackendSliceMs, (static_cast<std::uint64_t>(budget_ms) * 1000 - elapsed) / 1000));
+  };
+  auto fail = [&](Status status) { state.poisoned = true; state.io.cancel(); return status; };
+  auto expired = [&] { return state.cancelled.load() ? Status::Cancelled : state.poisoned ? Status::IoError : Status::Timeout; };
+  if (!remaining()) return fail(expired());
+  auto status = state.io.activate(selector);
+  if (status != Status::Ok) return fail(status);
+  auto timeout = remaining(); if (!timeout) return fail(expired());
+  status = state.io.begin(timeout); if (status != Status::Ok) return fail(status);
+  // In the locked firmware a queued response is consumed at this CS edge. If
+  // ready instead, all-ff is invalid: advertised tx_len=65535 cannot fit 4096.
+  // This also drains a partial response left by a crashed predecessor. It never
+  // invokes an endpoint or replays a possibly mutating preceding request.
+  const auto drained = state.io.exchange(Bytes(kSpiBufferBytes, 0xff), timeout);
+  state.io.end();
+  if (drained.status != Status::Ok || !drained.actual_known || drained.delivery_uncertain ||
+      drained.actual != kSpiBufferBytes || drained.data.size() != kSpiBufferBytes)
+    return fail(drained.status == Status::Ok || drained.status == Status::Short ? Status::IoError : drained.status);
+  state.backend = std::make_unique<SpiBackend>(state.io, state.clock, first_id);
+  for (unsigned fence = 0; fence < 2; ++fence) {
+    timeout = remaining(); if (!timeout) return fail(expired());
+    const auto result = state.backend->transact(read_request(0xc3, expected_uid.size()), timeout);
+    if (result.status != Status::Ok || !result.actual_known || result.delivery_uncertain ||
+        result.actual != expected_uid.size() || result.data.size() != expected_uid.size() ||
+        !std::equal(result.data.begin(), result.data.end(), expected_uid.begin()))
+      return fail(result.status == Status::Ok || result.status == Status::Short ? Status::IoError : result.status);
+  }
+  if (!remaining()) return fail(expired());
+  // The first complete response proves the most recent handled id is first_id.
+  // Hence second_id differs, and cannot hit the one-entry response cache. Every
+  // later id is unique in this still-locked session; SpiBackend refuses wrap.
+  const auto nonce = allocate_native_lease_nonce();
+  if (!nonce) return fail(Status::Poisoned);
+  state.evidence = {true, true, false, first_id, first_id + 1, state.last_time, nonce, expected_uid};
+  return Status::Ok;
+}
+Result SpiFreshnessBackend::transact(const Request &request, std::uint32_t timeout_ms) {
+  auto &state = *impl_;
+  if (!state.io.owning_process()) return {Status::Poisoned, 0, {}};
+  if (state.cancelled.load()) return {Status::Cancelled, 0, {}};
+  if (!read_only_allowed(request, state.f4) || !timeout_ms || timeout_ms > kBackendSliceMs) return {Status::Invalid, 0, {}};
+  if (!state.evidence.synchronized || state.poisoned || !state.io.active()) return {Status::Poisoned, 0, {}};
+  if (!state.time_valid()) return {Status::IoError, 0, {}};
+  auto result = state.backend->transact(request, timeout_ms);
+  if (!state.time_valid() || !state.io.active()) result.status = state.cancelled.load() ? Status::Cancelled : Status::IoError;
+  if (result.status != Status::Ok && result.status != Status::Short) state.poisoned = true;
+  return result;
+}
+
+FreshNativeSpiProbeResult discover_fresh_native_spi(std::shared_ptr<NativeSpiSyscalls> calls, Clock &clock,
+    const NativeSpiProbePolicy &policy, const std::array<std::uint8_t, 12> &expected_uid,
+    bool cooperative_ownership_verified, bool allow_device_io) {
+  FreshNativeSpiProbeResult result;
+  if (!calls || !cooperative_ownership_verified || !allow_device_io || policy.f4_application_signatures.size() > 2 ||
+      !policy.first_request_id || policy.first_request_id > std::numeric_limits<std::uint32_t>::max() - 7 ||
+      !policy.budget_ms || policy.budget_ms > kMaxTransportTimeoutMs) return result;
+  std::set<std::array<std::uint8_t, 128>> signatures;
+  for (const auto &signature : policy.f4_application_signatures)
+    if (uniform(signature, 0) || uniform(signature, 0xff) || !signatures.insert(signature).second) return result;
+  const auto start = clock.now_us(); auto previous = start;
+  bool clock_fault = false;
+  auto remaining = [&]() -> std::uint32_t {
+    const auto now = clock.now_us(); if (now < previous) { clock_fault = true; return 0; } previous = now;
+    const auto elapsed = now - start, budget = static_cast<std::uint64_t>(policy.budget_ms) * 1000;
+    return elapsed >= budget ? 0 : static_cast<std::uint32_t>((budget - elapsed) / 1000);
+  };
+  auto failed = [](Status status, const std::string &reason) {
+    FreshNativeSpiProbeResult failed; failed.probe.status = status; failed.probe.reason = reason; return failed;
+  };
+  auto backend = std::make_unique<SpiFreshnessBackend>(std::move(calls), clock);
+  auto status = backend->activate(policy.selector, expected_uid, policy.first_request_id, policy.budget_ms,
+                                  cooperative_ownership_verified, allow_device_io);
+  if (status != Status::Ok) return failed(status, "SPI_FRESHNESS_FENCE_FAILED");
+  auto *fresh = backend.get();
+  auto owner = std::make_unique<OwnedTransport>(); owner->backend = std::move(backend);
+  owner->transport = std::make_unique<Transport>(*owner->backend, clock);
+  NativeUsbObservation observed; observed.lease_nonce = fresh->proof().lease_nonce;
+  if (!observed.lease_nonce) return failed(Status::Poisoned, "LEASE_NONCE_EXHAUSTED");
+  auto read = [&](std::uint8_t command, std::uint8_t *data, std::size_t length) {
+    const auto timeout = remaining(); if (!timeout) return clock_fault ? Status::IoError : Status::Timeout;
+    const auto reply = owner->transport->perform(read_request(command, length), timeout);
+    if (!remaining()) return clock_fault ? Status::IoError : Status::Timeout;
+    if (reply.status != Status::Ok || !reply.actual_known || reply.delivery_uncertain || reply.actual != length || reply.data.size() != length)
+      return reply.status == Status::Ok || reply.status == Status::Short ? Status::Poisoned : reply.status;
+    std::copy(reply.data.begin(), reply.data.end(), data); return Status::Ok;
+  };
+  status = read(0xc3, observed.uid.data(), observed.uid.size());
+  if (status != Status::Ok || observed.uid != expected_uid) return failed(status == Status::Ok ? Status::Poisoned : status, "UID_PROBE_FAILED");
+  status = read(0xc1, &observed.board_type, 1);
+  if (status != Status::Ok || (observed.board_type != 6 && observed.board_type != 7)) return failed(status == Status::Ok ? Status::Poisoned : status, "BOARD_TYPE_PROBE_FAILED");
+  status = read(0xdd, observed.protocol.data(), observed.protocol.size());
+  if (status != Status::Ok || observed.protocol != kProtocol) return failed(status == Status::Ok ? Status::Poisoned : status, "PROTOCOL_PROBE_FAILED");
+  status = read(0xd3, observed.application_signature.data(), 64);
+  if (status != Status::Ok) return failed(status, "SIGNATURE_FIRST_PROBE_FAILED");
+  status = read(0xd4, observed.application_signature.data() + 64, 64);
+  if (status != Status::Ok || uniform(observed.application_signature, 0) || uniform(observed.application_signature, 0xff))
+    return failed(status == Status::Ok ? Status::Poisoned : status, "SIGNATURE_SECOND_PROBE_FAILED");
+  if (signatures.count(observed.application_signature)) {
+    if (observed.board_type != 6) return failed(Status::Poisoned, "F4_SIGNATURE_BOARD_CONFLICT");
+    fresh->permit_f4_read(); observed.f4_capabilities.resize(kF4CapabilityLength);
+    status = read(kF4CapabilityRequest, observed.f4_capabilities.data(), observed.f4_capabilities.size());
+    if (status != Status::Ok || !valid_f4_capabilities(observed.f4_capabilities))
+      return failed(status == Status::Ok ? Status::Poisoned : status, "F4_CAPABILITY_PROBE_FAILED");
+  }
+  result.freshness = fresh->proof();
+  if (!remaining() || !result.freshness.synchronized) return failed(clock_fault ? Status::IoError : Status::Timeout, "PROBE_CLOCK_OR_DEADLINE");
+  result.probe.status = Status::Ok; result.probe.reason = "FENCED_READ_ONLY_SPI_OBSERVATION_RETAINED";
+  observed.observed_us = previous;
+  result.probe.observation = std::move(observed); result.probe.validated_selector = policy.selector;
+  result.probe.first_request_id = policy.first_request_id; result.probe.started_us = start; result.probe.completed_us = previous;
+  result.probe.transport = std::move(owner); return result;
+}
+FreshNativeSpiProbeResult discover_fresh_native_spi(Clock &clock, const NativeSpiProbePolicy &policy,
+    const std::array<std::uint8_t, 12> &expected_uid, bool cooperative_ownership_verified, bool allow_device_io) {
+  return discover_fresh_native_spi(make_linux_spi_syscalls(), clock, policy, expected_uid, cooperative_ownership_verified, allow_device_io);
+}
+}  // namespace openpilot::pandad::compatibility
