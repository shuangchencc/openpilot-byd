+    if(getpid()!=process_ || cancelled_ || !port_->active()) return {Status::Cancelled,0,{},true,false};
+    if(!read_only(r,timeout)) return {Status::Invalid,0,{},true,false};
+    return port_->transact(r,timeout);
+  }
