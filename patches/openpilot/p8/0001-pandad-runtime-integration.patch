diff --git a/openpilot/selfdrive/pandad/compatibility/realtime_bridge.cc b/openpilot/selfdrive/pandad/compatibility/realtime_bridge.cc
new file mode 100644
index 0000000..7703d3b
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/realtime_bridge.cc
@@ -0,0 +1,64 @@
+#include "realtime_bridge.h"
+#include <cstring>
+#include <stdexcept>
+#include <capnp/message.h>
+#include <capnp/serialize.h>
+#include "openpilot/cereal/gen/cpp/log.capnp.h"
+namespace openpilot::pandad::compatibility {
+namespace {
+bool same(InputEpoch a,InputEpoch b) { return a.generation==b.generation && a.control_epoch==b.control_epoch; }
+void inspect(const MessageBytes &bytes,const std::function<void(cereal::Event::Reader)> &fn) {
+  if (bytes.empty() || bytes.size()>65536 || bytes.size()%8) throw std::invalid_argument("invalid message extent");
+  auto words=kj::heapArray<capnp::word>(bytes.size()/8); std::memcpy(words.begin(),bytes.data(),bytes.size());
+  capnp::ReaderOptions opts; opts.traversalLimitInWords=8192;opts.nestingLimit=16;
+  capnp::FlatArrayMessageReader reader(words,opts); fn(reader.getRoot<cereal::Event>());
+}
+}
+bool RealtimeSource::submit_params(MessageBytes bytes,InputEpoch acquired) {
+  if (params_ || bytes.empty() || bytes.size()>65536 || bytes.size()%8) return false;
+  params_=InputEnvelope{InputKind::CarParams,std::move(bytes),acquired}; return true;
+}
+std::optional<InputEnvelope> RealtimeSource::next(InputEpoch before_fetch) {
+  if (!fenced_ || !same(*fenced_,before_fetch)) {
+    // Bound draining to 16 per channel. A continuously producing/stuck queue
+    // fails closed instead of blocking or accepting old messages with new epoch.
+    for (auto &receive : channels_) {
+      if (!receive) throw std::invalid_argument("missing ingress channel");
+      bool empty=false;
+      for (std::size_t n=0;n<=kLoopMaxInputs;++n) {
+        if (!receive()) { empty=true; break; }
+        ++discarded_;
+      }
+      if (!empty) throw std::runtime_error("ingress fence backlog");
+    }
+    if (params_ && !same(params_->epoch,before_fetch)) { params_.reset();++discarded_; }
+    fenced_=before_fetch;
+    return std::nullopt;
+  }
+  if (params_) { auto item=std::move(params_);params_.reset();return item; }
+  for (unsigned count=0;count<channels_.size();++count) {
+    const auto index=cursor_++%channels_.size(); auto bytes=channels_[index](); if (!bytes) continue;
+    inspect(*bytes,[&](cereal::Event::Reader event) {
+      const std::array kinds{cereal::Event::DEVICE_STATE,cereal::Event::SELFDRIVE_STATE,
+                             cereal::Event::CABIN_CAMERA_STATE,cereal::Event::SENDCAN};
+      if (event.which()!=kinds[index]) throw std::invalid_argument("topic/event mismatch");
+      // Integration is an observation-only candidate. Keep old P6 simulation
+      // tests available, but never let this runtime adapter activate output.
+      if (event.isSendcan() || (event.isSelfdriveState() && event.getSelfdriveState().getEnabled()))
+        throw std::invalid_argument("noOutput ingress rejected");
+    });
+    return InputEnvelope{InputKind::Event,std::move(*bytes),before_fetch};
+  }
+  return std::nullopt;
+}
+bool RealtimeSink::publish(OutputTopic topic,const MessageBytes &bytes) {
+  if (!publish_) return false;
+  inspect(bytes,[&](cereal::Event::Reader event) {
+    const bool matches=(topic==OutputTopic::Can && event.isCan()) ||
+      (topic==OutputTopic::PandaStates && event.isPandaStates()) ||
+      (topic==OutputTopic::PeripheralState && event.isPeripheralState());
+    if (!matches) throw std::invalid_argument("publication topic/event mismatch");
+  });
+  return publish_(topic,bytes);
+}
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/realtime_bridge.h b/openpilot/selfdrive/pandad/compatibility/realtime_bridge.h
new file mode 100644
index 0000000..58d7b1c
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/realtime_bridge.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <array>
+#include <functional>
+#include <optional>
+#include "pandad_loop.h"
+namespace openpilot::pandad::compatibility {
+enum class IngressTopic { DeviceState, SelfdriveState, CabinCameraState, Sendcan };
+// The production-shaped boundary is independent of the transport. Receive is
+// strictly nonblocking and returns an owned copy. Real msgq bindings below are
+// constructed from already-open endpoints; none creates/connects a socket.
+using ReceiveEvent = std::function<std::optional<MessageBytes>()>;
+using PublishEvent = std::function<bool(OutputTopic,const MessageBytes &)>;
+class RealtimeSource final : public EventSource {
+public:
+  explicit RealtimeSource(std::array<ReceiveEvent,4> channels) : channels_(std::move(channels)) {}
+  std::optional<InputEnvelope> next(InputEpoch before_fetch) override;
+  // CarParams has no timestamp/epoch in the schema: a new owner-held submission
+  // is mandatory after every connection or control epoch. Never reload/cache it.
+  bool submit_params(MessageBytes bytes, InputEpoch acquired);
+  std::uint64_t discarded() const { return discarded_; }
+private:
+  std::array<ReceiveEvent,4> channels_;
+  std::optional<InputEpoch> fenced_;
+  std::optional<InputEnvelope> params_;
+  std::size_t cursor_ = 0;
+  std::uint64_t discarded_ = 0;
+};
+class RealtimeSink final : public EventSink {
+public:
+  explicit RealtimeSink(PublishEvent publish) : publish_(std::move(publish)) {}
+  bool publish(OutputTopic topic,const MessageBytes &bytes) override;
+private:
+  PublishEvent publish_;
+};
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/runtime_integration.cc b/openpilot/selfdrive/pandad/compatibility/runtime_integration.cc
new file mode 100644
index 0000000..a7e1255
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/runtime_integration.cc
@@ -0,0 +1,128 @@
+#include "runtime_integration.h"
+#include <limits>
+#include <iostream>
+#include <stdexcept>
+namespace openpilot::pandad::compatibility {
+std::unique_ptr<OwnedTransport> InjectedTransportFactory::open(const DiscoveryItem &item, const SessionBinding &binding) {
+  if (!(item.identity == binding.expected) || binding.safety_config_semantics != "noOutput" ||
+      item.identity.identity.rfind("fixture:",0) != 0) return nullptr;
+  auto owned = std::make_unique<OwnedTransport>();
+  if (item.identity.transport == "USB") {
+    if (!item.usb_alt0_verified) return nullptr;
+    auto api = provider_.usb(item);
+    if (!api) return nullptr;
+    auto usb = std::make_unique<UsbBackend>(std::move(api));
+    const auto type = item.identity.board_type == "DOS" ? 6U : 7U;
+    // Explicit activation applies ONLY to the caller's injected fake API. No
+    // native factory or real profile is reachable through this integration.
+    if (usb->open_bound({item.identity.identity,static_cast<std::uint16_t>(type),true},true) != Status::Ok) return nullptr;
+    owned->backend = std::move(usb);
+  } else if (item.identity.transport == "SPI") {
+    if (!item.spi_first_request_id) return nullptr;
+    owned->spi_io = provider_.spi(item);
+    if (!owned->spi_io) return nullptr;
+    owned->backend = std::make_unique<SpiBackend>(*owned->spi_io,clock_,item.spi_first_request_id);
+  } else return nullptr;
+  owned->transport = std::make_unique<Transport>(*owned->backend,clock_);
+  return owned;
+}
+RuntimeIntegration::RuntimeIntegration(const SessionProfile &profile, Clock &clock, DiscoveryProvider &discovery,
+                                       InjectedTransportFactory &factory, RealtimeSource &source, RealtimeSink &sink)
+  : profile_(profile), clock_(clock), discovery_(discovery), factory_(factory), runtime_(profile,clock), loop_(runtime_,clock,source,sink) {}
+void RuntimeIntegration::retire(const char *reason) {
+  // Runtime may still hold pointers. Reconcile/cancel BEFORE freeing owners.
+  runtime_.invalid_input(reason);
+  runtime_.reconcile({},{{nullptr,nullptr}});
+  for (auto &handle : handles_) handle.reset();
+  nonces_ = {}; tokens_ = {}; usb_alt0_ = {}; spi_ids_ = {};
+}
+bool RuntimeIntegration::refresh() {
+  if (stopping_ || profile_.binding_status != "SYNTHETIC_BOUND") return false;
+  try {
+    const auto inventory = discovery_.snapshot();
+    const auto now = clock_.now_us();
+    if (!inventory.revision || inventory.revision < revision_ || !inventory.observed_us ||
+        inventory.observed_us > now || now-inventory.observed_us >= kLoopMaxGapUs ||
+        inventory.observed_us < observed_us_ || inventory.items.size() != 2) {
+      retire("DISCOVERY_INVALID_OR_STALE"); return false;
+    }
+    std::array<const DiscoveryItem *,2> items{};
+    for (const auto &item : inventory.items) {
+      std::size_t slot = item.identity.identity == profile_.slots[0].expected.identity ? 0 : 1;
+      if (!(item.identity == profile_.slots[slot].expected) || items[slot] || item.handle_nonce.empty() ||
+          item.handle_nonce.size() > 128) { retire("DISCOVERY_IDENTITY_MISMATCH"); return false; }
+      items[slot] = &item;
+    }
+    if (!items[0] || !items[1] || items[0]->handle_nonce == items[1]->handle_nonce) {
+      retire("DISCOVERY_DUPLICATE_HANDLE"); return false;
+    }
+    const bool same = handles_[0] && handles_[1] && nonces_[0] == items[0]->handle_nonce && nonces_[1] == items[1]->handle_nonce;
+    if (inventory.revision == revision_ && !same) { retire("DISCOVERY_REVISION_REUSE"); return false; }
+    if (same) {
+      for (std::size_t slot=0;slot<2;++slot) {
+        if (items[slot]->usb_alt0_verified != usb_alt0_[slot] || items[slot]->spi_first_request_id != spi_ids_[slot]) {
+          retire("DISCOVERY_ACTIVATION_EVIDENCE_CHANGED"); return false;
+        }
+      }
+      if (!handles_[0]->transport->healthy() || !handles_[1]->transport->healthy() || !runtime_.sessions().group_available) {
+        retire("DISCOVERY_RETIRED_HANDLE"); return false;
+      }
+      revision_ = inventory.revision; observed_us_ = inventory.observed_us; return true;
+    }
+    // A changed group retires BOTH owners. No hot swap under an existing token.
+    // Demand fresh handle nonces for both; a removed/rejected handle never heals.
+    retire("DISCOVERY_GROUP_CHANGED");
+    for (const auto *item : items) {
+      if (consumed_.count(item->handle_nonce) || consumed_.size() > 126 || next_token_ > UINT64_MAX-2) return false;
+    }
+    // Reserve both before any opening: a partial failure consumes both handles.
+    for (const auto *item : items) consumed_.insert(item->handle_nonce);
+    revision_ = inventory.revision; observed_us_ = inventory.observed_us;
+    std::vector<SessionObservation> observations;
+    for (std::size_t slot=0;slot<2;++slot) {
+      tokens_[slot] = ++next_token_;
+      handles_[slot] = factory_.open(*items[slot],profile_.slots[slot]);
+      if (!handles_[slot]) { retire("DISCOVERY_OPEN_FAILED"); return false; }
+      nonces_[slot] = items[slot]->handle_nonce;
+      usb_alt0_[slot] = items[slot]->usb_alt0_verified;
+      spi_ids_[slot] = items[slot]->spi_first_request_id;
+      observations.push_back({items[slot]->identity,tokens_[slot]});
+    }
+    if (!runtime_.reconcile(observations,{{handles_[0]->transport.get(),handles_[1]->transport.get()}})) {
+      retire("DISCOVERY_RECONCILE_FAILED"); return false;
+    }
+    return true;
+  } catch (...) { retire("DISCOVERY_CALLBACK_EXCEPTION"); return false; }
+}
+LoopCycleResult RuntimeIntegration::cycle() {
+  if (!stopping_) refresh();
+  auto result = loop_.cycle();
+  if (result.shutdown) retire("OWNER_SHUTDOWN");
+  return result;
+}
+int pandad_runtime_offline_main() {
+  struct FixtureClock final : Clock { std::uint64_t now_us() override { return 1000000; } void wait_us(std::uint32_t) override {} } clock;
+  struct ForbiddenDiscovery final : DiscoveryProvider {
+    unsigned calls = 0;
+    DiscoverySnapshot snapshot() override { ++calls; throw std::logic_error("unbound discovery invoked"); }
+  } discovery;
+  struct ForbiddenIo final : OfflineIoProvider {
+    unsigned calls = 0;
+    std::unique_ptr<LibusbApi> usb(const DiscoveryItem &) override { ++calls; throw std::logic_error("USB provider invoked"); }
+    std::unique_ptr<SpiIo> spi(const DiscoveryItem &) override { ++calls; throw std::logic_error("SPI provider invoked"); }
+  } io;
+  InjectedTransportFactory factory(io,clock);
+  const ReceiveEvent empty=[] { return std::optional<MessageBytes>{}; };
+  RealtimeSource source({empty,empty,empty,empty});
+  unsigned publications=0;
+  RealtimeSink sink([&](OutputTopic,const MessageBytes &) { ++publications; return true; });
+  RuntimeIntegration owner(SessionProfile{},clock,discovery,factory,source,sink);
+  const auto cycle=owner.cycle();
+  if (cycle.callback_failed || discovery.calls || io.calls || publications!=3 || owner.sessions().group_available || owner.snapshot().real_tx_authorized) return 1;
+  owner.request_shutdown();
+  if (!owner.cycle().shutdown) return 1;
+  std::cout << "PASS p8_actual_main_unbound_owner_no_io\n"
+            << "{\"suite\":\"p8_actual_main\",\"passed\":1,\"failed\":0,\"skipped\":0,\"real_device_io\":false}\n";
+  return 0;
+}
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/runtime_integration.h b/openpilot/selfdrive/pandad/compatibility/runtime_integration.h
new file mode 100644
index 0000000..41cb4c3
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/runtime_integration.h
@@ -0,0 +1,73 @@
+#pragma once
+#include <array>
+#include <memory>
+#include <set>
+#include <string>
+#include "pandad_loop.h"
+#include "realtime_bridge.h"
+#include "usb_backend.h"
+#include "spi_backend.h"
+
+namespace openpilot::pandad::compatibility {
+// A COMPLETE bounded discovery result; not an enumeration implementation.
+// Handles are opaque session nonces, never inferred from USB address/position.
+struct DiscoveryItem { SessionIdentity identity; std::string handle_nonce; bool usb_alt0_verified = false; std::uint32_t spi_first_request_id = 0; };
+struct DiscoverySnapshot { std::uint64_t revision = 0, observed_us = 0; std::vector<DiscoveryItem> items; };
+class DiscoveryProvider {
+public:
+  virtual ~DiscoveryProvider() = default;
+  virtual DiscoverySnapshot snapshot() = 0;
+};
+// This stage intentionally has no native provider. Implementations are supplied
+// only by offline fixtures. A real discovery/authentication/recovery boundary is
+// separate work; a USB descriptor is not evidence of MCU or application trust.
+class OfflineIoProvider {
+public:
+  virtual ~OfflineIoProvider() = default;
+  virtual std::unique_ptr<LibusbApi> usb(const DiscoveryItem &) = 0;
+  virtual std::unique_ptr<SpiIo> spi(const DiscoveryItem &) = 0;
+};
+struct OwnedTransport {
+  std::unique_ptr<SpiIo> spi_io;
+  std::unique_ptr<Backend> backend;
+  std::unique_ptr<Transport> transport;
+  ~OwnedTransport() { if (transport) transport->cancel(); }
+};
+class InjectedTransportFactory {
+public:
+  InjectedTransportFactory(OfflineIoProvider &provider, Clock &clock) : provider_(provider), clock_(clock) {}
+  std::unique_ptr<OwnedTransport> open(const DiscoveryItem &item, const SessionBinding &binding);
+private:
+  OfflineIoProvider &provider_; Clock &clock_;
+};
+// Explicit unbound fixture dispatch used by the real pandad executable.
+int pandad_runtime_offline_main();
+
+// Single owner for discovery, handle lifetime and the existing P4/P6 scheduler.
+// All public methods run on the serialized owner thread. It does not enumerate,
+// open sockets, install firmware, or create native I/O implementations.
+class RuntimeIntegration {
+public:
+  RuntimeIntegration(const SessionProfile &, Clock &, DiscoveryProvider &, InjectedTransportFactory &, RealtimeSource &, RealtimeSink &);
+  bool refresh();
+  LoopCycleResult cycle();
+  void request_shutdown() { stopping_ = true; loop_.request_shutdown(); }
+  InputEpoch capture() { return runtime_.capture(); }
+  ControlSnapshot snapshot() { return runtime_.snapshot(); }
+  SessionSnapshot sessions() const { return runtime_.sessions(); }
+  const RuntimeCounters &counters() const { return runtime_.counters(); }
+private:
+  void retire(const char *reason);
+  const SessionProfile profile_;
+  Clock &clock_; DiscoveryProvider &discovery_; InjectedTransportFactory &factory_;
+  PandadRuntime runtime_; PandadLoop loop_;
+  std::array<std::unique_ptr<OwnedTransport>,2> handles_;
+  std::array<std::string,2> nonces_;
+  std::array<std::uint64_t,2> tokens_{};
+  std::array<bool,2> usb_alt0_{};
+  std::array<std::uint32_t,2> spi_ids_{};
+  std::set<std::string> consumed_;
+  std::uint64_t revision_ = 0, next_token_ = 0, observed_us_ = 0;
+  bool stopping_ = false;
