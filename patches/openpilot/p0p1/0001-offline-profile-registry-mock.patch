diff --git a/openpilot/selfdrive/pandad/compatibility/registry.py b/openpilot/selfdrive/pandad/compatibility/registry.py
new file mode 100644
index 0000000000000000000000000000000000000000..f28272a3a573c44e3b512a5dbca68550c6609ed2
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/registry.py
@@ -0,0 +1,101 @@
+"""Atomic registration of supplied synthetic observations; no discovery IO."""
+
+from dataclasses import dataclass
+
+from .profile import Capabilities, Profile, SlotBinding
+
+
+class RegistryError(ValueError):
+  def __init__(self, code: str):
+    self.code = code
+    super().__init__(code)
+
+
+@dataclass(frozen=True)
+class Observation:
+  identity: str
+  board_type: str
+  mcu_family: str
+  exact_mcu: str
+  transport: str
+  protocol_profile: str
+  capabilities: Capabilities
+  application_signature: str
+
+  def __post_init__(self) -> None:
+    # Reuse exactly the bound-profile contract, with the observation's noOutput
+    # fixture semantics. No board type is inferred from transport or ordering.
+    SlotBinding(0, self.identity, self.board_type, self.mcu_family, self.exact_mcu,
+                self.transport, self.protocol_profile, self.capabilities,
+                self.application_signature, "noOutput")
+
+
+@dataclass(frozen=True)
+class Registry:
+  """Snapshot for simulation, not a live connection or permission token.
+
+  A caller must register the complete observation set on each reconciliation.
+  Disconnect/reconnect epochs and real control-session lifecycle belong to P3.
+  """
+  profile: Profile
+  boards: tuple[Observation, ...]
+
+  def __post_init__(self) -> None:
+    _validate(self.profile, self.boards)
+    if tuple(o.identity for o in self.boards) != tuple(s.identity_binding for s in self.profile.slots):
+      raise RegistryError("NONCANONICAL_REGISTRY")
+
+  @property
+  def device_access_enabled(self) -> bool:
+    return False
+
+  @property
+  def can_tx_enabled(self) -> bool:
+    return False
+
+  @property
+  def firmware_install_enabled(self) -> bool:
+    return False
+
+  def for_role(self, role: str) -> tuple[Observation, ...]:
+    if type(role) is not str or role not in self.profile.roles.__dataclass_fields__:
+      raise RegistryError("UNKNOWN_ROLE")
+    slots = getattr(self.profile.roles, role)
+    if slots == "UNSUPPORTED":
+      return ()
+    return tuple(self.boards[s] for s in (slots if type(slots) is tuple else (slots,)))
+
+
+def _validate(profile: Profile, observations: tuple[Observation, ...]) -> None:
+  if type(profile) is not Profile:
+    raise RegistryError("INVALID_PROFILE")
+  if profile.binding_status != "SYNTHETIC_BOUND":
+    raise RegistryError("UNBOUND_PROFILE")
+  if type(observations) is not tuple or not all(type(o) is Observation for o in observations):
+    raise RegistryError("INVALID_OBSERVATIONS")
+  if len(observations) != 2:
+    raise RegistryError("REQUIRED_BOARD_COUNT")
+  identities = [o.identity for o in observations]
+  if len(set(identities)) != 2:
+    raise RegistryError("DUPLICATE_IDENTITY")
+  by_identity = {o.identity: o for o in observations}
+  if set(by_identity) != {slot.identity_binding for slot in profile.slots}:
+    raise RegistryError("UNEXPECTED_IDENTITY")
+  fields = {"board_type": "expected_board_type", "mcu_family": "mcu_family", "exact_mcu": "exact_mcu", "transport": "transport",
+            "protocol_profile": "protocol_profile", "capabilities": "capabilities", "application_signature": "application_signature"}
+  for binding in profile.slots:
+    observation = by_identity[binding.identity_binding]
+    for observed, expected in fields.items():
+      if getattr(observation, observed) != getattr(binding, expected):
+        raise RegistryError(f"MISMATCH_{observed.upper()}")
+
+
+def register(profile: Profile, observations: tuple[Observation, ...]) -> Registry:
+  """Validate the entire inventory and bind it to fixed profile slots atomically.
+
+  Reversed discovery order is accepted. Missing, extra, duplicate (including
+  the same identity on USB and SPI), or substituted boards reject the group.
+  """
+  _validate(profile, observations)
+  by_identity = {observation.identity: observation for observation in observations}
+  return Registry(profile, tuple(by_identity[slot.identity_binding] for slot in profile.slots))
diff --git a/openpilot/selfdrive/pandad/compatibility/tests/test_mock_transport.py b/openpilot/selfdrive/pandad/compatibility/tests/test_mock_transport.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ed925bed0076b34ce73d51c801e658e945aa228
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/tests/test_mock_transport.py
@@ -0,0 +1,110 @@
+from dataclasses import FrozenInstanceError
+import json
+import unittest
+
+from compatibility.mock_transport import (MAX_SCRIPT_BYTES, MAX_SCRIPT_STEPS, MAX_TRANSFER_BYTES,
+                                           MockCancelled, MockDisconnected, MockTimeout, ScriptError, ScriptStep, ScriptedTransport)
+
+
+class TestMockTransport(unittest.TestCase):
+  def test_short_reads_and_writes_are_returned_without_retry(self):
+    mock = ScriptedTransport((ScriptStep("read", b"a"), ScriptStep("read", b""), ScriptStep("write", b"abcd", 2)))
+    self.assertEqual(mock.read(4096), b"a")
+    self.assertEqual(mock.read(4), b"")
+    self.assertEqual(mock.write(b"abcd"), 2)
+    self.assertEqual(mock.remaining_steps, 0)
+    trace = mock.trace_json()
+    self.assertEqual([e["returned_count"] for e in trace], [1, 0, 2])
+    self.assertTrue(all(not e["actual_device_access"] and not e["actual_can_tx"] for e in trace))
+    self.assertEqual(json.loads(json.dumps(trace)), trace)
+
+  def test_scripted_errors_are_explicit_and_do_not_retry(self):
+    for error, cls in (("timeout", MockTimeout), ("disconnected", MockDisconnected), ("cancelled", MockCancelled)):
+      mock = ScriptedTransport((ScriptStep("read", error=error),))
+      with self.subTest(error=error), self.assertRaises(cls):
+        mock.read(1)
+      self.assertEqual(mock.remaining_steps, 0)
+      self.assertEqual(mock.trace[0].result, error)
+      self.assertIsNone(mock.trace[0].returned_count)
+
+  def test_mock_write_error_records_only_intent(self):
+    mock = ScriptedTransport((ScriptStep("write", b"abc", error="timeout"),))
+    with self.assertRaises(MockTimeout):
+      mock.write(b"abc")
+    self.assertEqual(mock.trace[0].payload_hex, "616263")
+    self.assertFalse(mock.trace[0].actual_can_tx)
+    self.assertIsNone(mock.trace[0].returned_count)
+
+  def test_strict_script_mismatch_does_not_consume(self):
+    mock = ScriptedTransport((ScriptStep("write", b"expected"), ScriptStep("read", b"ab")))
+    for call in (lambda: mock.read(1), lambda: mock.write(b"wrong")):
+      with self.assertRaises(ScriptError):
+        call()
+    self.assertEqual(mock.remaining_steps, 2)
+    self.assertEqual(mock.trace, ())
+    self.assertEqual(mock.write(b"expected"), 8)
+    with self.assertRaises(ScriptError):
+      mock.read(1)
+    self.assertEqual(mock.remaining_steps, 1)
+
+  def test_argument_boundaries_and_types(self):
+    for size in (-1, MAX_TRANSFER_BYTES + 1, True, 1.0):
+      mock = ScriptedTransport((ScriptStep("read"),))
+      with self.subTest(size=size), self.assertRaises(ScriptError):
+        mock.read(size)
+      self.assertEqual(mock.remaining_steps, 1)
+    for timeout in (0, 1001, True, 1.0, None):
+      mock = ScriptedTransport((ScriptStep("read"),))
+      with self.subTest(timeout=timeout), self.assertRaises(ScriptError):
+        mock.read(0, timeout_ms=timeout)
+    for size, timeout in ((0, 1), (MAX_TRANSFER_BYTES, 1000)):
+      self.assertEqual(ScriptedTransport((ScriptStep("read"),)).read(size, timeout_ms=timeout), b"")
+    with self.assertRaises(ScriptError):
+      ScriptedTransport(()).write(bytearray(b"x"))
+
+  def test_step_contract_validation(self):
+    for args in (("reset",), ("read", bytearray()), ("read", b"x" * 4097), ("read", b"", 0),
+                 ("write", b"x", True), ("write", b"x", 2), ("read", b"", None, "unknown"),
+                 ("read", b"x", None, "timeout"), ("write", b"x", 0, "timeout")):
+      with self.subTest(args=args[:1]), self.assertRaises(ScriptError):
+        ScriptStep(*args)
+
+  def test_script_resources_are_bounded(self):
+    for script in ([], (object(),), (ScriptStep("read"),) * (MAX_SCRIPT_STEPS + 1),
+                   (ScriptStep("read", b"a" * MAX_TRANSFER_BYTES),) * (MAX_SCRIPT_BYTES // MAX_TRANSFER_BYTES + 1)):
+      with self.assertRaises(ScriptError):
+        ScriptedTransport(script)
+    mock = ScriptedTransport((ScriptStep("read"),) * MAX_SCRIPT_STEPS)
+    self.assertEqual(mock.remaining_steps, MAX_SCRIPT_STEPS)
+
+  def test_instances_are_independent_and_close_is_local(self):
+    first = ScriptedTransport((ScriptStep("read", error="timeout"),))
+    second = ScriptedTransport((ScriptStep("read", b"ok"),))
+    with self.assertRaises(MockTimeout):
+      first.read(2)
+    first.close()
+    first.close()
+    with self.assertRaises(MockCancelled):
+      first.read(2)
+    self.assertEqual(second.read(2), b"ok")
+    self.assertEqual(len(first.trace), 1)
+    self.assertEqual(len(second.trace), 1)
+
+  def test_trace_is_immutable_and_export_is_detached(self):
+    mock = ScriptedTransport((ScriptStep("read", b"a"),))
+    mock.read(1)
+    with self.assertRaises(FrozenInstanceError):
+      mock.trace[0].result = "fake"
+    exported = mock.trace_json()
+    exported[0]["actual_can_tx"] = True
+    self.assertFalse(mock.trace[0].actual_can_tx)
+
+  def test_exhaustion_is_explicit(self):
+    mock = ScriptedTransport(())
+    with self.assertRaisesRegex(ScriptError, "script exhausted"):
+      mock.read(0)
+    self.assertEqual(mock.trace, ())
+
+
+if __name__ == "__main__":
+  unittest.main()
