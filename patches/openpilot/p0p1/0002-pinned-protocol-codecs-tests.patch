+  std::printf(",\"can_frame_hex\":");
+  hex(&frame, CANPACKET_HEAD_SIZE + GET_LEN(&frame));
+
+  frame = CANPacket_t{};
+  frame.fd = 1;
+  frame.bus = 2;
+  frame.data_len_code = 9;
+  frame.addr = 0x18da10f1;
