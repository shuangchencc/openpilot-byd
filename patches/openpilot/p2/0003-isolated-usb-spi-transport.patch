+void reject_duplicate_and_replacement() {
+  for (bool duplicate : {true, false}) {
+    auto s = state();
+    if (duplicate) { s->devices.push_back(device(2)); s->serial_by_id[2] = "fixture:DOS-A"; }
+    else s->devices[0].bcd_device = 0x700;
+    auto usb = backend(s); CHECK(usb.open_bound({"fixture:DOS-A", 6, true}, true) == Status::Poisoned);
+    CHECK(!usb.is_open() && s->claims == 0 && s->closes == s->opens && s->shutdowns == 1);
+  }
+}
+void malformed_descriptors() {
+  for (int variant = 0; variant < 9; ++variant) {
+    auto s = state(); auto &d = s->devices[0];
+    switch (variant) {
+      case 0: d.active_configuration_known = false; break;
+      case 1: d.serial_index = 0; break;
+      case 2: d.alternates[0].interface_number = 1; break;
+      case 3: d.alternates[0].endpoints[0].attributes = 3; break;
+      case 4: d.alternates[0].endpoints[0].max_packet_size = 512; break;
+      case 5: d.alternates[0].endpoints.pop_back(); break;
+      case 6: d.alternates[0].endpoints.push_back(d.alternates[0].endpoints[0]); break;
+      case 7: d.alternates.push_back(d.alternates[0]); break;
+      case 8: d.bcd_device = 0x601; break;
+    }
+    auto usb = backend(s); CHECK(usb.open_bound({"fixture:DOS-A", 6, true}, true) == Status::Poisoned);
+    CHECK(s->claims == 0 && s->closes == 1 && s->shutdowns == 1);
+  }
+}
+void active_alternate_needs_explicit_external_verification() {
+  auto s = state(); auto usb = backend(s);
+  CHECK(usb.open_bound({"fixture:DOS-A", 6}, true) == Status::Invalid);
+  CHECK(s->initializes == 0 && s->opens == 0 && s->claims == 0);
+}
+void open_failures_cleanup() {
+  for (int phase = 0; phase < 5; ++phase) {
+    auto s = state();
+    switch (phase) {
+      case 0: s->initialize_error = kUsbIo; break;
+      case 1: s->enumerate_error = kUsbIo; break;
+      case 2: s->open_error = kUsbAccess; break;
+      case 3: s->serial_error = kUsbTimeout; break;
+      case 4: s->claim_error = kUsbBusy; break;
+    }
+    { auto usb = backend(s); CHECK(usb.open_bound({"fixture:DOS-A", 6, true}, true) != Status::Ok); CHECK(!usb.is_open()); }
+    CHECK(s->shutdowns == (phase == 0 ? 0 : 1));
+    CHECK(s->closes == (phase >= 3 ? 1 : 0));
+    CHECK(s->releases == 0);
+  }
+}
+void bulk_short_read_and_write() {
+  auto s = state(); auto usb = backend(s); open(usb);
+  s->replies.push_back({false, 0, 3, {9, 8, 7}}); auto r = usb.transact(read(), 5);
+  CHECK(r.status == Status::Short && r.actual == 3 && r.data == std::vector<std::uint8_t>({9, 8, 7}) && r.actual_known);
+  s->replies.push_back({false, 0, 2, {}}); r = usb.transact(write(), 5);
+  CHECK(r.status == Status::Short && r.actual == 2 && r.delivery_uncertain && r.data.empty());
+  CHECK(s->transfers == 2 && s->output == std::vector<std::vector<std::uint8_t>>({{1, 2, 3, 4}}));
+}
+void partial_timeout_preserves_data() {
+  auto s = state(); auto usb = backend(s); open(usb);
+  s->replies.push_back({false, kUsbTimeout, 2, {7, 8}}); auto r = usb.transact(read(), 2);
+  CHECK(r.status == Status::Timeout && r.actual == 2 && r.actual_known && r.data == std::vector<std::uint8_t>({7, 8}));
+  CHECK(!r.delivery_uncertain && s->timeouts == std::vector<unsigned int>({2}));
+}
+void control_read_write_and_unknown_count() {
+  auto s = state(); auto usb = backend(s); open(usb);
+  Request r; r.kind = Kind::ControlRead; r.request = 0xdd; r.value = 0xabcd; r.index = 0x4321; r.read_length = 8;
+  s->replies.push_back({true, 3, 0, {1, 2, 3}}); auto result = usb.transact(r, 5);
+  CHECK(result.status == Status::Short && result.actual == 3 && result.data == std::vector<std::uint8_t>({1, 2, 3}));
+  r.kind = Kind::ControlWrite; r.read_length = 0; r.payload = {1, 2};
+  s->replies.push_back({true, kUsbTimeout, 0, {}}); result = usb.transact(r, 5);
+  CHECK(result.status == Status::Timeout && !result.actual_known && result.delivery_uncertain && result.actual == 0);
+  s->replies.push_back({true, 2, 0, {}}); result = usb.transact(r, 5);
+  CHECK(result.status == Status::Ok && result.actual == 2 && !result.delivery_uncertain);
+  r.payload.clear(); s->replies.push_back({true, 0, 0, {}}); result = usb.transact(r, 5);
+  CHECK(result.status == Status::Ok && result.actual == 0 && result.actual_known && !result.delivery_uncertain);
+  r.kind = Kind::ControlRead; r.read_length = 8; s->replies.push_back({true, kUsbTimeout, 0, {}});
+  result = usb.transact(r, 5);
+  CHECK(result.status == Status::Timeout && result.actual == 0 && !result.actual_known && !result.delivery_uncertain);
+  CHECK(s->request_types == std::vector<unsigned int>({0xc0, 0x40, 0x40, 0x40, 0xc0}));
+  CHECK(s->requests == std::vector<unsigned int>(5, 0xdd));
+  CHECK(s->values == std::vector<unsigned int>(5, 0xabcd) && s->indices == std::vector<unsigned int>(5, 0x4321));
+}
+void error_classes_and_no_replay() {
+  const std::pair<int, Status> errors[] = {{kUsbTimeout, Status::Timeout}, {kUsbNoDevice, Status::Disconnected},
+    {kUsbPipe, Status::Stall}, {kUsbInterrupted, Status::Cancelled}, {kUsbBusy, Status::Busy},
+    {kUsbOverflow, Status::Poisoned}, {kUsbIo, Status::IoError}};
+  for (const auto &[code, expected] : errors) {
+    auto s = state(); auto usb = backend(s); open(usb); FakeClock clock; Transport transport(usb, clock);
+    s->replies.push_back({false, code, 2, {}}); auto result = transport.perform(write());
+    CHECK(result.status == expected && result.delivery_uncertain);
+    if (code == kUsbOverflow) CHECK(result.actual == 0 && !result.actual_known && result.data.empty());
+    else CHECK(result.actual == 2 && result.actual_known);
+    CHECK(s->transfers == 1);
+  }
+}
+void invalid_requests_never_touch_api() {
+  auto s = state(); auto usb = backend(s); open(usb);
+  auto r = read(); r.endpoint = 0x82; CHECK(usb.transact(r, 5).status == Status::Invalid);
+  r = write(); r.endpoint = 0x02; CHECK(usb.transact(r, 5).status == Status::Invalid);
+  CHECK(usb.transact(read(), 0).status == Status::Invalid); CHECK(usb.transact(read(), 6).status == Status::Invalid);
+  r = read(kMaxBulkBytes + 1); CHECK(usb.transact(r, 5).status == Status::Invalid);
+  CHECK(s->transfers == 0);
+}
+void impossible_actual_poisoned() {
+  {
+    auto s = state(); auto usb = backend(s); open(usb);
+    s->replies.push_back({false, kUsbOverflow, 2, {1, 2}});
+    auto result = usb.transact(read(), 5);
+    CHECK(result.status == Status::Poisoned && !result.actual_known && result.actual == 0 && result.data.empty());
+  }
+  for (int actual : {-1, 9}) {
+    auto s = state(); auto usb = backend(s); open(usb); s->replies.push_back({false, 0, actual, {}});
+    auto result = usb.transact(read(), 5); CHECK(result.status == Status::Poisoned && !result.actual_known && result.data.empty());
+  }
+}
+void stream_fragments_at_usb_packet_boundary() {
+  auto s = state(); auto usb = backend(s); open(usb); CanStreamParser parser(CanCapability::CanFd);
+  CanFrame frame; frame.address = 0x123; frame.fd = true; frame.payload.resize(64, 0xaa);
+  auto encoded = encode_can_frame(frame, CanCapability::CanFd, FrameDirection::Rx); CHECK(encoded && encoded.value.size() == 70);
+  s->replies.push_back({false, 0, 64, {encoded.value.begin(), encoded.value.begin() + 64}});
+  s->replies.push_back({false, kUsbTimeout, 6, {encoded.value.begin() + 64, encoded.value.end()}});
+  auto a = usb.transact(read(128), 5); auto first = parser.feed(a.data.data(), a.data.size()); CHECK(first && first.value.empty());
+  auto b = usb.transact(read(128), 5); auto second = parser.feed(b.data.data(), b.data.size());
+  CHECK(b.status == Status::Timeout && second && second.value.size() == 1 && second.value[0].payload == frame.payload);
+  CHECK(s->transfers == 2 && parser.buffered_size() == 0);
+}
+void two_session_parsers_do_not_mix_and_peer_survives_disconnect() {
+  auto a = state(), b = state(); auto usb_a = backend(a), usb_b = backend(b); open(usb_a); open(usb_b);
+  FakeClock clock_a, clock_b; Transport session_a(usb_a, clock_a), session_b(usb_b, clock_b);
+  CanStreamParser parser_a(CanCapability::ClassicOnly), parser_b(CanCapability::ClassicOnly);
+  CanFrame first; first.address = 0x123; first.payload = {1, 2, 3, 4};
+  CanFrame second; second.address = 0x456; second.payload = {5, 6, 7, 8};
+  auto encoded_a = encode_can_frame(first, CanCapability::ClassicOnly, FrameDirection::Rx);
+  auto encoded_b = encode_can_frame(second, CanCapability::ClassicOnly, FrameDirection::Rx);
+  CHECK(encoded_a && encoded_b);
+  a->replies.push_back({false, 0, 4, {encoded_a.value.begin(), encoded_a.value.begin() + 4}});
+  b->replies.push_back({false, 0, 6, {encoded_b.value.begin(), encoded_b.value.begin() + 6}});
+  b->replies.push_back({false, 0, 4, {encoded_b.value.begin() + 6, encoded_b.value.end()}});
+  a->replies.push_back({false, kUsbNoDevice, 0, {}});
+  auto first_a = session_a.perform(read()); auto a_prefix = parser_a.feed(first_a.data.data(), first_a.data.size());
+  auto first_b = session_b.perform(read()); auto b_prefix = parser_b.feed(first_b.data.data(), first_b.data.size());
+  CHECK(a_prefix && a_prefix.value.empty() && b_prefix && b_prefix.value.empty());
+  CHECK(session_a.perform(read()).status == Status::Disconnected);
+  auto last_b = session_b.perform(read()); auto complete_b = parser_b.feed(last_b.data.data(), last_b.data.size());
+  CHECK(complete_b && complete_b.value.size() == 1 && complete_b.value[0].address == second.address);
+  CHECK(complete_b.value[0].payload == second.payload && parser_a.buffered_size() == 4 && parser_b.buffered_size() == 0);
+  CHECK(session_b.healthy() && !session_a.healthy());
+  CHECK(session_a.perform(read()).status == Status::Poisoned && a->transfers == 2 && b->transfers == 2);
+}
+void cancelled_read_does_not_retry() {
+  auto s = state(); auto usb = backend(s); open(usb); FakeClock clock; Transport transport(usb, clock);
+  s->replies.push_back({false, kUsbTimeout, 2, {9, 8}});
+  s->in_transfer = [&] { transport.cancel(); };
+  auto result = transport.perform(read());
+  CHECK(result.status == Status::Cancelled && result.actual == 2 && result.data == std::vector<std::uint8_t>({9, 8}));
+  CHECK(s->transfers == 1); CHECK(transport.perform(read()).status == Status::Cancelled && s->transfers == 1);
+}
+void separate_handles_progress_during_blocked_peer() {
+  auto a = state(), b = state(); auto usb_a = backend(a), usb_b = backend(b); open(usb_a); open(usb_b);
+  a->replies.push_back({false, kUsbTimeout, 0, {}}); b->replies.push_back({false, 0, 1, {42}});
+  std::mutex mutex; std::condition_variable cv; bool entered = false, finish = false;
+  a->in_transfer = [&] { std::unique_lock<std::mutex> lock(mutex); entered = true; cv.notify_all(); cv.wait(lock, [&] { return finish; }); };
+  Result first; std::thread thread([&] { first = usb_a.transact(read(1), 5); });
+  { std::unique_lock<std::mutex> lock(mutex); cv.wait(lock, [&] { return entered; }); }
+  auto second = usb_b.transact(read(1), 5);
+  CHECK(second.status == Status::Ok && second.data == std::vector<std::uint8_t>({42}));
+  CHECK(usb_a.transact(read(), 5).status == Status::Busy);
+  { std::lock_guard<std::mutex> lock(mutex); finish = true; } cv.notify_all(); thread.join();
+  CHECK(first.status == Status::Timeout && a->transfers == 1 && b->transfers == 1);
+}
+void close_does_not_reuse_session() {
+  auto s = state(); auto usb = backend(s); open(usb); usb.close(); usb.close();
+  CHECK(usb.transact(read(), 5).status == Status::Disconnected);
+  CHECK(s->releases == 1 && s->closes == 1 && s->shutdowns == 1 && s->transfers == 0);
+}
+}  // namespace
+int main() {
+  const std::pair<const char *, void(*)()> tests[] = {
+    {"inert_construction_and_permission", inert_construction_and_permission},
+    {"selection_and_cleanup", selection_and_cleanup}, {"reversed_selection", reversed_selection},
+    {"reject_bootstub_and_dfu", reject_bootstub_and_dfu}, {"reject_duplicate_and_replacement", reject_duplicate_and_replacement},
+    {"malformed_descriptors", malformed_descriptors}, {"active_alternate_needs_explicit_external_verification", active_alternate_needs_explicit_external_verification},
+    {"open_failures_cleanup", open_failures_cleanup}, {"bulk_short_read_and_write", bulk_short_read_and_write},
+    {"partial_timeout_preserves_data", partial_timeout_preserves_data},
+    {"control_read_write_and_unknown_count", control_read_write_and_unknown_count},
+    {"error_classes_and_no_replay", error_classes_and_no_replay}, {"invalid_requests_never_touch_api", invalid_requests_never_touch_api},
+    {"impossible_actual_poisoned", impossible_actual_poisoned},
+    {"stream_fragments_at_usb_packet_boundary", stream_fragments_at_usb_packet_boundary},
+    {"two_session_parsers_do_not_mix_and_peer_survives_disconnect", two_session_parsers_do_not_mix_and_peer_survives_disconnect},
+    {"cancelled_read_does_not_retry", cancelled_read_does_not_retry},
+    {"separate_handles_progress_during_blocked_peer", separate_handles_progress_during_blocked_peer},
+    {"close_does_not_reuse_session", close_does_not_reuse_session},
+  };
+  for (const auto &[name, test] : tests) { test(); std::cout << "PASS " << name << '\n'; }
+  std::cout << "{\"suite\":\"usb_backend\",\"groups\":" << std::size(tests) << ",\"failed\":0,\"device_io\":false}\n";
+}
diff --git a/openpilot/selfdrive/pandad/compatibility/timing_budget.h b/openpilot/selfdrive/pandad/compatibility/timing_budget.h
new file mode 100644
index 0000000..1b8ca10
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/timing_budget.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace openpilot::pandad::compatibility {
+
+// Candidate scheduler contract, pure policy only. P3/P4 must connect this to
+// actual health collection, heartbeat scheduling and the group TX barrier.
+// These constants neither authorize a command nor implement MCU liveness.
+inline constexpr std::size_t kInflightCapacity = 1;
+inline constexpr std::size_t kPendingQueueCapacity = 0;
+inline constexpr std::uint64_t kHealthPeriodUs = 100000;
+inline constexpr std::uint64_t kHealthMaxAgeUs = 250000;
+inline constexpr std::uint64_t kHeartbeatPeriodUs = 100000;
+inline constexpr std::uint64_t kHeartbeatMaxAgeUs = 250000;
+
+// Unsigned subtraction tolerates a single wrapping clock. Intervals >=2^63
+// (including future samples) are invalid, never made fresh by signed casts.
+inline bool valid_elapsed(std::uint64_t now, std::uint64_t then) {
+  return now - then < (std::uint64_t{1} << 63);
+}
+inline bool health_fresh(bool observed, std::uint64_t now, std::uint64_t received) {
+  return observed && valid_elapsed(now, received) && now - received < kHealthMaxAgeUs;
+}
+inline bool heartbeat_due(bool sent, std::uint64_t now, std::uint64_t last_sent) {
+  return !sent || !valid_elapsed(now, last_sent) || now - last_sent >= kHeartbeatPeriodUs;
+}
+inline bool heartbeat_overdue(bool sent, std::uint64_t now, std::uint64_t last_sent) {
+  return !sent || !valid_elapsed(now, last_sent) || now - last_sent >= kHeartbeatMaxAgeUs;
+}
+inline bool queue_admissible(std::size_t inflight, std::size_t pending) {
+  return inflight < kInflightCapacity && pending == kPendingQueueCapacity;
+}
+
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/transport.cc b/openpilot/selfdrive/pandad/compatibility/transport.cc
new file mode 100644
index 0000000..0c47ea7
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/transport.cc
@@ -0,0 +1,200 @@
+#include "transport.h"
+
+#include <algorithm>
+
+namespace openpilot::pandad::compatibility {
+
+const char *status_name(Status status) {
+  switch (status) {
+    case Status::Ok: return "ok";
+    case Status::Short: return "short";
+    case Status::Timeout: return "timeout";
+    case Status::Cancelled: return "cancelled";
+    case Status::Disconnected: return "disconnected";
+    case Status::Stall: return "stall";
+    case Status::Busy: return "busy";
+    case Status::Invalid: return "invalid";
+    case Status::IoError: return "io_error";
+    case Status::Poisoned: return "poisoned";
+  }
+  return "unknown";
+}
+
+bool is_read(Kind kind) {
+  return kind == Kind::ControlRead || kind == Kind::BulkRead;
+}
+
+bool valid_request(const Request &request) {
+  const bool control = request.kind == Kind::ControlRead || request.kind == Kind::ControlWrite;
+  const bool bulk = request.kind == Kind::BulkRead || request.kind == Kind::BulkWrite;
+  if (!control && !bulk) return false;
+  if (request.endpoint > 0xffU || request.request > 0xffU ||
+      request.value > 0xffffU || request.index > 0xffffU) return false;
+  if (control) {
+    if (request.endpoint != 0) return false;
+  } else {
+    const auto endpoint_number = request.endpoint & 0x7fU;
+    if (endpoint_number == 0 || endpoint_number > 15 ||
+        ((request.endpoint & 0x80U) != 0) != is_read(request.kind) ||
+        request.request != 0 || request.value != 0 || request.index != 0) return false;
+  }
+  const auto maximum = control ? kMaxControlBytes : kMaxBulkBytes;
+  if (is_read(request.kind)) {
+    return request.payload.empty() && request.read_length > 0 && request.read_length <= maximum;
+  }
+  return request.read_length == 0 && request.payload.size() <= maximum &&
+         (control || !request.payload.empty());
+}
+
+namespace {
+
+bool known_status(Status status) {
+  switch (status) {
+    case Status::Ok: case Status::Short: case Status::Timeout:
+    case Status::Cancelled: case Status::Disconnected: case Status::Stall:
+    case Status::Busy: case Status::Invalid: case Status::IoError: case Status::Poisoned:
+      return true;
+  }
+  return false;
+}
+
+// A backend cannot turn a malformed byte count into a successful transfer.
+bool valid_result(const Result &result, const Request &request) {
+  const auto expected = is_read(request.kind) ? request.read_length : request.payload.size();
+  if (!known_status(result.status)) return false;
+  if (is_read(request.kind) && result.delivery_uncertain) return false;
+  if (result.actual > expected) return false;
+  if (is_read(request.kind)) {
+    if (result.data.size() != result.actual) return false;
+  } else if (!result.data.empty()) {
+    return false;
+  }
+  if (!result.actual_known) return result.status != Status::Ok && result.status != Status::Short;
+  return result.status != Status::Short || result.actual < expected;
+}
+
+}  // namespace
+
+Result Transport::perform(const Request &request, std::uint32_t timeout_ms) {
+  if (!valid_request(request) || timeout_ms == 0 || timeout_ms > kMaxTransportTimeoutMs) {
+    return {Status::Invalid};
+  }
+  if (cancelled_.load()) return {Status::Cancelled};
+  if (poisoned_.load()) return {Status::Poisoned};
+  const auto started = clock_.now_us();
+  auto previous_time = started;
+  const std::uint64_t budget_us = static_cast<std::uint64_t>(timeout_ms) * 1000U;
+  const std::uint64_t lock_budget_us = std::min(budget_us, static_cast<std::uint64_t>(kLockWaitMs) * 1000U);
+  // Subtraction only follows monotonicity checks; wrap/backward clocks never
+  // turn expired work into a fresh deadline. We never add to the clock value.
+  const auto elapsed = [&](std::uint64_t &value) {
+    const auto now = clock_.now_us();
+    if (now < previous_time) return false;
+    previous_time = now;
+    value = now - started;
+    return true;
+  };
+  const auto clock_failure = [&]() {
+    poisoned_.store(true);
+    return Result{Status::IoError};
+  };
+
+  std::unique_lock<std::mutex> lock(mutex_, std::defer_lock);
+  // Even a broken clock/adapter cannot cause an unbounded number of attempts.
+  // A non-advancing clock is detected after the first paced wait below.
+  while (true) {
+    if (cancelled_.load()) return {Status::Cancelled};
+    if (poisoned_.load()) return {Status::Poisoned};
+    std::uint64_t spent = 0;
+    if (!elapsed(spent)) return clock_failure();
+    if (spent >= lock_budget_us) return {Status::Busy};
+    if (lock.try_lock()) break;
+    const auto before_wait = previous_time;
+    clock_.wait_us(static_cast<std::uint32_t>(std::min<std::uint64_t>(kWaitQuantumUs, lock_budget_us - spent)));
+    if (!elapsed(spent) || (previous_time == before_wait && !cancelled_.load())) return clock_failure();
+  }
+
+  Result previous_result;
+  const auto finish = [&](Status status) {
+    auto result = previous_result;
+    result.status = status;
+    return result;
+  };
+  while (true) {
+    if (cancelled_.load()) return finish(Status::Cancelled);
+    if (poisoned_.load()) return finish(Status::Poisoned);
+    std::uint64_t spent = 0;
+    if (!elapsed(spent)) {
+      poisoned_.store(true);
+      return finish(Status::IoError);
+    }
+    // libusb and adapter budgets have millisecond resolution. Do not round up
+    // a sub-millisecond remainder and thereby schedule beyond the deadline.
+    if (spent >= budget_us || budget_us - spent < 1000U) return finish(Status::Timeout);
+    const auto slice = static_cast<std::uint32_t>(std::min<std::uint64_t>(kBackendSliceMs, (budget_us - spent) / 1000U));
+    Result result;
+    try {
+      result = backend_.transact(request, slice);
+    } catch (...) {
+      result = {Status::IoError, 0, {}, false, !is_read(request.kind)};
+    }
+    result.backend_status = result.status;
+    result.backend_attempted = true;
+    if (!valid_result(result, request)) {
+      // Contradictory adapter output cannot be used as a trustworthy count.
+      result.status = Status::IoError;
+      result.actual = 0;
+      result.data.clear();
+      result.actual_known = false;
+      result.delivery_uncertain = !is_read(request.kind);
+      poisoned_.store(true);
+    } else if (result.status == Status::Ok && result.actual < (is_read(request.kind) ? request.read_length : request.payload.size())) {
+      result.status = Status::Short;
+    }
+
+    // Latch terminal adapter failures before a later deadline/cancel changes
+    // the outward status. A timeout label must not revive a disconnected board
+    // or replay a request whose consumed stream extent is unknown.
+    if (result.status == Status::Cancelled) cancelled_.store(true);
+    if (result.status == Status::Disconnected || result.status == Status::Stall ||
+        result.status == Status::IoError || result.status == Status::Poisoned ||
+        (is_read(request.kind) && !result.actual_known)) poisoned_.store(true);
+
+    std::uint64_t completed = 0;
+    const bool clock_ok = elapsed(completed);
+    if (!clock_ok) {
+      result.status = Status::IoError;
+      poisoned_.store(true);
+    } else if (cancelled_.load()) {
+      result.status = Status::Cancelled;
+    } else if (completed >= budget_us || completed - spent >= static_cast<std::uint64_t>(slice) * 1000U) {
+      result.status = Status::Timeout;
+    }
+    if (result.status == Status::Cancelled) cancelled_.store(true);
+    if (!is_read(request.kind)) {
+      if (result.status == Status::Ok && result.delivery_uncertain) result.status = Status::IoError;
+      if (result.status != Status::Ok || result.delivery_uncertain) {
+        result.delivery_uncertain = true;
+        poisoned_.store(true);
+      }
+      return result;
+    }
+    if (result.status == Status::Disconnected || result.status == Status::Stall ||
+        result.status == Status::IoError || result.status == Status::Poisoned) poisoned_.store(true);
+    if (result.status != Status::Timeout || result.backend_status != Status::Timeout ||
+        !result.actual_known || result.actual != 0 ||
+        !clock_ok || completed >= budget_us || cancelled_.load() || poisoned_.load()) return result;
+    // A backend can return an immediate timeout. Pace retries so even a virtual
+    // clock makes forward progress and the loop cannot spin indefinitely.
+    const auto remaining = budget_us - completed;
+    previous_result = result;
+    const auto before_wait = previous_time;
+    clock_.wait_us(static_cast<std::uint32_t>(std::min<std::uint64_t>(kWaitQuantumUs, remaining)));
+    if (!elapsed(completed) || (previous_time == before_wait && !cancelled_.load())) {
+      poisoned_.store(true);
+      return finish(Status::IoError);
+    }
+  }
+}
+
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/transport.h b/openpilot/selfdrive/pandad/compatibility/transport.h
new file mode 100644
index 0000000..8edd87c
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/transport.h
@@ -0,0 +1,103 @@
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+namespace openpilot::pandad::compatibility {
+
+enum class Kind { ControlRead, ControlWrite, BulkRead, BulkWrite };
+enum class Status {
+  Ok, Short, Timeout, Cancelled, Disconnected, Stall, Busy, Invalid, IoError, Poisoned,
+};
+const char *status_name(Status status);
+
+// Ingress fields stay wide until validation. Bulk endpoints include the USB
+// direction bit (e.g. RX 0x81, TX 0x03); control endpoint is always zero.
+struct Request {
+  Kind kind = Kind::ControlRead;
+  std::uint32_t endpoint = 0;
+  std::uint32_t request = 0;
+  std::uint32_t value = 0;
+  std::uint32_t index = 0;
+  std::size_t read_length = 0;
+  std::vector<std::uint8_t> payload{};
+};
+
+struct Result {
+  Status status = Status::Invalid;
+  // Confirmed application bytes. If actual_known is false this is only a lower
+  // bound: a later staged chunk may also have transferred an unknown amount.
+  std::size_t actual = 0;
+  std::vector<std::uint8_t> data{};
+  bool actual_known = true;
+  // A failed write may have changed the device even when its actual byte count
+  // is zero/unknown. Callers must never interpret an error as proof of no TX.
+  bool delivery_uncertain = false;
+  // Filled by Transport, preserving the adapter status when a later deadline
+  // or cancellation changes status. Direct backend callers leave these unset.
+  Status backend_status = Status::Invalid;
+  bool backend_attempted = false;
+};
+
+inline constexpr std::size_t kMaxControlBytes = 4096;
+inline constexpr std::size_t kMaxBulkBytes = 16384;
+inline constexpr std::uint32_t kMaxTransportTimeoutMs = 100;
+inline constexpr std::uint32_t kBackendSliceMs = 5;
+inline constexpr std::uint32_t kLockWaitMs = 10;
+inline constexpr std::uint32_t kWaitQuantumUs = 1000;
+
+bool is_read(Kind kind);
+bool valid_request(const Request &request);
+
+class Backend {
+public:
+  virtual ~Backend() = default;
+  // Exactly one bounded transfer attempt. No internal replay/reset/recovery.
+  // The owner guarantees exclusive use of this backend/handle. An adapter must
+  // honor timeout_ms (1..5), retain partial counts, and never perform I/O in its
+  // constructor. Transport cannot preempt an adapter that breaks this contract.
+  virtual Result transact(const Request &request, std::uint32_t timeout_ms) = 0;
+  // Permanent cooperative cancellation; must only set local atomic state.
+  // No device calls, blocking work or handle destruction are allowed here.
+  virtual void cancel() noexcept {}
+};
+
+class Clock {
+public:
+  virtual ~Clock() = default;
+  virtual std::uint64_t now_us() = 0;
+  virtual void wait_us(std::uint32_t duration_us) = 0;
+};
+
+// One session/handle, one in-flight call. Objects and their backend/clock must
+// outlive all callers; neither a backend nor mutable parser may be shared with
+// another Transport. This class does not enumerate/open/close physical devices.
+class Transport {
+public:
+  Transport(Backend &backend, Clock &clock) : backend_(backend), clock_(clock) {}
+  Transport(const Transport &) = delete;
+  Transport &operator=(const Transport &) = delete;
+
+  // Total candidate budget: 1..100ms, each backend attempt <=5ms, lock wait
+  // <=10ms. Reads retry ONLY a known zero-byte timeout; a partial read returns
+  // immediately. Writes always have exactly one attempt and are never replayed.
+  // Unknown read consumption poisons the session: confirmed prefix bytes remain
+  // available for diagnosis, but the stream cannot safely resume after a gap.
+  Result perform(const Request &request, std::uint32_t timeout_ms = 100);
+  // Permanent, session-local cancellation. A new instance is required to resume.
+  // An already running bounded backend call is allowed to finish before return.
+  void cancel() noexcept { cancelled_.store(true); backend_.cancel(); }
+  bool healthy() const { return !cancelled_.load() && !poisoned_.load(); }
+
+private:
+  Backend &backend_;
+  Clock &clock_;
+  std::mutex mutex_;
+  std::atomic<bool> cancelled_{false};
+  std::atomic<bool> poisoned_{false};
+};
+
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/usb_backend.cc b/openpilot/selfdrive/pandad/compatibility/usb_backend.cc
new file mode 100644
index 0000000..2349d2f
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/usb_backend.cc
@@ -0,0 +1,143 @@
+#include "usb_backend.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+namespace openpilot::pandad::compatibility {
+namespace {
+Status map_error(int error) {
+  switch (error) {
+    case kUsbTimeout: return Status::Timeout;
+    case kUsbNoDevice: return Status::Disconnected;
+    case kUsbPipe: return Status::Stall;
+    case kUsbBusy: return Status::Busy;
+    case kUsbInterrupted: return Status::Cancelled;
+    case kUsbInvalid: return Status::Invalid;
+    default: return Status::IoError;
+  }
+}
+bool valid_binding(const UsbBinding &binding) {
+  return binding.bulk_alt0_verified && !binding.serial.empty() && binding.serial.size() <= 128 &&
+    std::all_of(binding.serial.begin(), binding.serial.end(), [](unsigned char c) { return c > 32 && c < 127; }) &&
+    (binding.board_type == 6 || binding.board_type == 7);
+}
+bool normal_panda(const UsbDeviceInfo &device) {
+  return (device.vendor == 0xbbaa || device.vendor == 0x3801) && device.product == 0xddcc;
+}
+bool valid_descriptor(const UsbDeviceInfo &device, const UsbBinding &binding) {
+  if (!device.active_configuration_known || device.serial_index == 0 ||
+      device.bcd_device != (binding.board_type << 8)) return false;
+  int matches = 0;
+  for (const auto &alt : device.alternates) {
+    if (alt.interface_number != 0 || alt.alternate_setting != 0) continue;
+    ++matches;
+    std::set<unsigned int> seen;
+    bool rx = false, tx = false;
+    for (const auto &ep : alt.endpoints) {
+      if (!seen.insert(ep.address).second) return false;
+      if (ep.address == 0x81 || ep.address == 0x03) {
+        if ((ep.attributes & 3) != 2 || ep.max_packet_size != 64) return false;
+        if (ep.address == 0x81) rx = true;
+        else tx = true;
+      }
+    }
+    if (!rx || !tx) return false;
+  }
+  return matches == 1;
+}
+}  // namespace
+
+UsbBackend::UsbBackend(std::unique_ptr<LibusbApi> api) : api_(std::move(api)) {}
+UsbBackend::~UsbBackend() { close(); }
+void UsbBackend::cleanup_locked() {
+  if (handle_) {
+    if (claimed_) api_->release(handle_, 0);
+    api_->close(handle_);
+  }
+  handle_ = 0;
+  claimed_ = false;
+  if (initialized_) api_->shutdown();
+  initialized_ = false;
+}
+void UsbBackend::close() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  cleanup_locked();
+}
+bool UsbBackend::is_open() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return handle_ != 0 && claimed_;
+}
+Status UsbBackend::open_bound(const UsbBinding &binding, bool allow_device_io) {
+  std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+  if (!lock.owns_lock()) return Status::Busy;
+  if (!allow_device_io || !api_ || !valid_binding(binding)) return Status::Invalid;
+  if (initialized_ || handle_) return Status::Busy;
+  int result = api_->initialize();
+  if (result != 0) return map_error(result);
+  initialized_ = true;
+  auto fail = [&](Status status) { cleanup_locked(); return status; };
+  std::vector<UsbDeviceInfo> devices;
+  result = api_->enumerate(devices);
+  if (result != 0) return fail(map_error(result));
+  for (const auto &device : devices) {
+    if (!normal_panda(device)) continue;
+    UsbHandle candidate = 0;
+    result = api_->open(device.id, candidate);
+    if (result != 0 || candidate == 0) {
+      if (candidate) api_->close(candidate);
+      return fail(result == 0 ? Status::IoError : map_error(result));
+    }
+    std::string serial;
+    result = api_->serial(candidate, device.serial_index, serial, kBackendSliceMs);
+    if (result != 0) {
+      api_->close(candidate);
+      return fail(map_error(result));  // cannot exclude an inaccessible duplicate
+    }
+    if (serial != binding.serial) { api_->close(candidate); continue; }
+    if (handle_ || !valid_descriptor(device, binding)) {
+      api_->close(candidate);
+      return fail(Status::Poisoned);  // duplicate or replacement identity
+    }
+    handle_ = candidate;
+  }
+  if (!handle_) return fail(Status::Disconnected);
+  result = api_->claim(handle_, 0);
+  if (result != 0) return fail(map_error(result));
+  claimed_ = true;
+  return Status::Ok;
+}
+Result UsbBackend::transact(const Request &request, std::uint32_t timeout_ms) {
+  std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+  if (!lock.owns_lock()) return {Status::Busy, 0, {}};
+  if (!valid_request(request) || timeout_ms == 0 || timeout_ms > kBackendSliceMs) return {Status::Invalid, 0, {}};
+  if ((request.kind == Kind::BulkRead && request.endpoint != 0x81) ||
+      (request.kind == Kind::BulkWrite && request.endpoint != 0x03)) return {Status::Invalid, 0, {}};
+  if (!handle_ || !claimed_) return {Status::Disconnected, 0, {}};
+  const bool read = is_read(request.kind);
+  const std::size_t length = read ? request.read_length : request.payload.size();
+  std::vector<std::uint8_t> bytes = read ? std::vector<std::uint8_t>(length) : request.payload;
+  int actual = 0;
+  int result = 0;
+  if (request.kind == Kind::ControlRead || request.kind == Kind::ControlWrite) {
+    result = api_->control(handle_, read ? 0xc0 : 0x40, static_cast<std::uint8_t>(request.request),
+      static_cast<std::uint16_t>(request.value), static_cast<std::uint16_t>(request.index),
+      bytes.data(), static_cast<std::uint16_t>(length), timeout_ms);
+    if (result < 0) return {map_error(result), 0, {}, false, !read};
+    actual = result;
+    result = kUsbSuccess;
+  } else {
+    result = api_->bulk(handle_, static_cast<std::uint8_t>(request.endpoint), bytes.data(),
+                        static_cast<int>(length), actual, timeout_ms);
+  }
+  // libusb OVERFLOW does not guarantee actual_length or buffer contents,
+  // including when the reported count happens to be within the requested size.
+  if (result == kUsbOverflow) return {Status::Poisoned, 0, {}, false, !read};
+  if (actual < 0 || static_cast<std::size_t>(actual) > length) return {Status::Poisoned, 0, {}, false, !read};
+  const auto size = static_cast<std::size_t>(actual);
+  Status status = result == 0 ? (size == length ? Status::Ok : Status::Short) : map_error(result);
+  if (read) bytes.resize(size);
+  else bytes.clear();
+  return {status, size, std::move(bytes), true, !read && status != Status::Ok};
+}
+}  // namespace openpilot::pandad::compatibility
diff --git a/openpilot/selfdrive/pandad/compatibility/usb_backend.h b/openpilot/selfdrive/pandad/compatibility/usb_backend.h
new file mode 100644
index 0000000..8544e2c
--- /dev/null
+++ b/openpilot/selfdrive/pandad/compatibility/usb_backend.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <memory>
+#include <mutex>
+#include <string>
+
+#include "libusb_api.h"
+#include "transport.h"
+
+namespace openpilot::pandad::compatibility {
+
+struct UsbBinding {
+  std::string serial;
+  // Descriptor bcdDevice high byte: DOS=6, RED_PANDA=7. This software identity
+  // is not proof of the physical MCU, firmware ABI, or permission to send CAN.
+  std::uint16_t board_type = 0;
+  // Separate caller-supplied activation evidence/assumption, not a fact inferred
+  // from alt0 descriptors. The locked firmware lacks GET_INTERFACE. No fallback
+  // SET_INTERFACE is allowed: an unverified real session must remain unopened.
+  bool bulk_alt0_verified = false;
+};
+
+class UsbBackend final : public Backend {
+public:
+  explicit UsbBackend(std::unique_ptr<LibusbApi> api = make_native_libusb_api());
+  ~UsbBackend() override;
+  UsbBackend(const UsbBackend &) = delete;
+  UsbBackend &operator=(const UsbBackend &) = delete;
+
+  // Deliberate future activation boundary, not used by offline acceptance.
+  // Empty/unbound identities and the default false permission do no USB I/O.
+  // Opening enumerates/read-descriptors/claims only, never resets or configures.
+  // OS open/claim latency is outside the bounded transfer contract. The caller
+  // must serialize lifecycle operations and keep this object alive during use.
+  Status open_bound(const UsbBinding &binding, bool allow_device_io = false);
+  void close();
+  bool is_open() const;
+  Result transact(const Request &request, std::uint32_t timeout_ms) override;
+
+private:
+  void cleanup_locked();
+  std::unique_ptr<LibusbApi> api_;
+  mutable std::mutex mutex_;
+  UsbHandle handle_ = 0;
+  bool initialized_ = false;
+  bool claimed_ = false;
+};
+
+}  // namespace openpilot::pandad::compatibility
