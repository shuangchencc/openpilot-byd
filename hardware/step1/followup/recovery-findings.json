  "observations": [
    {
      "id": "fixed_mounts_archived",
      "classification": "observation",
      "sources": [
        "archived_fstab",
        "followup_live_evidence"
      ],
      "facts": {
        "dsp": "/dev/disk/by-label/dsp /dsp auto ro",
        "firmware": "/dev/disk/by-partlabel/modem_a /firmware auto ro"
      },
      "limit": "New live fstab SHA256 and size match the archive; selected rows match exactly."
    },
    {
      "id": "ab_mount_archived",
      "classification": "observation",
      "sources": [
        "archived_ab_mount",
        "followup_live_evidence"
      ],
      "facts": "ab_mount.sh calls getslotsuffix, appends suffix to its third argument, waits for the symlink then invokes mount. This helper is slot-aware; its existence does not prove that it handles /dsp or /firmware.",
      "limit": "The new live helper hash matches the saved file. Its use for /dsp or /firmware is still not established; no script was run."
    },
    {
      "id": "selected_boot_metadata_binary",
      "classification": "static_binary_observation",
      "sources": [
        "archived_libabctl",
        "archived_sde_entries",
        "followup_live_evidence"
      ],
      "facts": "Named status functions read boot_a/boot_b entries on /dev/sde; entry attribute address is 48 bytes after the returned GPT entry. Active is bit 50; success bit 54. The named setUnbootable writer sets bit 55; SetBootSuccess clears bit 55 and sets bit 54.",
      "limit": "New live libabctl SHA256/size match exactly, binding the three-bit interpretation to this installed library. This is not a full boot selection algorithm and no status function was executed."
    },
    {
      "id": "mounts_explained_live",
      "classification": "observation_and_configuration_consistency",
      "sources": [
        "archived_fstab",
        "followup_live_evidence"
      ],
      "facts": "Current fstab matches archive. by-label/dsp resolves to sde9=dsp_a; modem_a resolves to sde4. Both match mounted devices while current root is sda7=system_b. Fixed/label-based mount selection explains the suffix difference.",
      "limit": "This establishes configuration consistency, not AGNOS 19.9 compatibility or a restore test."
    }
  ],
  "inferences": [
    {
      "id": "mount_suffixes_not_fault_proof",
      "classification": "inference",
      "sources": [
        "archived_fstab",
        "original_live_recovery",
        "followup_live_evidence"
      ],
      "claim": "Current fstab and link resolution explain the observed root system_b with dsp_a/modem_a mounts. /firmware is explicitly fixed to modem_a and /dsp resolves the label dsp to dsp_a. Different suffixes are not by themselves a fault or reason to repair GPT."
    },
    {
      "id": "misc_not_required",
      "classification": "inference_from_static_binary",
      "sources": [
        "archived_libabctl"
      ],
      "claim": "The audited libabctl implementation uses GPT entries for selected slot flags and /proc/cmdline for the booted suffix. No evidence justifies reading an assumed AOSP bootloader_control structure at misc+2048 in this pass.",
      "recommended_misc_read": false
    }
  ],
