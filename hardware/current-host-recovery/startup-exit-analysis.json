  "findings": [
    {
      "id": "unit_entry",
      "evidence": [
        "/usr/lib/systemd/system/comma.service:5-11",
        "systemctl show ExecStart/ExecStop"
      ],
      "conclusion": "Current disk Type=oneshot and RemainAfterExit=true; loaded ExecStart creates tmux comma session and ExecStop kills that session. Loaded Restart=no, KillMode=control-group, KillSignal=15, FinalKillSignal=9, SendSIGKILL=yes, TimeoutStopUSec=1s. No stop executed. Independent show --all supplement confirms loaded Type=oneshot and User=comma."
    },
    {
      "id": "legacy_unit_not_current",
      "evidence": [
        "/usr/lib/systemd/system/comma.service"
      ],
      "conclusion": "Current 367-byte unit differs from historical 244-byte Restart=always root snapshot; historical policy must not be used for this device state."
    },
    {
      "id": "reset_gate",
      "evidence": [
        "/usr/comma/comma.sh:48-66"
      ],
      "conclusion": "Factory reset checks are guarded by /tmp/booted not being a regular file. The later fixed-path lstat returned FileNotFoundError at 2026-10-19T17:32:55Z; its content was not read or created. Future reset-marker/touch-count/userdata conditions and reset tool behavior remain unverified."
    },
    {
      "id": "restart_writes",
      "evidence": [
        "/usr/comma/comma.sh:25-45",
        "/usr/comma/comma.sh:68-101",
        "/data/openpilot/launch_chffrplus.sh:7-27",
        "/data/openpilot/launch_chffrplus.sh:173-236",
        "/data/openpilot/sunnypilot/system/hardware/c3/launch_chffrplus.sh:3-40",
        "/data/openpilot/sunnypilot/system/hardware/c3/launch_chffrplus.sh:184-247"
      ],
      "conclusion": "Startup can mutate data/setup state, slot success metadata, device permissions, software overlay, local dependency installation and logs, and can conditionally invoke reboot/updater. Restart is not a no-side-effect rollback."
    },
    {
      "id": "launcher_return",
      "evidence": [
        "/data/openpilot/launch_chffrplus.sh:225-233",
        "/data/openpilot/sunnypilot/system/hardware/c3/launch_chffrplus.sh:236-244"
      ],
      "conclusion": "When manager returns normally, current launchers enter a sleep loop, not an internal manager restart loop."
    },
    {
      "id": "process_stop",
      "evidence": [
        "/data/openpilot/system/manager/process.py:111-156"
      ],
      "conclusion": "ManagerProcess.stop defaults to SIGINT unless sigkill flag, waits 5s when blocking and may SIGKILL retry; signals a registered PID. This is not the tmux/systemd stop path and does not prove descendant or board cleanup."
    },
    {
      "id": "watchdog_and_daemons",
      "evidence": [
        "/data/openpilot/system/manager/process.py:87-107",
        "/data/openpilot/system/manager/process.py:233-276",
        "/data/openpilot/system/manager/process.py:279-296"
      ],
      "conclusion": "Watchdog restart invokes SIGKILL then start; DaemonProcess.stop is empty and creation uses a new process group. Process-group separation does not imply service-cgroup escape."
    },
    {
      "id": "configured_panda",
      "evidence": [
        "/data/openpilot/system/manager/process_config.py:63-64",
        "/data/openpilot/system/manager/process_config.py:141",
        "/data/openpilot/system/manager/process_config.py:151"
      ],
      "conclusion": "Current plain configuration enables PythonProcess pandad at selfdrive.pandad.pandad with always_run, while _pandad NativeProcess is disabled. This does not reveal opaque wrapper internals."
    },
    {
      "id": "opaque_exit",
      "evidence": [
        "/data/openpilot/system/manager/manager.py",
        "/data/openpilot/selfdrive/pandad/pandad.py"
      ],
      "conclusion": "Both current sources are PyArmor envelopes. Signal handlers, manager cleanup order, shutdown/reboot/uninstall decisions, wrapper final Panda operations and board final state remain unknown; no decryption/import/execution performed."
    },
    {
      "id": "hardware_exit_methods",
